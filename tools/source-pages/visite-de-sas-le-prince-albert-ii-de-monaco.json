      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"COMMUNIQUÉ PRINCE ALBERT\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE (Obligatoire pour que Hostinger affiche le style) -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n\n    /* --- INTÉGRATION FACEBOOK PREMIUM --- */\n    .social-embed-container {\n        background: #ffffff;\n        padding: 10px;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n        box-shadow: 0 20px 40px -10px rgba(113, 53, 6, 0.10);\n        transition: transform 0.4s ease, box-shadow 0.4s ease;\n        border-radius: 4px;\n        width: 100%;\n        max-width: 520px; /* Pour encadrer proprement l'iframe FB de 500px */\n        margin: 0 auto;\n    }\n    .social-embed-container:hover {\n        transform: translateY(-5px);\n        box-shadow: 0 25px 50px -12px rgba(113, 53, 6, 0.18);\n    }\n    \n    /* Conteneur responsive pour l'iframe */\n    .fb-iframe-wrapper {\n        position: relative;\n        width: 100%;\n        /* Ratio approximatif du post FB */\n        padding-bottom: 105%; \n        overflow: hidden;\n    }\n    .fb-iframe-wrapper iframe {\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-communique-prince-block\" class=\"font-serif antialiased w-full bg-village-bg\">\n\n    <!-- SECTION HERO DE L'ARTICLE (Hauteurs fixes) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <!-- Image d'ambiance en fond (Photo avec le Prince) -->\n        <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1024,h=683,fit=crop/gnKoPAn3rxzY53IR/640136904_18127511677554133_5954049839880848320_n-tcU4AMFCNN7oxGpO.jpg\" alt=\"Le Prince Albert II de Monaco au Village\" class=\"absolute inset-0 w-full h-full object-cover object-top\">\n        \n        <!-- Voile assombrissant pour lire le texte -->\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Communiqué de Presse</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight\">\n                Visite exceptionnelle de <br>S.A.S le Prince Albert <span class=\"font-serif text-[0.85em] tracking-tighter ml-1\">II</span>\n            </h1>\n        </div>\n    </section>\n\n    <!-- CORPS DU COMMUNIQUÉ -->\n    <main class=\"w-full pb-24 -mt-10 md:-mt-16 relative z-20\">\n        <div class=\"max-w-6xl mx-auto px-6\">\n            \n            <div class=\"bg-village-white shadow-xl p-8 md:p-16 lg:p-20 flex flex-col lg:flex-row gap-12 lg:gap-20 items-start\">\n                \n                <!-- Colonne Texte (Storytelling) -->\n                <div class=\"w-full lg:w-3/5\">\n                    <p class=\"font-sans text-sm text-village-accent uppercase tracking-widest mb-8 border-b border-village-accent/20 pb-4\">Cagnes-sur-Mer — Un déjeuner princier</p>\n                    \n                    <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                        Nous avons eu l’immense honneur d’accueillir pour le déjeuner Son Altesse Sérénissime le Prince Albert <span class=\"font-serif tracking-tighter\">II</span> de Monaco, aux côtés de Monsieur le Maire Louis Nègre et de Monsieur Constant Roland, Premier Adjoint.\n                    </p>\n                    \n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Un moment d’exception placé sous le signe de l’élégance… et surtout de la simplicité, une valeur qui nous est chère. Ce souvenir prestigieux résonne avec l’âme du Haut-de-Cagnes : un village où le patrimoine, l’art et l’histoire se croisent naturellement.\n                    </p>\n\n                    <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-10 mb-4\">Une évidence historique</h4>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Accueillir le Souverain monégasque sur la place du Château résonne comme une évidence. L'histoire du Haut-de-Cagnes est intimement liée à celle de Monaco. Dès le début du XIVe siècle, la seigneurie de Cagnes fut acquise par Rainier Ier Grimaldi, amiral de France. C'est cette même illustre famille qui fit bâtir l'imposant Château Grimaldi, qui surplombe aujourd'hui encore notre restaurant.\n                    </p>\n\n                    <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-10 mb-4\">Sauvegarde du patrimoine cagnois</h4>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                        La présence de la famille princière dans nos ruelles n'était pas un hasard. Le Prince Albert <span class=\"font-serif tracking-tighter\">II</span> a effectué une visite privée pour admirer la restauration de la Chapelle Notre-Dame de Protection. Classé Monument Historique depuis 1939, ce joyau des XVe et XVIIe siècles a fait l'objet de travaux d'envergure. Très attaché à la préservation de l'histoire régionale, Son Altesse Sérénissime a d'ailleurs participé financièrement à la réhabilitation de cet édifice.\n                    </p>\n\n                    <!-- Bouton Dossier de Presse & Contact -->\n                    <div class=\"mt-8 flex flex-col sm:flex-row gap-4\">\n                        <a href=\"https://legrimaldibylevillage.com/dossier-presse\" target=\"_blank\" class=\"inline-block bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-4 px-8 font-sans tracking-widest uppercase text-xs md:text-sm text-center\">\n                            Dossier de Presse\n                        </a>\n                        <a href=\"mailto:contact@legrimaldibylevillage.fr\" class=\"inline-block border border-village-dark text-village-dark hover:bg-village-dark hover:text-village-light transition-colors duration-300 py-4 px-8 font-sans tracking-widest uppercase text-xs md:text-sm text-center\">\n                            Contact\n                        </a>\n                    </div>\n                </div>\n\n                <!-- Colonne Intégration Sociale (Facebook) -->\n                <div class=\"w-full lg:w-2/5 flex justify-center sticky top-32\">\n                    <div class=\"social-embed-container\">\n                        <div class=\"fb-iframe-wrapper\">\n                            <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Frestaurantlevillagehdc%2Fposts%2Fpfbid0QwvVv5yCidgYzyQ7yDAMFY88mbhVb9DsEa5ao5gGvj8b8CQcZBfptc2BvwMuwj85l&show_text=true&width=500\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                            </iframe>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- GALERIE MÉDIA (2 Belles Images) -->\n        <section class=\"max-w-6xl mx-auto px-6 mt-24 md:mt-32\">\n            <h3 class=\"font-cursive text-5xl md:text-6xl text-village-accent text-center mb-12\">Galerie Média</h3>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10\">\n                \n                <!-- Image 1 : Le Prince -->\n                <div class=\"overflow-hidden rounded-sm group relative shadow-md h-[400px] md:h-[500px]\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1024,h=683,fit=crop/gnKoPAn3rxzY53IR/640136904_18127511677554133_5954049839880848320_n-tcU4AMFCNN7oxGpO.jpg\" alt=\"S.A.S le Prince Albert II de Monaco au restaurant Le Village\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n                <!-- Image 2 : La Chapelle -->\n                <div class=\"overflow-hidden rounded-sm group relative shadow-md h-[400px] md:h-[500px]\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=512,fit=crop/gnKoPAn3rxzY53IR/eglise_notre_dame_protection-oex8yYOJbgYhxNiI.webp\" alt=\"La Chapelle Notre-Dame de Protection fraîchement restaurée\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n            </div>\n        </section>\n\n    </main>\n\n</div>\n\n<!-- ===================================================================== -->\n<!-- FIN DE LA SECTION \"COMMUNIQUÉ PRINCE ALBERT\" -->\n<!-- ===================================================================== -->"
