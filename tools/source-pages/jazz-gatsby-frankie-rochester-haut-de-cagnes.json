 ease, color .28s ease;\n    }\n    .program-link-btn:hover {\n        transform: translateY(-3px);\n        background: #f5f0ea;\n        color: #713506;\n    }\n\n    /* --- VIDÉO YOUTUBE INTÉGRÉE AU DESIGN ÉDITORIAL --- */\n    .youtube-showcase {\n        position: relative;\n        background: #ffffff;\n        padding: 10px;\n        border-radius: 46px 46px 0 0;\n        border: 1px solid rgba(113, 53, 6, 0.20);\n        box-shadow: 0 25px 50px -14px rgba(0, 0, 0, 0.25);\n        overflow: hidden;\n        transition: transform .5s ease, box-shadow .5s ease;\n    }\n    .youtube-showcase:hover {\n        transform: translateY(-6px);\n        box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.35);\n    }\n    .youtube-showcase::before {\n        content: '';\n        position: absolute;\n        inset: 8px;\n        border: 1px solid rgba(157, 98, 61, 0.55);\n        border-radius: 38px 38px 0 0;\n        pointer-events: none;\n        z-index: 2;\n    }\n    .youtube-ratio {\n        position: relative;\n        width: 100%;\n        aspect-ratio: 16 / 9;\n        overflow: hidden;\n        border-radius: 34px 34px 0 0;\n        background: #1d0c02;\n    }\n    .youtube-ratio iframe {\n        width: 100%;\n        height: 100%;\n        border: 0;\n        display: block;\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-gatsby-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <!-- Image d'ambiance cocktail / fête chic -->\n        <img src=\"https://res.cloudinary.com/dp2ezgdnk/image/upload/v1783030424/727160041_984581197776283_603755074835302183_n_dnwmzq.jpg\" alt=\"Frankie Rochester Trio en concert lors d’une soirée Gatsby Jazz au Château à Cagnes-sur-Mer\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 30%;\" fetchpriority=\"high\" decoding=\"async\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/70 to-village-dark/80\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 drop-shadow-md\">Jazz au Château · Haut-de-Cagnes</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-2xl mb-6 leading-tight\">\n                Soirée Gatsby & <br>Jazz Pop Fusion\n                <span class=\"block font-sans normal-case tracking-normal text-lg md:text-2xl font-semibold mt-5\">à Cagnes-sur-Mer</span>\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">Vendredi 3 juillet 2026 · Frankie Rochester Trio</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central -->\n        <article class=\"max-w-4xl mx-auto px-6 bg-village-bg relative\" itemscope itemtype=\"https://schema.org/BlogPosting\">\n            <meta itemprop=\"headline\" content=\"Soirée Gatsby Jazz Pop Fusion à Cagnes-sur-Mer avec le Frankie Rochester Trio\">\n            <meta itemprop=\"description\" content=\"Concert Jazz Pop Fusion au Haut-de-Cagnes avec le Frankie Rochester Trio, le 3 juillet 2026.\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span><time datetime=\"2026-07-03\" itemprop=\"datePublished\">3 juillet 2026</time></span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Le vendredi 3 juillet 2026, le Haut-de-Cagnes fait un véritable saut dans le temps. Dans le cadre du festival <strong>Jazz au Château</strong>, la Place du Château à Cagnes-sur-Mer se métamorphose pour une soirée jazz placée sous le signe du style, du groove et de l’élégance.\n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Plus qu’un concert au Haut-de-Cagnes, c’est une invitation à vivre l’atmosphère festive des années folles depuis la terrasse du restaurant. La bande-son est assurée par le <strong class=\"font-serif italic text-xl\">Frankie Rochester Trio</strong>, pour un dîner avec vue et une parenthèse musicale au cœur du village médiéval.\n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\">Découvrir la carte</a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">Réserver sa table en terrasse</a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\">Réserver par téléphone</a>\n                </div>\n            </div>\n\n            <!-- PRÉSENTATION DE L'ARTISTE -->\n            <div class=\"relative bg-village-white p-8 md:p-12 shadow-sm border border-village-dark/5 my-16\">\n                <h2 class=\"font-cursive text-4xl md:text-6xl text-village-accent mb-6 text-center\">Frankie Rochester Trio : Jazz Pop Fusion à Cagnes-sur-Mer</h2>\n                \n                <div class=\"max-w-2xl mx-auto text-center\">\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Originaire de l’État de New York, <strong>Frankie Rochester</strong> (piano & chant) apporte avec elle les saveurs musicales de sa ville natale. Accompagnée de ses deux \"bodyguards\", Olivier Benty à la batterie et Thierry Conand à la basse, cette artiste auteure-compositrice propose un univers musical débridé.\n                    </p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans\">\n                        Finalistes du Tremplin Nice Jazz Festival, les trois complices excellent dans l'art de revisiter les classiques en y infusant une pointe de soul, des épices <em>seventies</em> et des arrangements originaux. Le résultat ? Une musique surprenante et accessible, définie comme du <strong>« Jazz Pop Fusion »</strong>, parfaite pour accompagner un dîner d'été.\n                    </p>\n                </div>\n            </div>\n\n            <!-- MAILLAGE INTERNE : PROGRAMME COMPLET JAZZ AU CHÂTEAU -->\n            <section class=\"jazz-program-card my-16 p-8 md:p-12 text-center\" aria-labelledby=\"programme-jazz-chateau\">\n                <div class=\"relative z-10 max-w-2xl mx-auto\">\n                    <p class=\"font-sans text-village-light/80 uppercase tracking-[0.22em] text-xs mb-4\">Tout l’été au Haut-de-Cagnes</p>\n                    <h2 id=\"programme-jazz-chateau\" class=\"font-cursive text-4xl md:text-6xl text-village-white leading-tight mb-5\">Jazz au Château, chaque vendredi soir</h2>\n                    <p class=\"font-sans text-village-light/90 text-base md:text-lg leading-relaxed mb-8\">\n                        Cette soirée avec le Frankie Rochester Trio fait partie du programme <strong>Jazz au Château à Cagnes-sur-Mer</strong>. Découvrez les prochains rendez-vous jazz du vendredi soir au Haut-de-Cagnes et choisissez votre prochaine soirée en terrasse.\n                    </p>\n                    <a href=\"https://legrimaldibylevillage.com/fete-de-la-musique-jazz-chateau-cagnes-sur-mer\" target=\"_top\" class=\"program-link-btn\" aria-label=\"Découvrir le programme complet de Jazz au Château à Cagnes-sur-Mer\">\n                        Découvrir le programme complet\n                        <span aria-hidden=\"true\">→</span>\n                    </a>\n                </div>\n            </section>\n\n            <!-- VIDÉO & AMBIANCE GATSBY -->\n            <div class=\"flex flex-col md:flex-row gap-10 md:gap-16 items-center my-20\">\n                \n                <!-- Cadre vidéo -->\n                <div class=\"w-full md:w-1/2 flex justify-center\">\n                    <div class=\"arched-video-frame w-full max-w-[280px] m-0\">\n                        <div class=\"video-mask\">\n                            <video id=\"jazzVideo\" src=\"https://res.cloudinary.com/dp2ezgdnk/video/upload/v1783030457/Soir%C3%A9e_jazz_x2lmho.mp4\" muted autoplay loop playsinline preload=\"metadata\" class=\"obs-video\" aria-label=\"Extrait vidéo de la soirée jazz Gatsby avec le Frankie Rochester Trio, sans son\"></video>\n                            \n                            <div class=\"video-controls absolute bottom-6 left-0 right-0 flex justify-center px-6 z-40\">\n                                <button onclick=\"toggleVideoPlay('jazzVideo', this)\" class=\"glass-btn p-3 rounded-full shadow-lg focus:outline-none\" aria-label=\"Lecture\">\n                                    <svg class=\"pause-icon w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M6.75 5.25a.75.75 0 01.75-.75H9a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H7.5a.75.75 0 01-.75-.75V5.25zm7.5 0A.75.75 0 0115 4.5h1.5a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H15a.75.75 0 01-.75-.75V5.25z\" clip-rule=\"evenodd\"></path></svg>\n                                    <svg class=\"play-icon w-5 h-5 hidden\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z\" clip-rule=\"evenodd\"></path></svg>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Texte d'ambiance -->\n                <div class=\"w-full md:w-1/2\">\n                    <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6\">Une soirée Gatsby <br>au Haut-de-Cagnes</h2>\n                    <div class=\"border-l-2 border-village-accent/30 pl-6\">\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-4\">\n                            Ce soir-là, nous célébrons l'opulence chic et l'insouciance. Imaginez-vous en terrasse : la douce brise estivale, les coupes de champagne, les lumières tamisées du Château, et ce petit mystère qui plane dans l'air…\n                        </p>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                            Pour jouer le jeu de cette fête à la \"Gatsby le Magnifique\", <strong>un dress code est suggéré</strong> par le festival : sortez vos boas, gants longs, petits gilets de costumes ou bretelles pour vous fondre dans cette atmosphère très 1920s !\n                        </p>\n                        <p class=\"font-serif italic text-village-accent text-xl\">\n                            \"Un voyage dans le temps avec notre terrasse pour première loge.\"\n                        </p>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- VIDÉO DU GROUPE : INTÉGRATION YOUTUBE ÉDITORIALE\n     Endpoint YouTube standard + referer origin explicite pour éviter l’erreur 153. -->\n            <section class=\"my-20\" aria-labelledby=\"video-frankie-rochester\">\n                <div class=\"max-w-3xl mx-auto text-center mb-8\">\n                    <p class=\"font-sans text-village-accent uppercase tracking-[0.22em] text-xs mb-4\">En musique</p>\n                    <h2 id=\"video-frankie-rochester\" class=\"font-cursive text-4xl md:text-6xl text-village-accent mb-4\">Découvrez Frankie Rochester Trio</h2>\n                    <p class=\"font-sans text-village-dark/80 text-base md:text-lg leading-relaxed\">\n                        Un aperçu de l’univers vibrant et généreux du trio, entre jazz, soul et pop fusion — avant de les retrouver en live sur la Place du Château.\n                    </p>\n                </div>\n                <div class=\"youtube-showcase max-w-3xl mx-auto\">\n                    <div class=\"youtube-ratio\">\n                        <iframe src=\"https://www.youtube.com/embed/ctTOcgwONx8?rel=0&modestbranding=1&playsinline=1&enablejsapi=1&origin=https%3A%2F%2Flegrimaldibylevillage.com\" title=\"Frankie Rochester Trio en vidéo\" loading=\"lazy\" referrerpolicy=\"origin\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen\" allowfullscreen>\n                        </iframe>\n                        <noscript>\n                            <a href=\"https://www.youtube.com/watch?v=ctTOcgwONx8\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"absolute inset-0 flex items-center justify-center bg-village-dark text-village-light font-sans text-sm uppercase tracking-widest\">Voir la vidéo sur YouTube</a>\n                        </noscript>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ENCART INFORMATIONS PRATIQUES & RÉSERVATION -->\n            <div class=\"info-card p-8 md:p-12 shadow-xl mb-16 mt-16 relative\">\n                <div class=\"text-center\">\n                    <h2 class=\"font-serif text-2xl text-village-dark mb-6\">Informations pratiques : concert jazz à Cagnes-sur-Mer</h2>\n                    <ul class=\"font-sans text-village-dark/80 space-y-4 mb-8 text-base md:text-lg\">\n                        <li><strong>Date :</strong> Vendredi 3 juillet 2026 à 21h00</li>\n                        <li><strong>Lieu :</strong> Place du Château (Devant le restaurant)</li>\n                        <li><strong>Artiste :</strong> Trio Frankie Rochester</li>\n                        <li><strong>Accès :</strong> Entrée libre pour le concert</li>\n                        <li class=\"pt-4 border-t border-village-dark/10 mt-4 text-sm\"><span class=\"font-semibold\">Transport :</span> Navette n°44 conseillée (départ Square Bourdet).</li>\n                    </ul>\n                    \n                    <p class=\"font-sans text-sm md:text-base text-village-dark/80 mb-6 italic\">\n                        Notre terrasse affiche complet très rapidement les soirs de concert. Nous vous recommandons vivement de réserver votre table à l'avance pour profiter de votre dîner tout en écoutant le trio.\n                    </p>\n                    \n                    <!-- Gros Call-To-Action -->\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\" class=\"inline-block w-full sm:w-auto bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-5 px-10 font-sans tracking-widest uppercase text-sm font-semibold shadow-md hover:shadow-xl\">\n                        Réserver ma table\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-4\">\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg>\n                </a>\n                <a href=\"#\" onclick=\"event.preventDefault(); copyPageLink();\" aria-label=\"Copier le lien\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z\" clip-rule=\"evenodd\"></path>\n                    </svg>\n                </a>\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnWhatsApp();\" aria-label=\"Partager sur WhatsApp\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12.031 0C5.385 0 0 5.385 0 12.031c0 2.115.549 4.181 1.593 6L.041 24l6.126-1.609c1.761.947 3.747 1.447 5.864 1.447 6.645 0 12.031-5.385 12.031-12.031S18.676 0 12.031 0zM12.031 21.945c-1.8 0-3.565-.483-5.111-1.397l-.367-.217-3.799 1l1.018-3.705-.238-.378a9.923 9.923 0 01-1.528-5.32c0-5.503 4.476-9.979 9.979-9.979 5.503 0 9.979 4.476 9.979 9.979 0 5.503-4.476 9.979-9.979 9.979zm5.485-7.492c-.301-.151-1.782-.879-2.058-.979-.276-.1-.477-.151-.678.151-.201.301-.778.979-.954 1.18-.176.201-.351.226-.653.075-1.517-.759-2.736-1.579-3.79-2.91-.227-.285-.251-.453-.025-.654.103-.092.226-.263.34-.393.113-.13.151-.226.226-.376.075-.151.038-.285-.013-.41-.05-.125-.678-1.631-.929-2.234-.244-.585-.494-.505-.678-.514l-.578-.013c-.201 0-.527.075-.803.376-.276.301-1.054 1.029-1.054 2.509s1.079 2.911 1.23 3.111c.151.201 2.121 3.238 5.138 4.542.718.31 1.278.495 1.716.634.721.229 1.377.196 1.895.119.58-.087 1.782-.728 2.033-1.431.251-.703.251-1.305.176-1.431-.076-.126-.276-.201-.578-.352z\"></path></svg>\n                </a>\n            </div>\n\n        </article>\n    </main>\n\n</div>\n\n<!-- SCRIPT JAVASCRIPT DE LECTURE VIDÉO & PARTAGE -->\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function() {\n        let options = { root: null, rootMargin: '0px', threshold: 0.6 };\n\n        const forceMute = (video) => {\n            video.muted = true;\n            video.defaultMuted = true;\n            video.volume = 0;\n        };\n\n        let observerAudio = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                const video = entry.target;\n                const container = video.closest('.arched-video-frame');\n                if (entry.isIntersecting) {\n                    forceMute(video); // La vidéo reste toujours silencieuse.\n                    let playPromise = video.play();\n                    if (playPromise !== undefined) {\n                        playPromise.then(_ => {\n                            updatePlayUI(container, true);\n                        }).catch(error => {\n                            console.warn(\"Lecture vidéo retardée ou bloquée par le navigateur :\", error);\n                            updatePlayUI(container, false);\n                        });\n                    }\n                } else {\n                    video.pause();\n                    updatePlayUI(container, false);\n                }\n            });\n        }, options);\n\n        document.querySelectorAll('.obs-video').forEach(video => {\n            forceMute(video);\n            video.addEventListener('play', () => forceMute(video));\n            observerAudio.observe(video);\n        });\n    });\n\n    function toggleVideoPlay(videoId, buttonElement) {\n        const video = document.getElementById(videoId);\n        const container = video.closest('.arched-video-frame');\n        video.muted = true;\n        video.defaultMuted = true;\n        video.volume = 0;\n        if (video.paused) { \n            let playPromise = video.play();\n            if (playPromise !== undefined) {\n                playPromise.then(_ => {\n                    updatePlayUI(container, true);\n                }).catch(error => {\n                    console.warn(\"Erreur au lancement manuel de la vidéo :\", error);\n                    updatePlayUI(container, false);\n                });\n            }\n        } \n        else { \n            video.pause(); \n            updatePlayUI(container, false); \n        }\n    }\n\n    function updatePlayUI(container, isPlaying) {\n        const pauseIcon = container.querySelector('.pause-icon');\n        const playIcon = container.querySelector('.play-icon');\n        if(pauseIcon && playIcon) {\n            if(isPlaying) { pauseIcon.classList.remove('hidden'); playIcon.classList.add('hidden'); } \n            else { pauseIcon.classList.add('hidden'); playIcon.classList.remove('hidden'); }\n        }\n    }\n\n    /* PARTAGE SOCIAL */\n    function getShareUrl() { try { return encodeURIComponent((window.top && window.top.location.href) ? window.top.location.href : window.location.href); } catch (e) { return encodeURIComponent(window.location.href); } }\n    function getShareText() { try { return encodeURIComponent(document.title + ' - ' + ((window.top && window.top.location.href) ? window.top.location.href : window.location.href)); } catch (e) { return encodeURIComponent(document.title + ' - ' + window.location.href); } }\n    function shareOnFacebook() { window.open('https://www.facebook.com/sharer/sharer.php?u=' + getShareUrl(), '_blank', 'width=640,height=580'); }\n    function shareOnWhatsApp() { window.open('https://wa.me/?text=' + getShareText(), '_blank'); }\n    function copyPageLink() {\n        let url = '';\n        try { url = (window.top && window.top.location.href) ? window.top.location.href : window.location.href; } catch (e) { url = window.location.href; }\n        navigator.clipboard.writeText(url).then(() => { alert('Lien copié'); }).catch(() => { prompt('Copiez ce lien :', url); });\n    }\n</script>\n\n<!-- ===================================================================== -->\n<!-- FIN DE LA SECTION \"ARTICLE BLOG FRANKIE ROCHESTER\" -->\n<!-- ===================================================================== -->"
    }
