 border: 1px solid rgba(113, 53, 6, 0.15);\n        box-shadow: 0 18px 35px -12px rgba(113, 53, 6, 0.18);\n        transform: rotate(2deg);\n        transition: transform 0.4s ease, box-shadow 0.4s ease;\n        max-width: 230px;\n        margin: 0 auto;\n    }\n    .poster-frame:hover {\n        transform: rotate(0deg) translateY(-5px);\n        box-shadow: 0 24px 42px -14px rgba(113, 53, 6, 0.24);\n    }\n    .poster-filter {\n        filter: sepia(22%) contrast(1.04) opacity(0.94) grayscale(8%);\n    }\n    \n    /* Conteneur image signature en arche */\n    .arched-image-frame {\n        position: relative;\n        background: #ffffff;\n        padding: 10px;\n        border-radius: 140px 140px 0 0;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n        overflow: hidden;\n        transition: transform 0.5s ease, box-shadow 0.5s ease;\n        margin: 0 auto;\n        max-width: 320px;\n    }\n    .arched-image-frame:hover {\n        transform: translateY(-8px);\n        box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.4);\n    }\n    .arched-image-frame::before {\n        content: '';\n        position: absolute;\n        top: 8px; bottom: 8px; left: 8px; right: 8px;\n        border: 1px solid rgba(157, 98, 61, 0.6);\n        border-radius: 132px 132px 0 0;\n        pointer-events: none;\n        z-index: 30;\n    }\n    .image-mask {\n        position: relative;\n        width: 100%;\n        aspect-ratio: 9/16;\n        border-radius: 130px 130px 0 0;\n        overflow: hidden;\n        background-color: #000000;\n    }\n    .image-mask img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        display: block;\n        transition: transform 0.8s ease;\n    }\n    .arched-image-frame:hover .image-mask img {\n        transform: scale(1.05);\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-sunset-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO : PHOTO D’AMBIANCE -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden bg-village-dark\">\n        <img src=\"https://res.cloudinary.com/dp2ezgdnk/image/upload/q_auto,f_auto/v1783253696/737297588_1359413999476388_9002714285692394972_n_vws1sv.jpg\" alt=\"Coucher de soleil et ambiance des Sunsets du Château au Haut-de-Cagnes\" fetchpriority=\"high\" decoding=\"async\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 50%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/40 to-village-dark/60\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 drop-shadow-md\">Les dimanches d’été au Haut-de-Cagnes</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-2xl mb-6 leading-tight\">\n                Les Sunsets du Château\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">DJ sets, coucher de soleil & dîner en terrasse</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central -->\n        <article class=\"max-w-4xl mx-auto px-6 bg-village-bg relative\" itemscope itemtype=\"https://schema.org/BlogPosting\">\n            <meta itemprop=\"headline\" content=\"Les Sunsets du Château au Haut-de-Cagnes : DJ sets et dîner en terrasse\">\n            <meta itemprop=\"description\" content=\"DJ sets, artistes invités et dîner en terrasse chaque dimanche soir jusqu’au 6 septembre 2026 au Haut-de-Cagnes, à Cagnes-sur-Mer.\">\n            <meta itemprop=\"image\" content=\"https://res.cloudinary.com/dp2ezgdnk/image/upload/q_auto,f_auto/v1783253696/737297588_1359413999476388_9002714285692394972_n_vws1sv.jpg\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span><time datetime=\"2026-07-05\" itemprop=\"datePublished\">5 juillet 2026</time></span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                C'est le retour de l'un des rendez-vous les plus attendus de la saison estivale ! Pour leur 11ème édition, les célèbres <em>Sunsets du Château</em> reprennent leurs quartiers sur notre place historique. Le concept ? Terminer le week-end en douceur, en musique, et surtout, ensemble.\n            </p>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                L'esprit des Sunsets demeure intact depuis 2013 : offrir un moment de partage intergénérationnel et accessible à tous. Chaque dimanche soir de l'été, la Place du Château se métamorphose en un espace de convivialité absolue, baigné par la lumière du crépuscule.\n            </p>\n\n            <!-- Événement d'aujourd'hui : Opening Session -->\n            <div class=\"relative bg-village-white p-8 md:p-12 shadow-sm border border-village-dark/5 my-12 flex flex-col md:flex-row items-center gap-10\">\n                <div class=\"absolute top-0 left-0 w-1 h-full bg-village-accent\"></div>\n                \n                <div class=\"w-full md:w-2/3 text-center md:text-left\">\n                    <h2 class=\"font-cursive text-4xl md:text-6xl text-village-accent mb-6\">Ce dimanche 5 juillet : Opening Session</h2>\n                    <p class=\"font-sans uppercase tracking-[0.2em] text-village-dark/60 text-sm font-semibold mb-6\">« Back to the Roots & Soul »</p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Pour inaugurer cette nouvelle saison estivale, retrouvez <strong>The Original Sunset</strong>. Dès 19h00, laissez-vous porter par un DJ set exclusif 100 % vinyles, entre chaleur du soir et ambiance open air.\n                    </p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans font-medium italic\">\n                        \"Open air for Open minds. Let's Unite our Bodies and Souls.\"\n                    </p>\n                </div>\n\n                <div class=\"w-full md:w-1/3 flex justify-center\">\n                    <div class=\"poster-frame\">\n                        <img src=\"https://res.cloudinary.com/dp2ezgdnk/image/upload/q_auto,f_auto/v1783249706/unnamed_ywlalh.png\" alt=\"Visuel de l’Opening Session des Sunsets du Château au Haut-de-Cagnes\" loading=\"lazy\" class=\"w-full h-auto border border-village-dark/10 poster-filter\">\n                    </div>\n                </div>\n            </div>\n\n            <!-- Image d'ambiance intégrée & Texte -->\n            <div class=\"flex flex-col md:flex-row gap-10 md:gap-16 items-center my-16\">\n                \n                <!-- Colonne de l'image -->\n                <div class=\"w-full md:w-2/5 flex justify-center order-2 md:order-1\">\n                    <div class=\"arched-image-frame\">\n                        <div class=\"image-mask\">\n                            <img src=\"https://res.cloudinary.com/dp2ezgdnk/image/upload/q_auto,f_auto/v1781971323/687708916_18135689836554133_1339210102692643218_n_lwqwqb.jpg\" alt=\"Terrasse du restaurant Le Village pendant les Sunsets du Château au Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\">\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Colonne du texte -->\n                <div class=\"w-full md:w-3/5 order-1 md:order-2\">\n                    <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6\">Un rendez-vous hebdomadaire au Haut-de-Cagnes</h2>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Jusqu'au 6 septembre 2026, chaque dimanche soir au Haut-de-Cagnes verra défiler des DJ et des artistes invités pour des sessions live de 18h00 à 22h30. Les platines vibreront au son de sélections lounge, électro, soul, funk et disco, face à la Place du Château à Cagnes-sur-Mer.\n                    </p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Pour profiter pleinement de cette atmosphère unique sans vous soucier de rien, notre terrasse vous accueille aux premières loges. L'occasion idéale de partager nos fameuses planches de cochonailles ou de déguster nos plats bistronomiques, tout en vous laissant bercer par les mix vinyles et les couleurs du coucher de soleil.\n                    </p>\n\n                </div>\n\n            </div>\n\n            <!-- INFORMATIONS PRATIQUES & RÉSERVATION -->\n            <section class=\"info-card p-8 md:p-12 shadow-xl mb-16 mt-16 relative\" aria-labelledby=\"infos-sunsets\">\n                <div class=\"text-center\">\n                    <p class=\"font-sans text-village-accent uppercase tracking-[0.22em] text-xs mb-4\">Les Sunsets du Château</p>\n                    <h2 id=\"infos-sunsets\" class=\"font-serif text-2xl md:text-3xl text-village-dark mb-6\">Informations pratiques : vos dimanches d’été au Haut-de-Cagnes</h2>\n                    <ul class=\"font-sans text-village-dark/80 space-y-4 mb-8 text-base md:text-lg\">\n                        <li><strong>Dates :</strong> Tous les dimanches, du 5 juillet au 6 septembre 2026</li>\n                        <li><strong>Horaires :</strong> De 18h00 / 19h00 à 22h30, selon la programmation</li>\n                        <li><strong>Lieu :</strong> Place du Château, Haut-de-Cagnes</li>\n                        <li><strong>Ambiance :</strong> DJ sets, artistes invités, vinyles, soul, funk, disco et électro</li>\n                        <li class=\"pt-4 border-t border-village-dark/10 mt-4 text-sm\"><span class=\"font-semibold\">Transport :</span> Navette n°44 conseillée, au départ du Square Bourdet.</li>\n                    </ul>\n\n                    <p class=\"font-sans text-sm md:text-base text-village-dark/80 mb-4 italic\">\n                        Notre terrasse est très demandée les dimanches d’été. Réservez votre table à l’avance pour dîner face à la Place du Château et profiter du Sunset depuis les premières loges.\n                    </p>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\" class=\"inline-block w-full sm:w-auto bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-5 px-10 font-sans tracking-widest uppercase text-sm font-semibold shadow-md hover:shadow-xl\">\n                        Réserver ma table\n                    </a>\n\n                    <div class=\"nav-links-village nav-links-village--cta mt-8\" aria-label=\"Accès rapides restaurant Le Village\">\n                        <div class=\"nav-col\">\n                            <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_top\" class=\"village-link\">Découvrir la carte</a>\n                            <a href=\"tel:+33493200886\" class=\"village-link\">Réserver par téléphone</a>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- PASSERELLE ÉDITORIALE : JAZZ AU CHÂTEAU -->\n            <aside class=\"jazz-weekly-note\" aria-label=\"Découvrir Jazz au Château\">\n                <p class=\"jazz-weekly-label\">Les vendredis au Haut-de-Cagnes</p>\n                <p class=\"jazz-weekly-copy\">\n                    Prolongez l’été en musique avec <a href=\"https://legrimaldibylevillage.com/fete-de-la-musique-jazz-chateau-cagnes-sur-mer\" target=\"_top\" aria-label=\"Découvrir le programme Jazz au Château du vendredi soir\">Jazz au Château <span aria-hidden=\"true\">→</span></a>\n                </p>\n            </aside>\n\n            <!-- ENCART HÔTEL : PROLONGEZ LA NUIT -->\n            <div class=\"bg-village-dark text-village-light p-8 md:p-12 shadow-xl mb-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-8 md:gap-12 rounded-sm border border-village-accent/20\">\n                <div class=\"absolute -top-24 -right-24 w-64 h-64 bg-village-accent/20 rounded-full blur-3xl pointer-events-none\"></div>\n                \n                <div class=\"w-full md:w-1/3 flex justify-center relative z-10\">\n                    <div class=\"w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden border-2 border-village-accent/30 shadow-2xl\">\n                        <img src=\"https://img.holidu.com/images/12689214-8a28-411b-b50e-160829238ec3/m.jpg\" alt=\"Chambre de l’Hôtel Le Grimaldi au Haut-de-Cagnes\" loading=\"lazy\" class=\"w-full h-full object-cover hover:scale-110 transition-transform duration-700\">\n                    </div>\n                </div>\n                \n                <div class=\"w-full md:w-2/3 relative z-10 text-center md:text-left\">\n                    <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mb-4\">Prolongez la magie</h2>\n                    <p class=\"font-sans text-base md:text-lg text-village-light/80 leading-relaxed mb-6\">\n                        Quand la musique s’arrête à 22h30, prolongez cette parenthèse sans redescendre sur la côte. Passez la nuit dans l’une de nos chambres au cœur du Haut-de-Cagnes et profitez d’un réveil paisible, face à la Méditerranée.\n                    </p>\n                    <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" class=\"inline-block border border-village-accent text-village-accent hover:bg-village-accent hover:text-village-white transition-colors duration-300 py-3 px-8 font-sans tracking-widest uppercase text-xs md:text-sm\">\n                        Découvrir nos chambres\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-4\">\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg>\n                </a>\n                <a href=\"#\" onclick=\"event.preventDefault(); copyPageLink();\" aria-label=\"Copier le lien\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"e