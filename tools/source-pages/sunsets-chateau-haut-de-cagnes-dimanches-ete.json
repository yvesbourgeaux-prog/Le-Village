      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG SUNSETS\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!--\nSEO À RENSEIGNER DANS LES CHAMPS SEO NATIFS DE L’ARTICLE HOSTINGER\nTitre SEO : Sunsets du Château au Haut-de-Cagnes : DJ sets & dîner en terrasse | Le Village\nMéta-description : Les Sunsets du Château animent le Haut-de-Cagnes chaque dimanche jusqu’au 6 septembre 2026 : DJ sets, coucher de soleil et dîner en terrasse à Cagnes-sur-Mer.\nSlug conseillé : sunsets-chateau-cagnes-sur-mer-2026\n-->\n\n<!-- Données structurées Google : article + rendez-vous d’ouverture -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"BlogPosting\",\n      \"headline\": \"Les Sunsets du Château au Haut-de-Cagnes : DJ sets et dîner en terrasse\",\n      \"description\": \"Chaque dimanche soir jusqu’au 6 septembre 2026, les Sunsets du Château animent la Place du Château au Haut-de-Cagnes avec DJ sets, artistes invités et dîner en terrasse.\",\n      \"image\": \"https://res.cloudinary.com/dp2ezgdnk/image/upload/q_auto,f_auto/v1783253696/737297588_1359413999476388_9002714285692394972_n_vws1sv.jpg\",\n      \"datePublished\": \"2026-07-05\",\n      \"dateModified\": \"2026-07-05\",\n      \"inLanguage\": \"fr-FR\",\n      \"keywords\": \"Sunsets du Château, Haut-de-Cagnes, Cagnes-sur-Mer, DJ set, dîner en terrasse, événements été 2026\",\n      \"author\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Le Grimaldi by Le Village\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Le Village\"\n      },\n      \"about\": [\n        \"Sunsets du Château\",\n        \"Haut-de-Cagnes\",\n        \"Cagnes-sur-Mer\",\n        \"DJ set\",\n        \"Terrasse\"\n      ]\n    },\n    {\n      \"@type\": \"Musi