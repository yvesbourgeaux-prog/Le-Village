      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG NOËL\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #000 !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n\n    /* Conteneur Reel Facebook responsif et élégant */\n    .reel-embed-container {\n        background: #ffffff;\n        padding: 8px;\n        border: 1px solid rgba(113, 53, 6, 0.1);\n        border-radius: 4px;\n        box-shadow: 0 15px 35px -10px rgba(113, 53, 6, 0.15);\n        display: inline-flex;\n        transition: transform 0.4s ease;\n    }\n    .reel-embed-container:hover {\n        transform: translateY(-5px);\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-noel-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes pour Hostinger) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/gnKoPAn3rxzY53IR/602379336_18121185049554133_4280548182950163818_n-FroRZW4UfyqLk58e.jpg\" alt=\"Bulle géante de Noël au Restaurant Le Village\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 60%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight\">\n                Noël au Haut-de-Cagnes : <br>Une parenthèse féerique\n            </h1>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>19 Décembre 2025</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Chaque hiver, le Haut-de-Cagnes révèle une autre facette de son charme. Les ruelles pavées, les pierres anciennes et la place du Château se parent de lumières, transformant le village médiéval en un décor presque cinématographique.\n            </p>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                À l’approche des fêtes, l’atmosphère change. On ne vient plus seulement visiter le Haut-de-Cagnes. On y vient pour ressentir quelque chose. Une douceur, une chaleur, un esprit de Noël qui s’installe naturellement entre les façades éclairées et la silhouette du Château Grimaldi.\n            </p>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-6 text-center\">Une bulle géante au cœur du village</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Parmi les installations les plus remarquées, la bulle géante installée sur la place du Château attire tous les regards. Avec les montagnes en toile de fond et le château en surplomb, la scène semble tout droit sortie d’un film de Noël.\n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                À l’intérieur du Restaurant Le Village, la décoration se prolonge : lumières chaleureuses, détails festifs, terrasse illuminée. L’ensemble crée une ambiance intime et enveloppante, idéale pour un dîner en famille, entre amis ou entre collègues.\n            </p>\n\n            <!-- Citation de style -->\n            <blockquote class=\"my-12 text-center border-t border-b border-village-accent/30 py-8 px-4\">\n                <p class=\"font-cursive text-3xl md:text-4xl text-village-accent leading-relaxed\">\n                    \"Ce n’est pas simplement un repas de fin d’année. C’est une expérience à vivre.\"\n                </p>\n            </blockquote>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-6 text-center\">Une adresse reconnue au cœur des fêtes</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                L’an dernier déjà, la Ville de Cagnes-sur-Mer saluait l’initiative du Restaurant Le Village pour sa décoration de Noël qui illuminait la place du Château. Cette reconnaissance souligne l’engagement de l’établissement dans la vie du Haut-de-Cagnes et son rôle dans l’ambiance festive du village.\n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-12\">\n                Chaque année, la magie se réinvente. Le décor évolue, les lumières se multiplient, l’atmosphère gagne en intensité.\n            </p>\n\n            <!-- INTÉGRATION DES VIDÉOS REELS -->\n            <div class=\"flex flex-col md:flex-row justify-center items-center gap-8 md:gap-12 my-16\">\n                <div class=\"reel-embed-container\">\n                    <iframe src=\"https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F2050310779099163%2F&show_text=false&width=267&t=0\" width=\"267\" height=\"476\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                    </iframe>\n                </div>\n                <div class=\"reel-embed-container\">\n                    <iframe src=\"https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F1191428565800992%2F&show_text=false&width=267&t=0\" width=\"267\" height=\"476\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                    </iframe>\n                </div>\n            </div>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-16 mb-6 text-center\">Un Noël à partager</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Au Restaurant Le Village, Noël se vit pleinement. Les plats réconfortants accompagnent les conversations, les rires résonnent sous la bulle, et les souvenirs se créent naturellement. Certains dimanches, la visite du Père Noël ajoute une touche supplémentaire d’émerveillement pour les enfants. Les familles se retrouvent autour d’un moment simple, chaleureux et sincère.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Dans le Haut-de-Cagnes, Noël ne se résume pas à une date. Il devient une ambiance, une rencontre, un instant suspendu.\n            </p>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-6 text-center\">Vivre Noël autrement</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Entre le charme du village médiéval, la vue sur les montagnes et le décor féerique imaginé par Le Village, la période des fêtes prend ici une dimension particulière. Pour celles et ceux qui cherchent un lieu authentique pour célébrer Noël à Cagnes-sur-Mer, la place du Château devient une évidence.\n            </p>\n\n            <!-- BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-16 border-t border-village-accent/20 pt-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n                \n                <!-- Facebook -->\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                        <path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path>\n                    </svg>\n                </a>\n                \n                <!-- Instagram = copier le lien -->\n                <a href=\"#\" onclick=\"event.preventDefault(); copyPageLink();\" aria-label=\"Copier le lien de la page\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                        <path fill-rule=\"evenodd\" d=\"M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z\" clip-rule=\"evenodd\"></path>\n                    </svg>\n                </a>\n                \n                <!-- WhatsApp -->\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnWhatsApp();\" aria-label=\"Partager sur WhatsApp\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                        <path d=\"M12.031 0C5.385 0 0 5.385 0 12.031c0 2.115.549 4.181 1.593 6L.041 24l6.126-1.609c1.761.947 3.747 1.447 5.864 1.447 6.645 0 12.031-5.385 12.031-12.031S18.676 0 12.031 0zM12.031 21.945c-1.8 0-3.565-.483-5.111-1.397l-.367-.217-3.799 1l1.018-3.705-.238-.378a9.923 9.923 0 01-1.528-5.32c0-5.503 4.476-9.979 9.979-9.979 5.503 0 9.979 4.476 9.979 9.979 0 5.503-4.476 9.979-9.979 9.979zm5.485-7.492c-.301-.151-1.782-.879-2.058-.979-.276-.1-.477-.151-.678.151-.201.301-.778.979-.954 1.18-.176.201-.351.226-.653.075-1.517-.759-2.736-1.579-3.79-2.91-.227-.285-.251-.453-.025-.654.103-.092.226-.263.34-.393.113-.13.151-.226.226-.376.075-.151.038-.285-.013-.41-.05-.125-.678-1.631-.929-2.234-.244-.585-.494-.505-.678-.514l-.578-.013c-.201 0-.527.075-.803.376-.276.301-1.054 1.029-1.054 2.509s1.079 2.911 1.23 3.111c.151.201 2.121 3.238 5.138 4.542.718.31 1.278.495 1.716.634.721.229 1.377.196 1.895.119.58-.087 1.782-.728 2.033-1.431.251-.703.251-1.305.176-1.431-.076-.126-.276-.201-.578-.352z\"></path>\n                    </svg>\n                </a>\n            </div>\n\n        </div>\n\n        <!-- GALERIE MASONRY (Photos de l'ambiance Noël) -->\n        <div class=\"max-w-7xl mx-auto px-6 mt-16\">\n            <h3 class=\"font-cursive text-5xl md:text-6xl text-village-accent text-center mb-12\">Souvenirs de Fêtes</h3>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 auto-rows-[250px] md:auto-rows-[300px]\">\n                \n                <!-- Image 1 -->\n                <div class=\"overflow-hidden rounded-sm group relative shadow-md\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=384,fit=crop,q=100/gnKoPAn3rxzY53IR/587712398_18120431521554133_4619749419016656000_n-WO7bRpnqWXffPuoB.jpg\" alt=\"Détail décoration de Noël\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n                <!-- Image 2 (Col span 2) -->\n                <div class=\"overflow-hidden rounded-sm group relative md:col-span-2 shadow-md\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/gnKoPAn3rxzY53IR/487476566_1002112635463076_6649088112842442611_n-aCcY7xdoxejvKPgk.jpg\" alt=\"Lumières et ambiance festive\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n                <!-- Image 3 (Row span 2) -->\n                <div class=\"overflow-hidden rounded-sm group relative md:row-span-2 shadow-md\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/gnKoPAn3rxzY53IR/586711707_18120431485554133_7589341004137601980_n-2DnKQkrqeX7G5Lmd.jpg\" alt=\"Intérieur chaleureux Restaurant Le Village\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n                <!-- Image 4 -->\n                <div class=\"overflow-hidden rounded-sm group relative shadow-md\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/gnKoPAn3rxzY53IR/487304171_1002112628796410_6008890785911530073_n-TnyTKgCiJugVD3iT.jpg\" alt=\"Féerie de Noël au Haut-de-Cagnes\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n                <!-- Image 5 -->\n                <div class=\"overflow-hidden rounded-sm group relative shadow-md\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/gnKoPAn3rxzY53IR/487420090_1002112648796408_8951759474181846050_n-urz5hptMTNqS1AKQ.jpg\" alt=\"Table de fête au Restaurant Le Village\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n                <!-- Image 6 (Col span 2) -->\n                <div class=\"overflow-hidden rounded-sm group relative md:col-span-2 shadow-md\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/gnKoPAn3rxzY53IR/589651208_18120431494554133_5645194170732575924_n-Odl1FZUqJqklWvzy.jpg\" alt=\"Décoration sous la bulle\" class=\"w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105\">\n                </div>\n\n            </div>\n        </div>\n\n    </main>\n\n</div>\n\n<!-- 3. SCRIPT JAVASCRIPT : Logique Audio, Trigger au Scroll & Partage Social -->\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function() {\n        // --- LOGIQUE D'APPARITION DES VIDÉOS ---\n        let options = { root: null, rootMargin: '0px', threshold: 0.6 };\n\n        let observerAudio = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                const video = entry.target;\n                const container = video.closest('.arched-video-frame');\n                \n                if (entry.isIntersecting) {\n                    container.classList.add('is-visible');\n                }\n            });\n        }, options);\n\n        document.querySelectorAll('.obs-video').forEach(video => {\n            observerAudio.observe(video);\n        });\n    });\n\n    // --- FONCTIONS DE PARTAGE SOCIAL ---\n    function getShareUrl() {\n        try {\n            return encodeURIComponent((window.top && window.top.location.href) ? window.top.location.href : window.location.href);\n        } catch (e) {\n            return encodeURIComponent(window.location.href);\n        }\n    }\n\n    function getShareText() {\n        try {\n            return encodeURIComponent(document.title + ' - ' + ((window.top && window.top.location.href) ? window.top.location.href : window.location.href));\n        } catch (e) {\n            return encodeURIComponent(document.title + ' - ' + window.location.href);\n        }\n    }\n\n    function shareOnFacebook() {\n        const shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + getShareUrl();\n        window.open(shareUrl, '_blank', 'width=640,height=580');\n    }\n\n    function shareOnWhatsApp() {\n        const shareUrl = 'https://wa.me/?text=' + getShareText();\n        window.open(shareUrl, '_blank');\n    }\n\n    function copyPageLink() {\n        let url = '';\n        try {\n            url = (window.top && window.top.location.href) ? window.top.location.href : window.location.href;\n        } catch (e) {\n            url = window.location.href;\n        }\n\n        navigator.clipboard.writeText(url).then(() => {\n            alert('Lien copié');\n        }).catch(() => {\n            prompt('Copiez ce lien :', url);\n        });\n    }\n</script>\n<!-- ===================================================================== -->\n<!-- FIN DE LA SECTION \"ARTICLE BLOG NOËL\" -->\n<!-- ===================================================================== -->"
    }
