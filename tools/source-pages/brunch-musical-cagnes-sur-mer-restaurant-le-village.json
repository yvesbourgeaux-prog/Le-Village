      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG BRUNCH\" (VERSION HOSTINGER - MAI 2026) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<link rel=\"preconnect\" href=\"https://assets.zyrosite.com\" crossorigin=\"\">\n<link rel=\"preconnect\" href=\"https://res.cloudinary.com\" crossorigin=\"\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- CADRE VIDÉO FENÊTRE EN ARCHE ÉPURÉE --- */\n    .arched-video-frame {\n        position: relative;\n        background: #ffffff;\n        padding: 10px;\n        border-radius: 140px 140px 0 0;\n        border: 1px solid #713506;\n        box-shadow: 0 25px 50px -12px rgba(113, 53, 6, 0.15);\n        overflow: hidden;\n        transition: transform 0.5s ease, box-shadow 0.5s ease;\n        margin: 3rem auto;\n        max-width: 380px;\n        opacity: 0;\n        transform: translateY(40px);\n    }\n    .arched-video-frame.is-visible {\n        opacity: 1;\n        transform: translateY(0);\n    }\n    .arched-video-frame:hover {\n        transform: translateY(-8px);\n        box-shadow: 0 30px 60px -15px rgba(113, 53, 6, 0.25);\n    }\n    .arched-video-frame::before {\n        content: '';\n        position: absolute;\n        top: 8px; bottom: 8px; left: 8px; right: 8px;\n        border: 1px solid rgba(157, 98, 61, 0.6);\n        border-radius: 132px 132px 0 0;\n        pointer-events: none;\n        z-index: 30;\n    }\n    .video-mask {\n        position: relative;\n        width: 100%;\n        aspect-ratio: 9/16;\n        border-radius: 130px 130px 0 0;\n        overflow: hidden;\n        background-color: #000;\n    }\n    .video-mask video {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        display: block;\n        z-index: 10;\n        position: relative;\n    }\n\n    /* --- BOUTONS PREMIUM (GLASSMORPHISM) --- */\n    .glass-btn {\n        background: rgba(255, 255, 255, 0.25);\n        backdrop-filter: blur(8px);\n        -webkit-backdrop-filter: blur(8px);\n        border: 1px solid rgba(255, 255, 255, 0.4);\n        color: #ffffff;\n        transition: all 0.3s ease;\n    }\n    .glass-btn:hover {\n        background: rgba(255, 255, 255, 0.9);\n        color: #713506;\n        transform: scale(1.1);\n    }\n    .video-controls {\n        opacity: 0;\n        transition: opacity 0.4s ease;\n    }\n    .arched-video-frame:hover .video-controls {\n        opacity: 1;\n    }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* Style éditorial pour l'encart d'information */\n    .info-card {\n        background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(157, 98, 61, 0.1) 39px, rgba(157, 98, 61, 0.1) 40px);\n        background-color: #ffffff;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .arched-video-frame,\n        .glass-btn,\n        .video-controls,\n        .hover\\:scale-105 {\n            transition: none !important;\n        }\n    }\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BlogPosting\",\n  \"headline\": \"Notre grand Brunch Musical de Printemps au Haut-de-Cagnes\",\n  \"description\": \"Découvrez le Brunch Musical du Grimaldi by Le Village : cuisine maison, musique live et art de vivre méditerranéen sur la Place du Château au Haut-de-Cagnes.\",\n  \"image\": \"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/548927768_18110917903554133_6103352769976099505_n-tx4bw2LvKuuQwaTd.jpg\",\n  \"mainEntityOfPage\": {\n    \"@type\": \"WebPage\",\n    \"@id\": \"https://legrimaldibylevillage.com/brunch-musical-cagnes-sur-mer-restaurant-le-village\"\n  },\n  \"author\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Le Grimaldi by Le Village\"\n  },\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Le Grimaldi by Le Village\"\n  },\n  \"inLanguage\": \"fr-FR\",\n  \"keywords\": [\n    \"brunch musical Haut-de-Cagnes\",\n    \"brunch Cagnes-sur-Mer\",\n    \"restaurant Le Village\",\n    \"Place du Château\",\n    \"brunch fait maison\"\n  ]\n}\n</script>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-brunch-block\" class=\"font-serif antialiased w-full\" itemscope itemtype=\"https://schema.org/BlogPosting\">\n\n    <!-- SECTION HERO (Couverture de l'article) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/548927768_18110917903554133_6103352769976099505_n-tx4bw2LvKuuQwaTd.jpg\" alt=\"Brunch musical au restaurant Le Village sur la place du Château, Haut-de-Cagnes\" class=\"absolute inset-0 w-full h-full object-cover\" width=\"1600\" height=\"900\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/40 to-village-dark/60\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 itemprop=\"headline\" class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight max-w-4xl mx-auto\">\n                Notre grand Brunch Musical de Printemps\n            </h1>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <meta itemprop=\"image\" content=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/548927768_18110917903554133_6103352769976099505_n-tx4bw2LvKuuQwaTd.jpg\">\n            <meta itemprop=\"mainEntityOfPage\" content=\"https://legrimaldibylevillage.com/brunch-musical-cagnes-sur-mer-restaurant-le-village\">\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span itemprop=\"author\">Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>Mai 2026</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-8\">\n                Au sommet des ruelles pavées, l'arrivée des beaux jours résonne comme une promesse. Les températures s'adoucissent, la lumière azuréenne devient plus dorée, et nos terrasses s'éveillent pour vous inviter à la convivialité.\n            </p>\n            \n            <p itemprop=\"description\" class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Pour célébrer ce renouveau printanier, Le Grimaldi by Le Village a le plaisir de vous convier à un événement d'exception le <strong>dimanche 24 mai</strong> : notre grand Brunch Musical de la saison. Loin de l'agitation de la côte, sur la mythique Place du Château au Haut-de-Cagnes, venez vivre une parenthèse gourmande entre cuisine maison, musique live et art de vivre méditerranéen.\n            </p>\n\n            <!-- Citation de style -->\n            <blockquote class=\"my-12 text-center border-t border-b border-village-accent/30 py-8 px-4\">\n                <p class=\"font-cursive text-3xl md:text-4xl text-village-accent leading-relaxed\">\n                    \"Un dimanche parfait mêlant l'excellence de l'assiette à la douceur de vivre de la Riviera.\"\n                </p>\n            </blockquote>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-6 text-center\">Un brunch généreux, une âme festive</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Le Chef Patrice Rémy et sa brigade ont imaginé un brunch généreux, véritable ode aux produits gorgés de soleil. Vous y retrouverez nos créations salées aux inspirations méditerranéennes, mais également un éventail de douceurs réconfortantes, le tout entièrement fait maison.\n            </p>\n\n            <!-- VIDÉO INTÉGRÉE DANS LE FLUX DE L'ARTICLE -->\n            <div class=\"arched-video-frame group w-full\">\n                <div class=\"video-mask\">\n                    <video id=\"brunchVideo\" src=\"https://res.cloudinary.com/dp2ezgdnk/video/upload/q_auto/f_auto/v1781970955/AQOmAbtNMkKr1AmMAFgrE3nm6EyUIOt4D3er61A5dXatUH2pJ_1Ho4JDciS9wefZOnAOzyGuHhK83hiRUjuFuYWnDH69ALlNl3gleYw_eotltc.mp4\" loop playsinline class=\"obs-video\">\n                    </video>\n                    \n                    <div class=\"video-controls absolute bottom-6 left-0 right-0 flex justify-between px-6 z-40\">\n                        <button onclick=\"toggleSound('brunchVideo', this)\" class=\"glass-btn p-3 rounded-full shadow-lg focus:outline-none\" aria-label=\"Son\">\n                            <svg class=\"mute-icon w-5 h-5 hidden\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.531V19.69a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.506-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.395C2.806 8.757 3.63 8.25 4.51 8.25H6.75z\"></path></svg>\n                            <svg class=\"unmute-icon w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z\"></path></svg>\n                        </button>\n                        <button onclick=\"toggleVideoPlay('brunchVideo', this)\" class=\"glass-btn p-3 rounded-full shadow-lg focus:outline-none\" aria-label=\"Mettre en pause ou lire\">\n                            <svg class=\"pause-icon w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M6.75 5.25a.75.75 0 01.75-.75H9a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H7.5a.75.75 0 01-.75-.75V5.25zm7.5 0A.75.75 0 0115 4.5h1.5a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H15a.75.75 0 01-.75-.75V5.25z\" clip-rule=\"evenodd\"></path></svg>\n                            <svg class=\"play-icon w-5 h-5 hidden\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z\" clip-rule=\"evenodd\"></path></svg>\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mt-8 mb-6\">\n                Parce que l'histoire de notre Maison est intimement liée à la musique, ce brunch sera accompagné d’une programmation musicale live. Une ambiance délicate et entraînante, en écho à l’esprit artistique qui anime Le Village depuis plus d’une décennie.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-12\">\n                Entre la beauté des pierres anciennes et le raffinement de notre nouvelle carte, laissez-vous séduire par l'art de recevoir du Grimaldi. Les places étant limitées pour garantir une atmosphère intimiste, nous vous invitons à réserver votre table à l'avance.\n            </p>\n\n            <!-- ENCART INFORMATIONS PRATIQUES & RÉSERVATION -->\n            <div class=\"info-card p-8 md:p-12 shadow-xl mb-16 relative\">\n                <div class=\"text-center\">\n                    <h5 class=\"font-serif text-2xl text-village-dark mb-6\">Informations Pratiques</h5>\n                    <ul class=\"font-sans text-village-dark/80 space-y-4 mb-8 text-base md:text-lg\">\n                        <li><strong>Date :</strong> Dimanche 24 Mai</li>\n                        <li><strong>Lieu :</strong> Le Grimaldi by Le Village (Place du Château)</li>\n                        <li><strong>Ambiance :</strong> Brunch & Musique Live</li>\n                    </ul>\n                    \n                    <!-- Gros Call-To-Action -->\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\" class=\"inline-block w-full sm:w-auto bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-5 px-10 font-sans tracking-widest uppercase text-sm font-semibold shadow-md hover:shadow-xl\">\n                        Réserver ma table\n                    </a>\n                </div>\n            </div>\n            \n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n                \n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg>\n                </a>\n                \n                <a href=\"#\" onclick=\"event.preventDefault(); copyPageLink();\" aria-label=\"Copier le lien\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <s