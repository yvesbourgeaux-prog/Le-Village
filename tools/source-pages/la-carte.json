      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"NOUS RETROUVER\" (VERSION MINIMALISTE FINALE) -->\n<!-- ===================================================================== -->\n<!-- 1. MOTEUR GRAPHIQUE (Obligatoire pour Hostinger) -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&amp;family=Lato:wght@300;400;600&amp;family=Playfair+Display:ital,wght@0,400;0,600;1,400&amp;family=Poppins:wght@300;400;500&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                    'poppins': ['\"Poppins\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n<style>\n    body { margin: 0; padding: 0; }\n\n    /* Animation du lien itinéraire */\n    .btn-itineraire {\n        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n    .btn-itineraire:hover {\n        letter-spacing: 0.2em;\n        color: #713506;\n    }\n\n    /* Cadre de la carte : Ombre légère demandée */\n    .map-frame {\n        position: relative;\n        width: 100%;\n        height: 500px;\n        overflow: hidden;\n        border-radius: 2px;\n        /* Ombre plus diffuse et légère */\n        box-shadow: 0 15px 45px -15px rgba(113, 53, 6, 0.12);\n        border: 1px solid rgba(157, 98, 61, 0.08);\n    }\n    \n    @media (min-width: 768px) {\n        .map-frame {\n            height: 600px;\n        }\n    }\n\n    /* Le filtre signature sur la carte */\n    .map-sepia-overlay {\n        position: absolute;\n        inset: 0;\n        background: #f5f0ea;\n        mix-blend-mode: multiply;\n        opacity: 0.4;\n        pointer-events: none;\n        z-index: 5;\n    }\n\n    .google-map-iframe {\n        width: 100%;\n        height: 100%;\n        filter: grayscale(1) contrast(1.05) brightness(1);\n        border: 0;\n    }\n\n    /* Décoration de fond subtile */\n    .bg-ornament {\n        font-family: 'Playfair Display', serif;\n        font-size: 15vw;\n        color: rgba(113, 53, 6, 0.02);\n        position: absolute;\n        top: 10%;\n        left: -5%;\n        pointer-events: none;\n        user-select: none;\n        z-index: 0;\n        white-space: nowrap;\n    }\n</style>\n<!-- 2. CONTENU VISUEL -->\n<div class=\"font-serif antialiased w-full bg-village-bg relative overflow-hidden\" id=\"village-acces-prestige-block\">\n<!-- Ornement visuel en arrière-plan -->\n<div class=\"bg-ornament italic\">Haut-de-Cagnes</div>\n<section class=\"py-20 md:py-32 px-6 max-w-7xl mx-auto relative z-10\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center\">\n<!-- BLOC GAUCHE : INFORMATIONS -->\n<div class=\"lg:col-span-5 flex flex-col space-y-12\">\n<!-- Titre Signature -->\n<div>\n<span class=\"font-cursive text-5xl md:text-7xl text-village-accent block mb-2 leading-none\">Nous</span>\n<h2 class=\"font-serif text-3xl md:text-5xl text-village-dark uppercase tracking-tight\">retrouver</h2>\n</div>\n<!-- Liste d'informations épurée -->\n<div class=\"space-y-12\">\n<!-- Adresse (Uniquement l'adresse comme demandé) -->\n<div class=\"flex items-start space-x-6\">\n<div class=\"w-px h-12 bg-village-accent/30\"></div>\n<address class=\"not-italic text-lg md:text-xl text-village-dark/90 leading-relaxed\">\n                            4 Place du Château<br/>\n                            06800 Cagnes-sur-Mer\n                        </address>\n</div>\n<!-- Horaires -->\n<div class=\"flex items-start space-x-6\">\n<div class=\"w-px h-12 bg-village-accent/30\"></div>\n<p class=\"text-lg md:text-xl text-village-dark/80 leading-relaxed\">\n                            Du lundi au dimanche<br/>\n<span class=\"font-semibold text-village-dark tracking-tighter\">09h00 — 21h30</span>\n</p>\n</div>\n<!-- Contact & Itinéraire -->\n<div class=\"flex items-start space-x-6\">\n<div class=\"w-px h-12 bg-village-accent/30\"></div>\n<div class=\"flex flex-col\">\n<a class=\"text-lg md:text-xl text-village-dark hover:text-village-accent transition-colors mb-6\" href=\"tel:+33493200886\">\n                                +33 (0)4 93 20 08 86\n                            </a>\n<!-- Bouton Itinéraire (Texte simplifié) -->\n<a class=\"btn-itineraire font-poppins text-[11px] tracking-[0.2em] uppercase text-village-accent font-semibold flex items-center\" href=\"https://www.google.com/maps?daddr=Le%20Village%2C%204%20Place%20du%20Ch%C3%A2teau%2C%2006800%20Cagnes-sur-Mer\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                Itinéraire <span class=\"ml-4 text-lg\">→</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n<!-- BLOC DROITE : LA CARTE -->\n<div class=\"lg:col-span-7\">\n<div class=\"map-frame group\">\n<div class=\"map-sepia-overlay group-hover:opacity-20 transition-opacity duration-700\"></div>\n<iframe allowfullscreen=\"\" class=\"google-map-iframe\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5772.167891136452!2d7.143253012540032!3d43.66722217098099!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12cdd3a346a36765%3A0x78d3ee3334cce966!2sLe%20Village!5e0!3m2!1sfr!2sfr!4v1765063711533!5m2!1sfr!2sfr\">\n</iframe>\n<!-- Badge Signature flottant -->\n<div class=\"absolute bottom-10 left-10 z-10 bg-village-white px-6 py-4 shadow-xl border border-village-accent/10 md:block hidden transform -rotate-1\">\n<p class=\"font-cursive text-3xl text-village-accent mb-0\">La plus belle vue</p>\n<p class=\"font-sans text-[10px] uppercase tracking-widest text-village-dark/50\">sur le château grimaldi</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>\n<!-- ===================================================================== -->\n<!-- FIN DE LA SECTION \"NOUS RETROUVER\" -->\n<!-- ===================================================================== -->"
