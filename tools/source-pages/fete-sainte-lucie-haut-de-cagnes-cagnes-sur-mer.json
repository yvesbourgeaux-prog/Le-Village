      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG SAINTE-LUCIE\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #000 !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n\n    /* Conteneur Facebook responsif */\n    .fb-embed-container {\n        display: flex;\n        justify-content: center;\n        margin: 3rem 0;\n        width: 100%;\n        overflow: hidden;\n    }\n    .fb-embed-container iframe {\n        max-width: 100%;\n        border-radius: 4px;\n        box-shadow: 0 10px 30px -10px rgba(113, 53, 6, 0.15);\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-lucie-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes pour Hostinger) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=384,fit=crop,q=100/gnKoPAn3rxzY53IR/fete_sainte_lucie_2025-17-JkFJFsEx1KCAP1Dc.webp\" alt=\"Fête de la Sainte-Lucie au Haut-de-Cagnes\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 30%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/50 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight\">\n                La Fête de la Sainte-Lucie <br>au Haut-de-Cagnes\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">Une tradition suédoise qui illumine l’hiver</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>8 Décembre 2025</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Chaque mois de décembre, la Fête de la Sainte-Lucie illumine le Haut-de-Cagnes. Une tradition suédoise célébrée depuis près de quatre siècles entre chants, procession et convivialité.\n            </p>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4\">Une tradition ancrée dans l’histoire du village</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Depuis près de quatre siècles, Cagnois et Suédois se retrouvent pour célébrer ensemble la Sainte-Lucie au cœur du Haut-de-Cagnes. Cette tradition, chargée de symboles, apporte chaque année une atmosphère chaleureuse et apaisante au village médiéval.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Dans la culture suédoise, la Sainte-Lucie incarne la lumière au cœur de l’hiver. Elle marque symboliquement l’arrivée prochaine des jours plus longs. À Cagnes-sur-Mer, cette célébration a trouvé un écrin singulier dans les ruelles anciennes du Haut-de-Cagnes, où patrimoine et spiritualité se rencontrent naturellement.\n            </p>\n\n            <!-- INTÉGRATION FACEBOOK 1 -->\n            <div class=\"fb-embed-container\">\n                <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Fvilledecagnessurmer%2Fposts%2Fpfbid02sp2ME2nwrfSH5XRNSi4yBTUqiMPTkty8Hp1Fb51MFkXU2tssUJo7onnkmHruhs5Xl&show_text=true&width=500\" width=\"500\" height=\"493\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                </iframe>\n            </div>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4\">Une procession lumineuse dans les ruelles du Haut-de-Cagnes</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Le dimanche 14 décembre à 18 heures, la fête débute par une procession illuminée accompagnée de chants traditionnels. Les voix résonnent doucement entre les façades de pierre de la Bourgade, créant une ambiance à la fois solennelle et profondément émouvante.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                La procession se poursuit vers l’église Saint-Pierre Saint-Paul pour une messe solennelle. Bougies, couronnes lumineuses et mélodies nordiques transforment le village en un décor hors du temps, où chacun peut ressentir la beauté simple de cette tradition.\n            </p>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4\">Entre lumière méditerranéenne et tradition scandinave</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                La célébration de la Sainte-Lucie rappelle les liens anciens entre la Suède et la Côte d’Azur. Au fil des siècles, le Haut-de-Cagnes a su préserver cette tradition, devenue un rendez-vous attendu du mois de décembre.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Habitants, visiteurs et familles attachées à la culture suédoise se retrouvent chaque année pour partager ce moment de lumière et de recueillement. L’événement participe pleinement à l’identité culturelle du village et à son ouverture sur l’international.\n            </p>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4\">Prolonger la soirée dans l’esprit du village</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Après la procession et la messe, nombreux sont ceux qui choisissent de prolonger la soirée autour d’un moment convivial. La douceur des ruelles du Haut-de-Cagnes invite naturellement à s’attarder.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Les établissements de la place du Château et des environs contribuent à cette atmosphère chaleureuse. Autour d’un dîner, les conversations se poursuivent, les souvenirs se partagent et l’esprit de la Sainte-Lucie continue d’illuminer la soirée.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Au cœur du village, le restaurant Le Village s’inscrit dans cette continuité, offrant un cadre authentique et une ambiance propice aux rencontres et aux échanges, dans le respect de cette tradition séculaire.\n            </p>\n\n            <!-- INTÉGRATION FACEBOOK 2 -->\n            <div class=\"fb-embed-container\">\n                <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Fvilledecagnessurmer%2Fposts%2Fpfbid0JASVyaaXKctDcqCWyzgPiA3uwkxGiBsaHqmWKCMUXBpzf6aGUkCoKMTp9hfKhVavl&show_text=true&width=500\" width=\"500\" height=\"793\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                </iframe>\n            </div>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4 text-center\">Une lumière qui rassemble</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6 text-center\">\n                La Fête de la Sainte-Lucie au Haut-de-Cagnes est bien plus qu’un événement annuel. Elle incarne un héritage vivant, une passerelle entre cultures et une célébration de la lumière au cœur de l’hiver.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-12 text-center\">\n                Chaque mois de décembre, le village se transforme en un lieu de partage et de recueillement, rappelant que certaines traditions, traversant les siècles, continuent d’unir les générations.\n            </p>\n\n            <!-- BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-16 border-t border-b border-village-accent/20 py-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-cente