      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA PAGE \"DÉCOUVRIR LE HAUT-DE-CAGNES\" (SEO & STORYTELLING) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                    'poppins': ['\"Poppins\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n\n    /* --- CADRE EDITORIAL (Style Papier) --- */\n    .notebook-card {\n        background-color: #ffffff;\n        background-image: repeating-linear-gradient(0deg, transparent, transparent 35px, rgba(157, 98, 61, 0.08) 35px, rgba(157, 98, 61, 0.08) 36px);\n        border: 1px solid rgba(113, 53, 6, 0.15);\n        box-shadow: 0 15px 35px -10px rgba(113, 53, 6, 0.08);\n    }\n\n    /* --- BOUTONS LUXE (CTA FINAUX) --- */\n    .btn-luxury {\n        position: relative;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        padding: 16px 36px;\n        border: 1px solid rgba(113, 53, 6, 0.15);\n        color: #713506;\n        font-family: 'Poppins', sans-serif;\n        font-size: 11px;\n        font-weight: 500;\n        text-transform: uppercase;\n        letter-spacing: 0.15em;\n        text-decoration: none;\n        background-color: #ffffff;\n        overflow: hidden;\n        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n        cursor: pointer;\n        box-shadow: 0 10px 20px -5px rgba(113, 53, 6, 0.08);\n    }\n    .btn-luxury::before {\n        content: '';\n        position: absolute;\n        inset: 0;\n        background-color: rgba(113, 53, 6, 0.04);\n        transform: scaleY(0);\n        transform-origin: bottom;\n        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n        z-index: 0;\n    }\n    .btn-luxury:hover {\n        border-color: rgba(113, 53, 6, 0.6);\n        box-shadow: 0 15px 30px -5px rgba(113, 53, 6, 0.15);\n        transform: translateY(-2px);\n    }\n    .btn-luxury:hover::before { transform: scaleY(1); }\n    .btn-luxury-text { position: relative; z-index: 1; display: flex; align-items: center; }\n    .btn-luxury-arrow { margin-left: 12px; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); }\n    .btn-luxury:hover .btn-luxury-arrow { transform: translateX(6px); }\n    \n    /* --- FILTRE CUIVRÉ SIGNATURE --- */\n    .village-img-wrapper {\n        position: relative;\n        overflow: hidden;\n        background-color: #713506;\n    }\n    /* Calque Cuivré */\n    .village-img-wrapper::after {\n        content: ''; position: absolute; inset: 0;\n        background-color: #9d623d; mix-blend-mode: color; opacity: 0.85; \n        transition: opacity 0.6s ease; pointer-events: none; z-index: 10;\n    }\n    /* Calque Profondeur */\n    .village-img-wrapper::before {\n        content: ''; position: absolute; inset: 0;\n        background-color: rgba(113, 53, 6, 0.15); \n        transition: opacity 0.6s ease; pointer-events: none; z-index: 11;\n    }\n    /* Estompage du filtre uniquement au Survol */\n    .group:hover .village-img-wrapper::after, \n    .group:hover .village-img-wrapper::before { \n        opacity: 0; \n    }\n\n    /* Mouvement lent luxueux */\n    .village-img { \n        transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1); \n        will-change: transform; \n    }\n    .group:hover .village-img { \n        transform: scale(1.05); \n    }\n\n</style>\n\n<div id=\"haut-de-cagnes-page\" class=\"w-full\">\n\n    <!-- 1. HERO SECTION (Image de couverture agrandie sur mobile) -->\n    <header class=\"relative w-full h-[500px] sm:h-[550px] md:h-[600px] lg:h-[700px] flex items-center justify-center overflow-hidden bg-village-dark\">\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/cagnes-sur-mer-2022-KPCBJn5BkfMAwf0j.jpg\" alt=\"Vue panoramique du Haut-de-Cagnes et de son château\" class=\"absolute inset-0 w-full h-full object-cover\">\n        \n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/40 to-village-dark/70\"></div>\n\n        <div class=\"relative z-10 text-center px-6 mt-16 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-accent uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 drop-shadow-md font-semibold\">Découvrir la Riviera</span>\n            <h1 class=\"font-cursive text-6xl md:text-8xl lg:text-9xl text-village-white mb-6 leading-tight drop-shadow-lg font-medium\">\n                Le Haut-de-Cagnes\n            </h1>\n            <p class=\"font-sans uppercase tracking-[0.2em] font-medium text-village-light text-sm md:text-base drop-shadow-md\">Le joyau médiéval de la Côte d'Azur</p>\n        </div>\n    </header>\n\n    <!-- 2. CORPS DE LA PAGE -->\n    <main class=\"w-full pb-24 relative z-20 -mt-12\">\n        <div class=\"max-w-4xl mx-auto px-6 bg-village-bg relative pt-12 md:pt-16 pb-12 shadow-[0_-10px_40px_rgba(113,53,6,0.05)] rounded-t-sm\">\n            \n            <!-- Introduction -->\n            <div class=\"mb-16\">\n                <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                    Perché sur sa colline entre Nice et Cannes, le Haut-de-Cagnes est l'un des villages les plus fascinants de la Côte d'Azur. Loin du tumulte du littoral, ce bourg médiéval classé site historique depuis 1948 offre un véritable voyage hors du temps.\n                </p>\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                    Ses ruelles pavées, ses maisons de pierre parées de bougainvilliers et ses passages voûtés racontent des siècles d'histoire. Ici, la lumière si particulière de la Méditerranée vient caresser les façades ocre et révèle une atmosphère paisible, authentique et préservée.\n                </p>\n            </div>\n\n            <!-- SECTION : L'Héritage Grimaldi -->\n            <div class=\"mb-24\">\n                <div class=\"flex items-center gap-4 mb-8\">\n                    <div class=\"h-px bg-village-accent/30 flex-grow\"></div>\n                    <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark text-center\">L'Héritage Grimaldi</h2>\n                    <div class=\"h-px bg-village-accent/30 flex-grow\"></div>\n                </div>\n                \n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                    C’est en 1309 que le fief de Cagnes est passé des mains des comtes de Provence à celles de Rainier Ier Grimaldi, coseigneur de Monaco. C’est sous son impulsion que l'imposant <strong>Château-musée Grimaldi</strong>, qui fait directement face à notre établissement, a été érigé.\n                </p>\n\n                <!-- Bloc Image Château avec Filtre (Format original) -->\n                <div class=\"w-full flex justify-center mb-10 group\">\n                    <div class=\"village-img-wrapper rounded-sm shadow-md max-w-lg w-full bg-village-white p-2 md:p-3 border border-village-dark/5 aspect-[4/3]\">\n                        <img src=\"https://lh3.googleusercontent.com/p/AF1QipN7AaDOwafUdzFxmzDS63gOcxt2pepd7nUWlqiI=s680-w680-h510-rw\" alt=\"Le Château Grimaldi\" class=\"village-img w-full h-full object-cover\">\n                    </div>\n                </div>\n                \n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8 scroll-anim-trigger\">\n                    D'abord forteresse militaire dissuasive, l'édifice s'est métamorphosé au fil des siècles en une somptueuse demeure seigneuriale. À l'intérieur, laissez-vous surprendre par l’incroyable fresque en trompe-l’œil de Giulio Benso, <em>La Chute de Phaéton</em>, qui orne le plafond de la salle des audiences depuis 1624.\n                </p>\n\n                <!-- Image La Chute de Phaeton -->\n                <div class=\"w-full flex justify-center mb-12 group scroll-anim-trigger\">\n                    <div class=\"village-img-wrapper rounded-sm shadow-md w-full max-w-md bg-village-white p-2 border border-village-dark/5\">\n                        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/4033-eEmXhb1bOQlhI2M6.jpg\" alt=\"La Chute de Phaéton par Giulio Benso au Château Grimaldi\" class=\"village-img w-full h-auto max-h-[300px] md:max-h-[400px] object-contain\">\n                    </div>\n                </div>\n\n                <!-- Encart Prince Albert -->\n                <div class=\"notebook-card p-6 md:p-10 mb-8 border-l-4 border-l-village-accent flex flex-col md:flex-row items-center gap-8\">\n                    <div class=\"flex-1\">\n                        <p class=\"font-sans text-base text-village-dark/80 m-0 leading-relaxed mb-4\">\n                            <strong>Une évidence historique :</strong> Les liens unissant Cagnes-sur-Mer à la Principauté de Monaco sont toujours vibrants. L'Hôtel <em>Le Grimaldi by Le Village</em> porte d'ailleurs fièrement ce nom. Un attachement régional si fort que Son Altesse Sérénissime le <strong>Prince Albert II de Monaco</strong> nous a récemment fait l'immense honneur de déjeuner sur notre terrasse lors d'une visite exceptionnelle.\n                        </p>\n                        <a href=\"https://legrimaldibylevillage.com/visite-prince-albert-2-monaco-restaurant-le-village-cagnes\" target=\"_blank\" class=\"inline-block text-village-accent uppercase tracking-[0.15em] text-xs font-semibold hover:text-village-dark transition-colors border-b border-village-accent pb-1\">\n                            Revivre ce moment\n                        </a>\n                    </div>\n                    <!-- Miniature Prince Albert recadrée -->\n                    <div class=\"w-full md:w-1/3 max-w-[180px] shrink-0 group\">\n                        <div class=\"village-img-wrapper rounded-sm shadow-md border-4 border-village-white\">\n                            <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/640136904_18127511677554133_5954049839880848320_n-x1uZe0m9NKx2IBCC.jpg\" alt=\"Prince Albert II au Restaurant Le Village\" class=\"village-img w-full h-auto aspect-[4/5] object-cover\" style=\"object-position: 25% center;\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SECTION : Le Montmartre de la Côte d'Azur -->\n            <div class=\"mb-24 border-t border-village-accent/20 pt-16\">\n                \n                <div class=\"flex flex-col md:flex-row gap-10 items-center mb-16\">\n                    <div class=\"w-full md:w-1/2\">\n                        <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6\">Le Montmartre de la Côte d'Azur</h2>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-4\">\n                            L'aura du Haut-de-Cagnes doit beaucoup à la lumière éblouissante qui inonde la colline. Au début du XXe siècle, lorsque <strong>Pierre-Auguste Renoir</strong> vient s’établir dans notre ville, de nombreux artistes peintres amoureux de la Méditerranée lui emboîtent le pas.\n                        </p>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans\">\n                            Le village gagne alors son surnom mythique de \"Montmartre de la Côte d’Azur\". Une âme artistique qui habite encore chaque ruelle et chaque atelier de création d'aujourd'hui.\n                        </p>\n                    </div>\n                    \n                    <div class=\"w-full md:w-1/2 overflow-hidden rounded-sm border-[6px] border-village-white shadow-lg relative bg-village-light\">\n                        <!-- Image \"Un paradis pour les artistes\" -->\n                        <div class=\"aspect-[4/5] flex items-center justify-center p-8 text-center bg-[url('https://res.cloudinary.com/dbuwy6alc/image/upload/v1775934179/Place_du_caf%C3%A9_et_ch%C3%A2teau_m%C3%A9di%C3%A9val_fiiulm.png')] bg-cover bg-center\" style=\"background-blend-mode: multiply;\">\n                            <div class=\"bg-village-white/95 backdrop-blur-sm p-6 border border-village-accent/20 shadow-md\">\n                                <span class=\"font-cursive text-3xl md:text-4xl text-village-accent block mb-2\">Un paradis</span>\n                                <span class=\"font-sans text-sm tracking-widest uppercase text-village-dark\">pour les artistes</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- GRILLE DES ARTISTES (4 Colonnes avec filtre) -->\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8\">\n                    <!-- Renoir -->\n                    <div class=\"flex flex-col group cursor-pointer\">\n                        <div class=\"village-img-wrapper overflow-hidden rounded-sm shadow-md mb-4 bg-village-dark\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/8/88/Pierre-Auguste_Renoir_-_Terrasses_%C3%A0_Cagnes.jpg\" alt=\"Peinture de Renoir - Terrasses à Cagnes\" class=\"village-img w-full h-56 object-cover\">\n                        </div>\n                        <h4 class=\"font-serif text-lg text-village-dark mb-1 group-hover:text-village-accent transition-colors duration-500\">P.A. Renoir</h4>\n                        <p class=\"font-sans text-[10px] text-village-dark/70 uppercase tracking-widest\">Terrasses à Cagnes</p>\n                    </div>\n\n                    <!-- Bardot -->\n                    <div class=\"flex flex-col group cursor-pointer lg:mt-8\">\n                        <div class=\"village-img-wrapper overflow-hidden rounded-sm shadow-md mb-4 bg-village-dark\">\n                            <img src=\"https://cdn.artphotolimited.com/images/597620ca681a4e5b29462ebe/1000x1000/brigitte-bardot-a-la-tour-margot.jpg\" alt=\"Brigitte Bardot à la Tour Margot\" class=\"village-img w-full h-56 object-cover\" style=\"object-position: top;\">\n                        </div>\n                        <h4 class=\"font-serif text-lg text-village-dark mb-1 group-hover:text-village-accent transition-colors duration-500\">Brigitte Bardot</h4>\n                        <p class=\"font-sans text-[10px] text-village-dark/70 uppercase tracking-widest\">À la Tour Margot</p>\n                    </div>\n\n                    <!-- Klein -->\n                    <div class=\"flex flex-col group cursor-pointer\">\n                        <div class=\"village-img-wrapper overflow-hidden rounded-sm shadow-md mb-4 bg-village-dark\">\n                            <img src=\"https://chroniquesduchapeaunoir.wordpress.com/wp-content/uploads/2012/06/c83bd-klein21.jpg\" alt=\"Plaque maison Yves Klein\" class=\"village-img w-full h-56 object-cover\">\n                        </div>\n                        <h4 class=\"font-serif text-lg text-village-dark mb-1 group-hover:text-village-accent transition-colors duration-500\">Yves Klein</h4>\n                        <p class=\"font-sans text-[10px] text-village-dark/70 uppercase tracking-widest\">Maison \"La Goulette\"</p>\n                    </div>\n\n                    <!-- Modigliani -->\n                    <div class=\"flex flex-col group cursor-pointer lg:mt-8\">\n                        <div class=\"village-img-wrapper overflow-hidden rounded-sm shadow-md mb-4 bg-village-dark\">\n                            <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1776296315/Amedeo_Modigliani_-_Cypresses_and_Houses_at_Cagnes__Cypr%C3%A8s_et_maisons_%C3%A0_Cagnes__-_BF259_-_Barnes_Foundation_y5jwfe.jpg\" alt=\"Peinture Amedeo Modigliani - Cyprès et maisons à Cagnes\" class=\"village-img w-full h-56 object-cover\">\n                        </div>\n                        <h4 class=\"font-serif text-lg text-village-dark mb-1 group-hover:text-village-accent transition-colors duration-500\">A. Modigliani</h4>\n                        <p class=\"font-sans text-[10px] text-village-dark/70 uppercase tracking-widest\">Cyprès et maisons à Cagnes</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SECTION : L'Âme Festive et les Nuits Blanches -->\n            <div class=\"mb-24 border-t border-village-accent/20 pt-16\">\n                <h2 class=\"font-cursive text-5xl md:text-6xl text-village-accent text-center mb-8\">L'Âme bohème et festive</h2>\n                \n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                    Si les vieilles pierres de la Place du Château pouvaient parler, elles raconteraient l'effervescence d'une époque désormais mythique. Dans les années 60, le Haut-de-Cagnes était une fête permanente. Le lieu abritait le célèbre <strong>cabaret de Suzy Solidor</strong> — dont la donation au château regroupe aujourd'hui de nombreux portraits.\n                </p>\n\n                <!-- Photos Historiques -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-12\">\n                    <div class=\"flex flex-col group scroll-anim-trigger\">\n                        <div class=\"village-img-wrapper overflow-hidden rounded-sm shadow-md mb-3 bg-village-dark h-72 md:h-80\">\n                            <img src=\"https://musees.cagnes.fr/wp-content/uploads/2025/07/DE-LEMPICKA-Tamara_1800x1000-1.webp\" alt=\"Portrait de Suzy Solidor par Tamara de Lempicka\" class=\"village-img w-full h-full object-cover\" style=\"object-position: 50% 20%;\">\n                        </div>\n                        <p class=\"font-sans text-[10px] text-village-dark/60 uppercase tracking-widest text-center\">Suzy Solidor par Tamara de Lempicka</p>\n                    </div>\n                    <div class=\"flex flex-col group scroll-anim-trigger\">\n                        <div class=\"village-img-wrapper overflow-hidden rounded-sm shadow-md mb-3 bg-village-dark h-72 md:h-80\">\n                            <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/544725106_1448217609600209_5591049835628383221_n-9AGdrxvhNYKskiDW.jpg\" alt=\"La Place du Château d'époque\" class=\"village-img w-full h-full object-cover\">\n                        </div>\n                        <p class=\"font-sans text-[10px] text-village-dark/60 uppercase tracking-widest text-center\">La Place du Château dans les années 60</p>\n                    </div>\n                </div>\n\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                    Seules certaines enseignes, comme celle du mythique night-club <em>Le Jimmy’s</em>, témoignent encore de ces nuits blanches rythmées au son de <strong>Genesis, Barclay James Harvest ou des Pink Floyd</strong>. \n                </p>\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans font-medium mb-12\">\n                    Aujourd'hui, l'hôtel-restaurant <strong>Le Village</strong> est le fier héritier de ce passé. Connu pendant des décennies comme le club de jazz incontournable du village, l'établissement perpétue cette convivialité chaleureuse, où l'on dîne en terrasse sous les étoiles de la Riviera.\n                </p>\n\n                <!-- Photos du village médiéval (Déplacées ici) -->\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                    <div class=\"h-40 md:h-56 overflow-hidden rounded-sm shadow-md group\">\n                        <div class=\"village-img-wrapper h-full w-full\">\n                            <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/place-de-gaulle-haut-de-cagnes-YQfrbt7x9UtvMi0u.png\" alt=\"Haut-de-Cagnes - Place de Gaulle\" class=\"village-img w-full h-full object-cover\">\n                        </div>\n                    </div>\n                    <div class=\"h-40 md:h-56 overflow-hidden rounded-sm shadow-md group\">\n                        <div class=\"village-img-wrapper h-full w-full\">\n                            <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/rue-du-piolet-haut-de-cagnes-cu1zLe8uEIc295N5.png\" alt=\"Haut-de-Cagnes - Rue du Piolet\" class=\"village-img w-full h-full object-cover\">\n                        </div>\n                    </div>\n                    <div class=\"h-40 md:h-56 overflow-hidden rounded-sm shadow-md group\">\n                        <div class=\"village-img-wrapper h-full w-full\">\n                            <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/design-sans-titre7-vMmyk8CLIvJvqvsz.png\" alt=\"Haut-de-Cagnes - Ruelles\" class=\"village-img w-full h-full object-cover\">\n                        </div>\n                    </div>\n                    <div class=\"h-40 md:h-56 overflow-hidden rounded-sm shadow-md group\">\n                        <div class=\"village-img-wrapper h-full w-full\">\n                            <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/design-sans-titre3-661YoMk6Z8DbcTlI.png\" alt=\"Haut-de-Cagnes - Architecture\" class=\"village-img w-full h-full object-cover\">\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- SECTION : Un pont avec la Suède -->\n            <div class=\"mb-20 border-t border-village-accent/20 pt-16\">\n                <div class=\"flex items-center gap-4 mb-8\">\n                    <div class=\"h-px bg-village-accent/30 flex-grow\"></div>\n                    <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark text-center\">Un lien avec la Suède</h2>\n                    <div class=\"h-px bg-village-accent/30 flex-grow\"></div>\n                </div>\n                \n                <div class=\"flex flex-col md:flex-row gap-8 items-center\">\n                    <div class=\"w-full md:w-1/3 group\">\n                        <div class=\"village-img-wrapper rounded-sm shadow-md\">\n                            <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=384,fit=crop,q=100/gnKoPAn3rxzY53IR/fete_sainte_lucie_2025-17-JkFJFsEx1KCAP1Dc.webp\" alt=\"La Fête de la Sainte-Lucie\" class=\"village-img w-full h-auto aspect-square object-cover\">\n                        </div>\n                    </div>\n                    <div class=\"w-full md:w-2/3\">\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-4\">\n                            Le charme du Haut-de-Cagnes a depuis longtemps conquis les Scandinaves, à l'image de l'écrivain suédois <strong>Pär Lagerkvist</strong> (Prix Nobel 1951), inspiré par la quiétude des lieux.\n                        </p>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans\">\n                            Ce lien unique perdure chaque hiver lors de la <strong>Fête de la Sainte-Lucie</strong>. Procession aux chandelles et chants traditionnels transforment alors nos ruelles en un véritable conte de fées nordique.\n                        </p>\n                        \n                        <!-- Lien vers l'événement -->\n                        <div class=\"mt-6\">\n                            <a href=\"https://legrimaldibylevillage.com/fete-sainte-lucie-haut-de-cagnes-cagnes-sur-mer\" target=\"_blank\" class=\"inline-block text-village-accent uppercase tracking-[0.15em] text-xs font-semibold hover:text-village-dark transition-colors border-b border-village-accent pb-1\">\n                                Découvrir l'événement\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SECTION : L'Épicentre du Village & CTA FINAL -->\n            <div class=\"border-t border-village-accent/20 pt-16 mb-16 text-center\">\n                <span class=\"font-sans text-village-accent uppercase tracking-[0.2em] text-xs font-semibold block mb-4\">La Place du Château</span>\n                <h2 class=\"font-cursive text-5xl md:text-6xl text-village-dark mb-8\">Votre pied-à-terre</h2>\n                \n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans max-w-2xl mx-auto mb-10\">\n                    Cœur battant du Haut-de-Cagnes, la Place est le lieu où l'on se retrouve. C'est ici, face aux vieilles pierres et baigné par le soleil de la Riviera, que se dresse <strong>Le Grimaldi by Le Village</strong>.\n                </p>\n\n                <!-- Bloc Conversion vers le Restaurant/Hôtel (Version Palace) -->\n                <div class=\"bg-village-white border border-village-accent/10 p-8 md:p-12 shadow-xl relative overflow-hidden rounded-sm mt-8\">\n                    <h3 class=\"font-serif text-2xl md:text-3xl mb-4 text-village-dark\">Prolongez l'expérience</h3>\n                    <p class=\"font-sans text-sm md:text-base text-village-dark/80 mb-10 max-w-lg mx-auto\">\n                        Après votre balade dans les ruelles, accordez-vous une pause gastronomique sur notre terrasse, ou séjournez dans l'une de nos chambres de charme.\n                    </p>\n                    \n                    <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\">\n                        <!-- Bouton Restaurant -->\n                        <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\" class=\"btn-luxury w-full sm:w-auto\" title=\"Réserver une table au restaurant\">\n                            <span class=\"btn-luxury-text\">\n                                Réserver une table\n                                <svg class=\"w-4 h-4 btn-luxury-arrow\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3\"></path></svg>\n                            </span>\n                        </a>\n\n                        <!-- Bouton Hôtel -->\n                        <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-luxury w-full sm:w-auto\" title=\"Réserver une chambre à l'hôtel\">\n                            <span class=\"btn-luxury-text\">\n                                Réserver une chambre\n                                <svg class=\"w-4 h-4 btn-luxury-arrow\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3\"></path></svg>\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SECTION : FAQ & Infos Pratiques -->\n            <div class=\"notebook-card p-8 md:p-12\">\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-6 text-center\" style=\"line-height: 1.2;\">Guide Pratique & Accès</h2>\n                \n                <div class=\"space-y-6\">\n                    <div class=\"border-b border-village-dark/10 pb-4\">\n                        <h4 class=\"font-sans font-semibold text-village-dark text-base uppercase tracking-wider mb-2\" style=\"line-height: 1.2;\">Où se garer au Haut-de-Cagnes ?</h4>\n                        <p class=\"font-sans text-sm text-village-dark/80 m-0\" style=\"line-height: 1.6;\">Le parking automatisé du Planastel est disponible à l'entrée du village. Cependant, ses places sont limitées. Nous vous conseillons de vous garer en centre-ville de Cagnes-sur-Mer (Parking La Villette ou Sainte-Luce).</p>\n                    </div>\n                    \n                    <div class=\"border-b border-village-dark/10 pb-4\">\n                        <h4 class=\"font-sans font-semibold text-village-dark text-base uppercase tracking-wider mb-2\" style=\"line-height: 1.2;\">Y a-t-il une navette ?</h4>\n                        <p class=\"font-sans text-sm text-village-dark/80 m-0\" style=\"line-height: 1.6;\">Oui ! La navette gratuite N°44 part toutes les 15 minutes depuis la station centrale (Square Bourdet) au centre-ville et vous dépose directement sur la Place du Château.</p>\n                    </div>\n\n                    <div class=\"pb-2\">\n                        <h4 class=\"font-sans font-semibold text-village-dark text-base uppercase tracking-wider mb-2\" style=\"line-height: 1.2;\">Visite du Château</h4>\n                        <p class=\"font-sans text-sm text-village-dark/80 m-0\" style=\"line-height: 1.6;\">Ouvert tous les jours (sauf le mardi). Entrée : 4€ (gratuit pour les moins de 26 ans). L'accès à la tour offre un panorama exceptionnel à 360° sur la Méditerranée et le Mercantour.</p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </main>\n</div>\n\n<!-- ===================================================================== -->\n<!-- FIN DE LA PAGE \"DÉCOUVRIR LE HAUT-DE-CAGNES\" -->\n<!-- ===================================================================== -->"
    }
