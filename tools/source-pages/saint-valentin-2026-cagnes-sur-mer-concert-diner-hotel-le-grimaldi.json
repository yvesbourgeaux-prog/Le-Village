e .village-link::after,\n        .hover\\:scale-105 {\n            transition: none !important;\n        }\n    }\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BlogPosting\",\n  \"headline\": \"Saint-Valentin 2026 au Haut-de-Cagnes : concert, dîner romantique et nuit au Grimaldi\",\n  \"description\": \"Une idée de Saint-Valentin au Haut-de-Cagnes : concert lyrique au Château-musée Grimaldi, dîner romantique au restaurant Le Village et nuit à l'Hôtel Le Grimaldi.\",\n  \"image\": \"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=384,fit=crop,q=100/gnKoPAn3rxzY53IR/illust_concert_saint_valentin_14_fevrier_2026-IuLfqEG9S4Mu4syg.webp\",\n  \"datePublished\": \"2026-02-12\",\n  \"inLanguage\": \"fr-FR\",\n  \"author\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Le Grimaldi by Le Village\"\n  },\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Le Grimaldi by Le Village\"\n  },\n  \"about\": [\n    \"Saint-Valentin au Haut-de-Cagnes\",\n    \"restaurant romantique à Cagnes-sur-Mer\",\n    \"Hôtel Le Grimaldi\",\n    \"Château-musée Grimaldi\"\n  ]\n}\n</script>\n\n<!-- 2. CONTENU VISUEL -->\n<article id=\"village-blog-stvalentin-block\" class=\"font-serif antialiased w-full\" itemscope itemtype=\"https://schema.org/BlogPosting\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=384,fit=crop,q=100/gnKoPAn3rxzY53IR/illust_concert_saint_valentin_14_fevrier_2026-IuLfqEG9S4Mu4syg.webp\" alt=\"Concert lyrique de la Saint-Valentin 2026 au Château-musée Grimaldi, Haut-de-Cagnes\" class=\"absolute inset-0 w-full h-full object-cover\" width=\"1600\" height=\"900\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/80\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 itemprop=\"headline\" class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight\">\n                Saint-Valentin 2026 au Haut-de-Cagnes : <br>L'art d'aimer au Château\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4\">Concert lyrique, dîner romantique et nuit au Grimaldi</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <meta itemprop=\"image\" content=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=384,fit=crop,q=100/gnKoPAn3rxzY53IR/illust_concert_saint_valentin_14_fevrier_2026-IuLfqEG9S4Mu4syg.webp\">\n            <time itemprop=\"datePublished\" datetime=\"2026-02-12\" class=\"sr-only\">12 février 2026</time>\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span itemprop=\"author\">Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>12 Février 2026</span>\n                <span>•</span>\n                <span>2 min</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p itemprop=\"description\" class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Le samedi 14 février 2026, Cagnes-sur-Mer invite les amoureux à vivre une Saint-Valentin élégante, culturelle et résolument gourmande. Au Haut-de-Cagnes, offrez une expérience complète réunissant concert lyrique, dîner romantique au restaurant Le Village et nuit de charme à l’Hôtel Le Grimaldi.\n            </p>\n\n            <!-- ENCART LE PROGRAMME -->\n            <div class=\"program-card p-8 md:p-10 shadow-lg mb-16 relative mx-auto mt-12\">\n                <h2 class=\"font-sans text-sm tracking-[0.2em] uppercase text-village-accent mb-8 text-center\">Le programme parfait</h2>\n                \n                <ul class=\"space-y-6 font-serif text-village-dark text-lg md:text-xl\">\n                    <li class=\"flex items-start\">\n                        <span class=\"text-village-accent mr-4\">—</span>\n                        <span>Un <strong>concert lyrique</strong> intimiste au Château-musée Grimaldi.</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <span class=\"text-village-accent mr-4\">—</span>\n                        <span>Un <strong>dîner romantique</strong> aux chandelles au restaurant Le Village.</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <span class=\"text-village-accent mr-4\">—</span>\n                        <span>Une <strong>nuit au calme</strong> à l’Hôtel Le Grimaldi, pour prolonger la magie.</span>\n                    </li>\n                </ul>\n            </div>\n\n            <!-- LE CONCERT -->\n            <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4\">L'éveil des sens au Château Grimaldi</h2>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                À 15h, le Château-musée Grimaldi accueillera le concert <em>« Et si on fêtait la Saint-Valentin ? »</em>. Organisé par le Centre d’Art Lyrique de la Méditerranée et placé sous la direction d’Elizabeth Vidal et André Cognet, ce moment suspendu donnera le ton d'une soirée inoubliable.\n            </p>\n            \n            <div class=\"text-center mb-14\">\n                <a href=\"https://ville.cagnes.fr/actualites-csm/et-si-on-fetait-la-st-valentin-14-fevrier-2026/\" target=\"_blank\" class=\"inline-block border border-village-accent text-village-accent hover:bg-village-accent hover:text-village-white transition-colors duration-300 py-3 px-8 font-sans tracking-widest uppercase text-xs font-semibold\">\n                    Informations et Billetterie du concert\n                </a>\n            </div>\n\n            <!-- REEL FACEBOOK (Vidéo verticale) -->\n            <div class=\"flex justify-center my-14\">\n                <div class=\"rounded-sm overflow-hidden shadow-xl border border-village-dark/10 bg-white p-2\">\n                    <iframe loading=\"lazy\" title=\"Vidéo Saint-Valentin du restaurant Le Village\" src=\"https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F1449385920177856%2F&show_text=false&width=267&t=0\" width=\"267\" height=\"476\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                    </iframe>\n                </div>\n            </div>\n\n            <!-- LE DÎNER -->\n            <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-16 mb-4\">Prolongez la magie au cœur du village</h2>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Quand les dernières notes s’envolent dans le ciel du Haut-de-Cagnes, la soirée ne fait que commencer… À quelques pas du Château, Le Village vous ouvre ses portes pour prolonger cette parenthèse romantique. \n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                Le restaurant vous accueille dans une ambiance chaleureuse et intimiste, idéale pour célébrer l’amour sous toutes ses formes. Entre la beauté brute des pierres anciennes, la lumière douce des chandelles et une cuisine soignée orchestrée par le Chef Patrice Rémy, tout est pensé pour que l’émotion et les saveurs soient au rendez-vous.\n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- L'HÔTEL -->\n            <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-16 mb-4\">Et pourquoi pas une nuit au Grimaldi ?</h2>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Après le dîner, laissez la nuit vous envelopper dans la quiétude de l’Hôtel Le Grimaldi, situé sur la même place. Cet hôtel de charme confidentiel abrite cinq chambres uniques, où les poutres anciennes et les pierres apparentes se mêlent à une décoration contemporaine raffinée.\n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Une parenthèse idéale pour s’endormir au calme absolu, bercé par l’atmosphère paisible du Haut-de-Cagnes et le souvenir d’une Saint-Valentin inoubliable.\n            </p>\n\n            <!-- ENCART SUGGESTION ROMANTIQUE -->\n            <div class=\"bg-village-white p-8 md:p-10 border border-village-accent/10 shadow-sm mt-8 mb-10 text-center\">\n                <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-4\">Suggestion romantique</h3>\n                <p class=\"font-sans text-village-dark/80 text-base md:text-lg mb-6 leading-relaxed\">\n                    Réservez la magnifique <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_blank\" class=\"text-village-accent font-semibold hover:underline\">Suite Grimaldi</a>. Avec ses 28 m² d’élégance, son lit queen-size et son balcon privé, elle offre un réveil exceptionnel face à la mer Méditerranée pour un petit déjeuner gourmand baigné de soleil.\n                </p>\n                <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_blank\" class=\"inline-block bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-3 px-8 font-sans tracking-widest uppercase text-xs md:text-sm shadow-md\">\n                    Découvrir l'Hôtel\n                </a>\n            </div>\n\n            <!-- IMAGES DE LA SUITE GRIMALDI -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-16\">\n                <div class=\"overflow-hidden rounded-sm shadow-md h-64 md:h-80\">\n                    <img src=\"https://img.holidu.com/images/7035f3c1-d952-43c9-9cdd-d553b622db8a/m.jpg\" alt=\"Lit queen-size de la Suite Grimaldi, hôtel de charme au Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-700\">\n                </div>\n                <div class=\"overflow-hidden rounded-sm shadow-md h-64 md:h-80\">\n                    <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/cefc46d0-kZqKOUi1yahpowKa.webp\" alt=\"Ambiance élégante de la Suite Grimaldi à l’Hôtel Le Grimaldi, Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-700\">\n                </div>\n                <div class=\"overflow-hidden rounded-sm shadow-md h-64 md:h-80\">\n                    <img src=\"https://img.holidu.com/images/631d8a75-b674-4abe-a363-ac1e84929434/m.jpg\" alt=\"Détails de décoration de la Suite Grimaldi à l’Hôtel Le Grimaldi\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-700\">\n                </div>\n            </div>\n\n            <!-- 2EME BLOC DE LIENS CTA (Rappel pour le restaurant) -->\n            <div class=\"text-center mt-12 mb-8 border-t border-village-accent/20 pt-12\">\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Réservez votre table pour le dîner</h2>\n                <p class=\"font-sans text-base text-village-dark/80 mb-6\">\n                    Les places étant limitées pour garantir une atmosphère intimiste, nous vous invitons à anticiper votre réservation.\n                </p>\n                \n                <div class=\"nav-links-village nav-links-village--cta\" aria-label=\"Accès rapides restaurant Le Village\">\n                    <div class=\"nav-col\">\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                            Découvrir la carte\n                        </a>\n                        <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                            Réserver en ligne\n                        </a>\n                        <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                            Réserver par téléphone\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <!-- Partage Social -->\n<div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n    <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n    \n    <!-- Facebook -->\n    <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=