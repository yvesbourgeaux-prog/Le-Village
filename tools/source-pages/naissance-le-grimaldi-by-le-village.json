      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"PIED DE PAGE\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE (Obligatoire pour que Hostinger affiche le style) -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-footer-block\" class=\"font-serif antialiased w-full\">\n\n    <footer class=\"bg-village-dark pt-10 pb-12 border-t border-village-light/20\">\n        <div class=\"max-w-5xl mx-auto px-6 flex flex-col items-center text-center\">\n            \n            <!-- Logo (automatiquement affiché en blanc via CSS) -->\n            <a href=\"https://legrimaldibylevillage.com/\" target=\"_blank\" class=\"mb-6 inline-block hover:opacity-80 transition-opacity duration-300\">\n                <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1775925333/LEGRIMALDI_-_1_izam40.png\" alt=\"Le Grimaldi by Le Village\" class=\"h-44 md:h-64 lg:h-80 object-contain brightness-0 invert opacity-90\">\n            </a>\n\n            <!-- Réseaux Sociaux -->\n            <div class=\"flex space-x-6 mb-6 text-village-light\">\n                <a href=\"https://www.facebook.com/restaurantlevillagehdc\" target=\"_blank\" class=\"hover:text-village-accent transition-colors duration-300\">\n                    <svg class=\"w-6 h-6 md:w-7 md:h-7\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg>\n                </a>\n                <a href=\"https://www.instagram.com/restaurantlevillagehdc\" target=\"_blank\" class=\"hover:text-village-accent transition-colors duration-300\">\n                    <svg class=\"w-6 h-6 md:w-7 md:h-7\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504