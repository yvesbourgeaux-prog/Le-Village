idth: 100%;\n        overflow: hidden;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .nav-links-village .village-link::after {\n            transition: none !important;\n        }\n    }\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"BlogPosting\",\n      \"headline\": \"Pâques 2026 au Haut-de-Cagnes : Art en Fête & Déjeuner\",\n      \"description\": \"Programme de Pâques 2026 au Haut-de-Cagnes : Art en Fête, Château-musée Grimaldi et déjeuner en terrasse au restaurant Le Village, place du Château à Cagnes-sur-Mer.\",\n      \"image\": \"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/illust_haut_de_cagnes_art_fete_2026-ABuWIuwEdV1jjN3Q.webp\",\n      \"mainEntityOfPage\": {\n        \"@type\": \"WebPage\",\n        \"@id\": \"https://legrimaldibylevillage.com/paques-2026-haut-de-cagnes-art-en-fete-dejeuner-le-village\"\n      },\n      \"author\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Le Grimaldi by Le Village\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Le Grimaldi by Le Village\"\n      },\n      \"inLanguage\": \"fr-FR\",\n      \"keywords\": [\n        \"Pâques 2026 Haut-de-Cagnes\",\n        \"Art en Fête Cagnes-sur-Mer\",\n        \"restaurant Haut-de-Cagnes\",\n        \"déjeuner Place du Château\",\n        \"Château-musée Grimaldi\"\n      ]\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Quand a lieu l'événement Art en Fête au Haut-de-Cagnes ?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"L'édition de printemps d'Art en Fête se déroule le dimanche 5 avril 2026, de 11h à 18h, dans les rues du Haut-de-Cagnes.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Où déjeuner au Haut-de-Cagnes pendant Art en Fête ?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"La Place du Château permet de rester au cœur des festivités. Le Restaurant Le Village y accueille les visiteurs en terrasse avec des formules du midi.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-paques-block\" class=\"font-serif antialiased w-full\" itemscope itemtype=\"https://schema.org/BlogPosting\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes pour Hostinger) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/illust_haut_de_cagnes_art_fete_2026-ABuWIuwEdV1jjN3Q.webp\" alt=\"Pâques 2026 et Art en Fête au Haut-de-Cagnes, place du Château à Cagnes-sur-Mer\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 30%;\" width=\"1600\" height=\"900\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/50 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 itemprop=\"headline\" class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight max-w-4xl mx-auto\">\n                Pâques 2026 au Haut-de-Cagnes : Art en Fête & Déjeuner\n            </h1>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <meta itemprop=\"image\" content=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/illust_haut_de_cagnes_art_fete_2026-ABuWIuwEdV1jjN3Q.webp\">\n            <meta itemprop=\"mainEntityOfPage\" content=\"https://legrimaldibylevillage.com/paques-2026-haut-de-cagnes-art-en-fete-dejeuner-le-village\">\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span itemprop=\"author\">Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>Avril 2026</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Cette année, le week-end de Pâques (dimanche 5 et lundi 6 avril 2026) offre l’occasion parfaite de s’accorder une pause qui respire, loin de l'agitation.\n            </p>\n            \n            <p itemprop=\"description\" class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Comme un clin d’œil du calendrier, ce dimanche de Pâques coïncide avec le 1er dimanche du mois. Pour l'occasion, le Haut-de-Cagnes à Cagnes-sur-Mer s'anime et passe en mode <strong>Art en Fête</strong> de 11h à 18h, avec en prime une découverte gratuite du Château-musée Grimaldi.\n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Le programme idéal ? Flânerie culturelle dans les ruelles médiévales, musique classique et, surtout, un véritable moment de lâcher-prise en terrasse au Restaurant Le Village, directement sur la Place du Château.\n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA (Exactement selon vos consignes) -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- ENCART MENU -->\n            <div class=\"menu-card p-8 md:p-10 shadow-lg mb-16 relative text-center mx-auto max-w-lg mt-12\">\n                <h5 class=\"font-sans text-sm tracking-[0.2em] uppercase text-village-accent mb-6\">Le Midi <br><span class=\"text-xs lowercase text-village-dark/60\">(Semaine et week-end)</span></h5>\n                <div class=\"font-serif text-village-dark text-lg md:text-xl space-y-4\">\n                    <p class=\"flex flex-col md:flex-row justify-between items-center border-b border-village-dark/10 pb-4\">\n                        <span>Entrée + Plat <span class=\"italic text-sm text-village-dark/70 block md:inline\">ou</span> Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">24,50 €</span>\n                    </p>\n                    <p class=\"flex flex-col md:flex-row justify-between items-center pt-2\">\n                        <span>Entrée + Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">29,00 €</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- ITINÉRAIRE -->\n            <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mt-16 mb-8 text-center\">L’itinéraire d'une journée parfaite<br><span class=\"font-sans text-sm tracking-widest uppercase text-village-dark/60 not-italic block mt-4\">(Sans se presser)</span></h2>\n            \n            <div class=\"space-y-10 mb-12\">\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">11h00 : L'immersion avec Art en Fête</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Dès la fin de matinée, le Haut-de-Cagnes se transforme en un parcours artistique à ciel ouvert. Profitez de l'ambiance unique des ruelles historiques au rythme des expositions, des ateliers d'artistes, des visites guidées et des animations musicales.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">12h30 : Place en terrasse</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans mb-3\">\n                        Après une matinée de découverte, place au véritable privilège du week-end de Pâques : s’asseoir, souffler et profiter du soleil sur la Place du Château pour transformer l'engagement de la matinée en une vraie pause gourmande.\n                    </p>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Au Restaurant Le Village, notre terrasse devient votre point d’ancrage. Vous êtes au cœur de l'événement, aux premières loges du Haut-de-Cagnes, tout en savourant une cuisine authentique.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">15h30 : L'évasion au Château-musée</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Pour couronner cette journée, laissez-vous tenter par le Dimanche musical organisé au sein même du Château-musée Grimaldi. Ce dimanche 5 avril 2026 à 15h30, le Trio Goldberg (violon, alto, violoncelle) résonnera dans ce cadre historique d'exception. <em>(Billetterie de la ville : 12 € plein tarif / 9 € réduit)</em>.\n                    </p>\n                </div>\n            </div>\n\n            <!-- INTÉGRATION FACEBOOK -->\n            <div class=\"fb-embed-container\">\n                <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Frestaurantlevillagehdc%2Fposts%2Fpfbid02MCvTgdh4JFWd8NePe5s75PYkqqf7UZsARissvZLbMLAoqL7DTSys2bV6j53siMRUl&show_text=true&width=500\" width=\"500\" height=\"748\" style=\"border:none;overflow:hidden; box-shadow: 0 10px 30px -10px rgba(113, 53, 6, 0.15); border-radius: 4px;\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                </iframe>\n            </div>\n\n            <!-- LUNDI DE PÂQUES -->\n            <div class=\"bg-village-white p-8 border border-village-accent/10 shadow-sm mb-16 text-center\">\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Et le Lundi de Pâques ?</h2>\n                <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                    Le lundi 6 avril étant férié, c’est l'opportunité de prolonger l'expérience. Une deuxième journée pour revenir au Haut-de-Cagnes, prendre son temps et profiter de notre carte dans une atmosphère plus intimiste.\n                </p>\n            </div>\n\n            <!-- FAQ -->\n            <h2 class=\"font-serif text-3xl text-village-dark mt-16 mb-8 text-center border-b border-village-dark/10 pb-4\">Foire Aux Questions</h2>\n            <div class=\"space-y-6 mb-16\">\n                <div>\n                    <h3 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Quand a lieu l'événement Art en Fête au Haut-de-Cagnes ?</h3>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">L'édition de printemps d'Art en Fête se déroule le dimanche 5 avril 2026, de 11h à 18h, dans les rues du Haut-de-Cagnes.</p>\n                </div>\n                <div>\n                    <h3 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Le Château-musée Grimaldi est-il gratuit le 5 avril 2026 ?</h3>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Oui, la Ville annonce une découverte gratuite du Château-musée Grimaldi à l'occasion de ce premier dimanche du mois et de l'événement Art en Fête.</p>\n                </div>\n                <div>\n                    <h3 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">À quelle heure se tient le Dimanche musical au Château-musée ?</h3>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Le concert du Dimanche musical (Trio Goldberg) débutera à 15h30 le dimanche 5 avril 2026, au sein du Château-musée.</p>\n                </div>\n                <div>\n                    <h3 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Où déjeuner au Haut-de-Cagnes pendant Art en Fête ?</h3>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Pour rester au cœur des festivités, la Place du Château est l'emplacement idéal. Le Restaurant Le Village vous y accueille en terrasse avec des formules midi à 24,50 € et 29 € (pensez à réserver votre table à l'avance).</p>\n                </div>\n            </div>\n\n            <!-- 2EME BLOC DE LIENS CTA (Exactement selon vos consignes) -->\n            <div class=\"nav-links-village nav-links-village--cta my-12\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n           <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n    <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n    \n    <!-- Facebook -->\n    <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path>\n        </svg>\n    </a>\n    \n    <!-- Instagram = copier le lien -->\n    <a href=\"#\" onclick=\"event.preventDefault(); copyPageLink();\" aria-label=\"Copier le lien de la page\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill-rule=\"evenodd\" d=\"M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.