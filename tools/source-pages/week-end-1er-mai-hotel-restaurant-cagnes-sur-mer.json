      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"COMMUNIQUÉ 1ER MAI & CARTE\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n\n    /* --- IMAGE ENCADRÉE TYPE MENU (Cliquable) --- */\n    .menu-presentation-frame {\n        background: #ffffff;\n        padding: 12px;\n        border: 1px solid rgba(113, 53, 6, 0.15);\n        box-shadow: 0 25px 50px -12px rgba(113, 53, 6, 0.12);\n        transition: transform 0.4s ease, box-shadow 0.4s ease;\n        border-radius: 2px;\n        width: 100%;\n        position: relative;\n        display: block;\n        text-decoration: none;\n    }\n    .menu-presentation-frame:hover {\n        transform: translateY(-5px);\n        box-shadow: 0 30px 60px -15px rgba(113, 53, 6, 0.20);\n    }\n    .menu-image-inner {\n        position: relative;\n        width: 100%;\n        overflow: hidden;\n        border: 1px solid rgba(157, 98, 61, 0.3);\n    }\n    .menu-image-inner img {\n        width: 100%;\n        display: block;\n        transition: transform 0.8s ease;\n    }\n    .menu-presentation-frame:hover .menu-image-inner img {\n        transform: scale(1.03);\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-communique-1ermai-block\" class=\"font-serif antialiased w-full bg-village-bg overflow-hidden\">\n\n    <!-- SECTION HERO DE L'ARTICLE -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <!-- Image événementielle festive et printanière -->\n        <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1776019710/490935715_18096532069554133_8717733356139315233_n_r2gstg.jpg\" alt=\"Ambiance festive et printanière au Village\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 40%;\">\n        \n        <!-- Voile assombrissant pour lire le texte -->\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/50 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Communiqué de Presse</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight\">\n                Week-end du 1er Mai : <br>Fête des Mai & DJ Set \n            </h1>\n        </div>\n    </section>\n\n    <!-- CORPS DU COMMUNIQUÉ -->\n    <main class=\"w-full pb-24 -mt-10 md:-mt-16 relative z-20\">\n        <div class=\"max-w-6xl mx-auto px-6\">\n            \n            <div class=\"bg-village-white shadow-xl p-8 md:p-16 lg:p-20 relative\">\n                \n                <div class=\"flex flex-col lg:flex-row gap-12 lg:gap-20 items-start\">\n                    \n                    <!-- Colonne Texte (Storytelling de la carte) -->\n                    <div class=\"w-full lg:w-3/5\">\n                        <p class=\"font-sans text-sm text-village-accent uppercase tracking-widest mb-8 border-b border-village-accent/20 pb-4\">Cagnes-sur-Mer — Printemps 2026</p>\n                        \n                        <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                            Le vendredi 1er mai ouvre la voie aux beaux jours et aux week-ends prolongés. Pour célébrer ce renouveau, Le Grimaldi by Le Village vous invite à vivre trois jours d'exception sur la Place du Château.\n                        </p>\n                    \n                        <!-- Vendredi 1er Mai -->\n                        <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-10 mb-4\">Vendredi 1er Mai : La Fête des Mai</h4>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                            Dès le matin, le Haut-de-Cagnes s'anime au rythme de la traditionnelle <strong>Fête des Mai</strong>. L'ambiance provençale reprend ses droits avec la farandole sous les « Mai » et les animations locales. Prenez place sur notre terrasse face au château pour profiter de l'effervescence en toute sérénité.\n                        </p>\n\n                        <!-- La Nouvelle Carte -->\n                        <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-4\">La Nouvelle Carte : Fraîcheur méditerranéenne</h4>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                            Adieu l'hiver. Le Chef Patrice Rémy dévoile une nouvelle carte éclatante, pensée comme un hommage aux produits gorgés de soleil de notre terroir. L'occasion idéale pour la découvrir lors de ce grand week-end.\n                        </p>\n\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                            Pour commencer, la fraîcheur s'impose avec le <strong>Tartare de Saumon frais</strong> (lime, avocat brûlé et sésame), les emblématiques <strong>Panisses artisanaux de la Maison Daqi</strong> ou encore la véritable <strong>Burrata crémeuse d'Italie</strong>.\n                        </p>\n\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10 clear-both\">\n                            Côté mer, l'appel du large est irrésistible avec la <strong>Tentacule de Poulpe à la plancha</strong> et son condiment niçois, ou les superbes <strong>Gambas poêlées</strong> accompagnées d'un risotto crémeux de la Riviera. Côté terre, le Chef sublime les classiques avec un <strong>Suprême de volaille confit aux olives vertes, citron et cumin</strong>, qui incarne à lui seul toutes les saveurs du Sud.\n                        </p>\n\n                        <!-- Dimanche 3 Mai (DJ SET) -->\n                        <div class=\"bg-village-bg/60 border-l-4 border-village-accent p-6 mb-8 mt-12 shadow-sm rounded-sm\">\n                            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Dimanche 3 Mai : DJ Set & Art en Fête</h4>\n                            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans\">\n                                Pour clore ce week-end de la plus belle des manières, la Place du Château passera en mode <em>Art en Fête</em>. Et pour accompagner cette journée culturelle, Le Village monte le son ! <strong>Dès 12h00, un DJ s'installera sur notre terrasse</strong> pour orchestrer un déjeuner en musique. Le point de ralliement parfait, un verre de rosé bien frais à la main, avant ou après vos visites.\n                            </p>\n                        </div>\n\n                        <!-- Bouton Dossier de Presse & Contact -->\n                        <div class=\"mt-8 flex flex-col sm:flex-row gap-4 border-t border-village-accent/20 pt-8\">\n                            <a href=\"https://legrimaldibylevillage.com/dossier-presse\" target=\"_blank\" class=\"inline-block bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-4 px-8 font-sans tracking-widest uppercase text-xs md:text-sm text-center shadow-md\">\n                                Dossier de Presse\n                            </a>\n                            <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"inline-block border border-village-dark text-village-dark hover:bg-village-dark hover:text-village-light transition-colors duration-300 py-4 px-8 font-sans tracking-widest uppercase text-xs md:text-sm text-center\">\n                                Découvrir la carte\n                            </a>\n                        </div>\n                    </div>\n\n                    <!-- Colonne Visuelle (Image de la carte ouvre un nouvel onglet) -->\n                    <div class=\"w-full lg:w-2/5 flex justify-center lg:sticky lg:top-32 mt-12 lg:mt-0\">\n                        \n                        <!-- L'IMAGE OUVRE LA CARTE DANS UN NOUVEL ONGLET -->\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"menu-presentation-frame group\" title=\"Voir la carte complète\">\n                            \n                            <div class=\"menu-image-inner\">\n                                <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_Avril_2026_pb7fkg.png\" alt=\"La nouvelle carte de printemps du restaurant Le Village\" class=\"w-full h-auto object-contain bg-village-bg\">\n                            </div>\n                            \n                            <div class=\"text-center mt-4 pb-2 flex items-center justify-center space-x-2 text-village-dark/60 group-hover:text-village-accent transition-colors duration-300\">\n                                <span class=\"font-sans text-[10px] uppercase tracking-widest\">Voir la carte complète ↗</span>\n                            </div>\n                        </a>\n\n                    </div>\n\n                </div>\n\n                <!-- Mini-Galerie de la Suite de la Carte (Pop-up Lightbox Pleine Largeur) -->\n                <div class=\"mt-16 pt-12 border-t border-village-accent/20\">\n                    <h5 class=\"font-sans text-[11px] tracking-[0.2em] uppercase text-village-dark/60 mb-8 text-center\">Feuilleter le menu complet</h5>\n                    <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6\">\n                        <a href=\"#\" class=\"menu-trigger block overflow-hidden rounded-sm border border-village-dark/10 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 relative group\" data-index=\"0\" title=\"Agrandir la page\">\n                            <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_Avril_2026_pb7fkg.png\" alt=\"Menu Page 1\" class=\"w-full h-40 md:h-64 object-cover object-top opacity-90 group-hover:opacity-100 transition-opacity bg-village-light\">\n                            <div class=\"absolute inset-0 bg-village-dark/10 group-hover:bg-transparent transition-colors\"></div>\n                            <svg class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 text-village-white drop-shadow-md opacity-0 group-hover:opacity-100 transition-opacity\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7\"></path></svg>\n                        </a>\n                        <a href=\"#\" class=\"menu-trigger block overflow-hidden rounded-sm border border-village-dark/10 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 relative group\" data-index=\"1\" title=\"Agrandir la page\">\n                            <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_AVril_2026._ibghly.png\" alt=\"Menu Page 2\" class=\"w-full h-40 md:h-64 object-cover object-top opacity-90 group-hover:opacity-100 transition-opacity bg-village-light\">\n                            <div class=\"absolute inset-0 bg-village-dark/10 group-hover:bg-transparent transition-colors\"></div>\n                            <svg class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 text-village-white drop-shadow-md opacity-0 group-hover:opacity-100 transition-opacity\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7\"></path></svg>\n                        </a>\n                        <a href=\"#\" class=\"menu-trigger block overflow-hidden rounded-sm border border-village-dark/10 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 relative group\" data-index=\"2\" title=\"Agrandir la page\">\n                            <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_AVril_2026.._ub56nb.png\" alt=\"Menu Page 3\" class=\"w-full h-40 md:h-64 object-cover object-top opacity-90 group-hover:opacity-100 transition-opacity bg-village-light\">\n                            <div class=\"absolute inset-0 bg-village-dark/10 group-hover:bg-transparent transition-colors\"></div>\n                            <svg class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 text-village-white drop-shadow-md opacity-0 group-hover:opacity-100 transition-opacity\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7\"></path></svg>\n                        </a>\n                        <a href=\"#\" class=\"menu-trigger block overflow-hidden rounded-sm border border-village-dark/10 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 relative group\" data-index=\"3\" title=\"Agrandir la page\">\n                            <img src=\"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_AVril_2026..._eikipm.png\" alt=\"Menu Page 4\" class=\"w-full h-40 md:h-64 object-cover object-top opacity-90 group-hover:opacity-100 transition-opacity bg-village-light\">\n                            <div class=\"absolute inset-0 bg-village-dark/10 group-hover:bg-transparent transition-colors\"></div>\n                            <svg class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 text-village-white drop-shadow-md opacity-0 group-hover:opacity-100 transition-opacity\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7\"></path></svg>\n                        </a>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n    </main>\n\n    <!-- LIGHTBOX GALERIE MENU POP-UP -->\n    <div id=\"menuLightbox\" class=\"fixed inset-0 z-[100] bg-village-dark/95 hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300 backdrop-blur-sm\">\n        \n        <div class=\"absolute top-0 left-0 right-0 p-4 md:p-6 flex justify-between items-center z-50\">\n            <span class=\"font-sans text-village-light uppercase tracking-widest text-xs font-medium tracking-[0.2em]\">Carte de Printemps</span>\n            <button id=\"closeLightbox\" class=\"text-village-light/70 hover:text-village-accent focus:outline-none transition-colors p-2\" title=\"Fermer\">\n                <svg class=\"w-8 h-8 md:w-10 md:h-10\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"></path></svg>\n            </button>\n        </div>\n\n        <button id=\"prevLightbox\" class=\"absolute left-2 md:left-8 top-1/2 -translate-y-1/2 text-village-light/70 hover:text-village-accent focus:outline-none z-50 transition-transform hover:-translate-x-1 p-2\" title=\"Précédent\">\n            <svg class=\"w-10 h-10 md:w-14 md:h-14\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15 19l-7-7 7-7\"></path></svg>\n        </button>\n\n        <div class=\"relative w-full max-w-5xl h-[85vh] flex items-center justify-center px-12 md:px-24\">\n            <div id=\"lbLoader\" class=\"absolute inset-0 flex items-center justify-center z-0 text-village-light/50\">\n                <svg class=\"animate-spin h-8 w-8\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path></svg>\n            </div>\n            <img id=\"lightboxImage\" src=\"\" alt=\"Menu Le Village\" class=\"relative z-10 max-w-full max-h-full object-contain transition-all duration-300 scale-95 opacity-0 shadow-2xl\">\n        </div>\n\n        <button id=\"nextLightbox\" class=\"absolute right-2 md:right-8 top-1/2 -translate-y-1/2 text-village-light/70 hover:text-village-accent focus:outline-none z-50 transition-transform hover:translate-x-1 p-2\" title=\"Suivant\">\n            <svg class=\"w-10 h-10 md:w-14 md:h-14\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M9 5l7 7-7 7\"></path></svg>\n        </button>\n        \n        <div class=\"absolute bottom-6 left-0 right-0 text-center z-50\">\n            <span id=\"lightboxCounter\" class=\"font-sans text-village-light/70 text-[10px] md:text-xs tracking-[0.3em] uppercase\">1 / 4</span>\n        </div>\n    </div>\n\n    <!-- SCRIPT DU POP-UP GALERIE -->\n    <script>\n        const menuImages = [\n            \"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_Avril_2026_pb7fkg.png\",\n            \"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_AVril_2026._ibghly.png\",\n            \"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_AVril_2026.._ub56nb.png\",\n            \"https://res.cloudinary.com/dbuwy6alc/image/upload/v1777394593/La_Carte_AVril_2026..._eikipm.png\"\n        ];\n        \n        let currentMenuIndex = 0;\n        const lightbox = document.getElementById('menuLightbox');\n        const lbImg = document.getElementById('lightboxImage');\n        const counter = document.getElementById('lightboxCounter');\n        const loader = document.getElementById('lbLoader');\n\n        function updateImage() {\n            lbImg.style.opacity = 0;\n            lbImg.classList.remove('scale-100');\n            lbImg.classList.add('scale-95');\n            loader.classList.remove('hidden');\n            \n            setTimeout(() => {\n                lbImg.src = menuImages[currentMenuIndex];\n                counter.innerText = (currentMenuIndex + 1) + \" / \" + menuImages.length;\n                \n                lbImg.onload = () => {\n                    loader.classList.add('hidden');\n                    lbImg.style.opacity = 1;\n                    lbImg.classList.remove('scale-95');\n                    lbImg.classList.add('scale-100');\n                };\n            }, 200);\n        }\n\n        function openLightbox(index) {\n            currentMenuIndex = index;\n            lightbox.classList.remove('hidden');\n            setTimeout(() => {\n                lightbox.classList.remove('opacity-0');\n            }, 10);\n            updateImage();\n            document.body.style.overflow = 'hidden';\n        }\n\n        function closeLightbox() {\n            lightbox.classList.add('opacity-0');\n            setTimeout(() => {\n                lightbox.classList.add('hidden');\n                document.body.style.overflow = 'auto';\n            }, 300);\n        }\n\n        function changeLightboxImage(direction) {\n            currentMenuIndex = (currentMenuIndex + direction + menuImages.length) % menuImages.length;\n            updateImage();\n        }\n\n        document.querySelectorAll('.menu-trigger').forEach((el) => {\n            el.addEventListener('click', (e) => {\n                e.preventDefault();\n                let idx = parseInt(el.getAttribute('data-index'));\n                openLightbox(idx);\n            });\n        });\n\n        document.getElementById('closeLightbox').addEventListener('click', closeLightbox);\n        document.getElementById('prevLightbox').addEventListener('click', (e) => { e.stopPropagation(); changeLightboxImage(-1); });\n        document.getElementById('nextLightbox').addEventListener('click', (e) => { e.stopPropagation(); changeLightboxImage(1); });\n        \n        lightbox.addEventListener('click', (e) => {\n            if(e.target === lightbox || e.target.parentElement === lightbox) closeLightbox();\n        });\n\n        document.addEventListener('keydown', (e) => {\n            if(!lightbox.classList.contains('hidden')) {\n                if(e.key === 'Escape') closeLightbox();\n                if(e.key === 'ArrowLeft') changeLightboxImage(-1);\n                if(e.key === 'ArrowRight') changeLightboxImage(1);\n            }\n        });\n    </script>\n\n</div>\n\n<!-- ===================================================================== -->\n<!-- FIN DE LA SECTION \"COMMUNIQUÉ 1ER MAI & CARTE\" -->\n<!-- ===================================================================== -->"
    }
  ],
  "footer": "<!-- ===================================================================== -->\n<!-- DÉBUT DU PIED DE PAGE (VERSION SCEAU D'EXCELLENCE CENTRÉ) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<link rel=\"preconnect\" href=\"https://static.tacdn.com\" crossorigin=\"\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                    'poppins': ['\"Poppins\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* Liens du menu principal */\n    .footer-nav-link {\n        position: relative;\n        display: inline-block;\n        padding-bottom: 2px;\n        transition: color 0.3s ease;\n    }\n    .footer-nav-link::after {\n        content: '';\n        position: absolute;\n        width: 0;\n        height: 1px;\n        bottom: 0;\n        left: 50%;\n        background-color: #9d623d;\n        transition: all 0.3s ease;\n        transform: translateX(-50%);\n    }\n    .footer-nav-link:hover {\n        color: #9d623d;\n    }\n    .footer-nav-link:hover::after {\n        width: 100%;\n    }\n\n    /* Liens d'action (Réservations) */\n    .footer-action-link {\n        display: inline-block;\n        border-bottom: 1px solid rgba(113, 53, 6, 0.3);\n        padding-bottom: 4px;\n        transition: all 0.3s ease;\n    }\n    .footer-action-link:hover {\n        color: #9d623d;\n        border-color: #9d623d;\n        transform: translateY(-2px);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .footer-nav-link,\n        .footer-nav-link::after,\n        .footer-action-link,\n        .tripadvisor-badge img {\n            transition: none !important;\n        }\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-centered-footer\" class=\"font-serif antialiased w-full\">\n\n    <footer class=\"bg-village-bg pt-24 pb-10 px-6 border-t border-village-accent/10\">\n        \n        <div class=\"max-w-4xl mx-auto flex flex-col items-center text-center\">\n\n            <!-- 1. LE SCEAU D'EXCELLENCE (TripAdvisor) -->\n            <div class=\"mb-10 flex flex-col items-center group tripadvisor-badge\">\n                <span class=\"font-sans text-[9px] uppercase tracking-[0.4em] text-village-dark/40 mb-5 border-b border-village-dark/10 pb-2\">\n                    Distinction d'Excellence\n                </span>\n                <a href=\"https://www.tripadvisor.fr/Restaurant_Review-g187220-d3346855-Reviews-Restaurant_Le_Village_Haut_De_Cagnes-Cagnes_sur_Mer_French_Riviera_Cote_d_Azur_Pr.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block\">\n                    <!-- Votre image transparente intégrée élégamment -->\n                    <img src=\"https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2025_LL.png\" alt=\"Tripadvisor Travelers’ Choice 2025 – Restaurant Le Village, Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\" class=\"h-12 md:h-14 w-auto object-contain opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500\">\n                </a>\n            </div>\n\n            <!-- 2. LA MARQUE -->\n            <div class=\"mb-12\">\n                <a href=\"https://legrimaldibylevillage.com/\" target=\"_top\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/')\">\n                    <h2 class=\"font-cursive text-5xl md:text-7xl text-village-dark hover:text-village-accent transition-colors duration-300\">\n                        Le Grimaldi\n                    </h2>\n                    <span class=\"font-sans text-xs tracking-[0.3em] uppercase text-village-dark/60 mt-2 block\">\n                        By Le Village\n                    </span>\n                </a>\n            </div>\n\n            <!-- 3. NAVIGATION HORIZONTALE -->\n            <nav class=\"flex flex-wrap justify-center gap-x-8 md:gap-x-12 gap-y-4 font-sans text-xs uppercase tracking-widest text-village-dark/80 mb-14\">\n                <a href=\"https://legrimaldibylevillage.com/le-village-restaurant-haut-de-cagnes-sur-mer\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/le-village-restaurant-haut-de-cagnes-sur-mer')\">Le Restaurant</a>\n                <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi')\">L'Hôtel</a>\n                <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/la-carte')\">La Carte</a>\n                <a href=\"https://legrimaldibylevillage.com/espace-presse\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/espace-presse')\">Espace Presse</a>\n            </nav>\n\n            <!-- 4. ADRESSE & CONTACT -->\n            <address class=\"not-italic font-serif text-lg md:text-xl text-village-dark/90 leading-relaxed mb-12\">\n                <p class=\"mb-2\">4 Place du Château, 06800 Cagnes-sur-Mer</p>\n                <div class=\"flex flex-col md:flex-row items-center justify-center gap-2 md:gap-6 font-sans text-sm tracking-wide\">\n                    <a href=\"tel:+33493200886\" class=\"hover:text-village-accent transition-colors\">+33 (0)4 93 20 08 86</a>\n                    <span class=\"hidden md:inline text-village-accent/30\">•</span>\n                    <a href=\"mailto:contact@legrimaldibylevillage.fr\" class=\"hover:text-village-accent transition-colors\">contact@legrimaldibylevillage.fr</a>\n                </div>\n            </address>\n\n            <!-- 5. ACTIONS DE RÉSERVATION -->\n            <div class=\"flex flex-col sm:flex-row justify-center gap-6 md:gap-12 mb-20 font-sans text-xs uppercase tracking-[0.15em] font-medium text-village-dark\">\n                <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_top\" onclick=\"return openFooterZenchef(event)\" class=\"footer-action-link\">\n                    Réserver une table\n                </a>\n                <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi')\" class=\"footer-action-link\">\n                    Réserver une chambre\n                </a>\n            </div>\n\n            <!-- 6. LIGNE FINALE (Copyright & Crédit Viraly) -->\n            <div class=\"w-full border-t border-village-dark/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-6\">\n                \n                <div class=\"font-serif text-xs text-village-dark/50 order-2 md:order-1\">\n                    © 2026 Le Grimaldi by Le Village\n                </div>\n\n                <div class=\"flex items-center gap-5 text-village-dark/60 order-1 md:order-2\">\n                    <a href=\"https://www.facebook.com/restaurantlevillagehdc\" target=\"_blank\" class=\"hover:text-village-accent transition-colors\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg></a>\n                    <a href=\"https://www.instagram.com/restaurantlevillagehdc\" target=\"_blank\" class=\"hover:text-village-accent transition-colors\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z\" clip-rule=\"evenodd\"></path>\n                    </svg></a>\n                </div>\n\n                <!-- Crédit Exact Viraly Agency -->\n                <p class=\"font-poppins text-[10px] leading-relaxed text-village-dark/60 uppercase tracking-[0.15em] text-center md:text-right order-3\">\n                    Site réalisé avec passion au Haut-de-Cagnes <br class=\"md:hidden\"> par \n                    <a href=\"https://www.viralyagency.fr/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-village-accent hover:text-village-dark transition-colors duration-300\">\n                        @Viraly Agency\n                    </a>\n                </p>\n\n            </div>\n\n        </div>\n\n    </footer>\n\n    <!-- 3. LOGIQUE JAVASCRIPT -->\n    <script>\n        function footerGoToTop(event, url) {\n            if (event) event.preventDefault();\n            try {\n                window.top.location.href = url;\n            } catch (e) {\n                window.location.href = url;\n            }\n            return false;\n        }\n\n        function openFooterZenchef(event) {\n            if (event) event.preventDefault();\n            let fallbackUrl = 'https://legrimaldibylevillage.com/?zc=open';\n            try {\n                const activeWindow = window.top && window.top !== window ? window.top : window;\n                const current = new URL(activeWindow.location.href);\n                current.searchParams.set('zc', 'open');\n                current.hash = '';\n                fallbackUrl = current.toString();\n            } catch (e) {}\n            try {\n                if (window.top && window.top !== window) {\n                    window.top.location.href = fallbackUrl;\n                } else {\n                    window.location.href = fallbackUrl;\n                }\n            } catch (e) {\n                window.location.href = fallbackUrl;\n            }\n            return false;\n        }\n    </script>\n\n</div>\n\n<!-- ===================================================================== -->\n<!-- FIN DU PIED DE PAGE -->\n<!-- ===================================================================== -->"
