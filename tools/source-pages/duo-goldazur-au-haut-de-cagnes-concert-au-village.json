\n    background-color: #ffffff;\n    border: 1px solid rgba(113,53,6,.2);\n}\n\n</style>\n\n\n\n<!-- ===================================================================== -->\n<!-- CONTENU                                                               -->\n<!-- ===================================================================== -->\n\n<div id=\"village-blog-duo-goldazur-block\" class=\"font-serif antialiased w-full\">\n\n\n\n    <!-- ================================================================= -->\n    <!-- HERO                                                              -->\n    <!-- ================================================================= -->\n\n    <header class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden bg-village-dark\">\n\n\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/whatsapp-image-2026-09-06-at-10.33.24-Gc4Lrs16v8JYs9B8.jpeg\" alt=\"Duo Gold'Azur en concert au Restaurant Le Village au Haut-de-Cagnes\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position:center 0%;\" decoding=\"async\" fetchpriority=\"high\">\n\n\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/70\"></div>\n\n\n\n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n\n\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 drop-shadow-md\">\n\n                Concert & Dîner au Haut-de-Cagnes\n\n            </span>\n\n\n\n            <!-- UNIQUE H1 -->\n\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-2xl mb-6 leading-tight\">\n\n                Le Tour du Monde\n                <br>\n                du Duo Gold'Azur\n\n            </h1>\n\n\n\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">\n\n                Mercredi 9 septembre 2026 à 19h\n\n                <br>\n\n                Restaurant Le Village · Place du Château\n\n            </p>\n\n\n        </div>\n\n\n    </header>\n\n\n\n\n\n    <!-- ================================================================= -->\n    <!-- CORPS DE L'ARTICLE                                                -->\n    <!-- ================================================================= -->\n\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n\n\n        <article class=\"max-w-4xl mx-auto px-6 bg-village-bg relative\">\n\n\n\n            <!-- ========================================================= -->\n            <!-- META                                                      -->\n            <!-- ========================================================= -->\n\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n\n\n                <span>\n                    Le Grimaldi by Le Village\n                </span>\n\n\n                <span>\n                    •\n                </span>\n\n\n                <time datetime=\"2026-09-09\">\n                    Septembre 2026\n                </time>\n\n\n            </div>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- INTRODUCTION                                              -->\n            <!-- ========================================================= -->\n\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n\n                La douceur de l'arrière-saison s'installe sur le\n                <strong>Haut-de-Cagnes</strong>,\n                et la musique continue de faire vibrer la terrasse du\n                <strong>Restaurant Le Village</strong>.\n\n                Ce <strong>mercredi 9 septembre 2026</strong>,\n                nous avons le plaisir d'accueillir le\n                <strong>Duo Gold'Azur</strong>\n                pour une soirée où la virtuosité classique rencontre\n                l'énergie du rock et du jazz.\n\n            </p>\n\n\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n\n                À partir de 19h, installez-vous aux premières loges\n                sur la <strong>Place du Château à Cagnes-sur-Mer</strong>\n                pour découvrir l'univers singulier de\n                <strong>Liza Kerob et Claude Baudot</strong>,\n                tout en profitant d'un dîner aux saveurs méditerranéennes.\n\n            </p>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- H2 : LE DUO                                               -->\n            <!-- ========================================================= -->\n\n            <section>\n\n\n                <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6 text-center mt-16\">\n\n                    Duo Gold'Azur : la rencontre de deux univers\n\n                </h2>\n\n\n\n                <div class=\"flex flex-col md:flex-row gap-10 md:gap-16 items-center my-12\">\n\n\n\n                    <!-- TEXTE -->\n\n                    <div class=\"w-full md:w-1/2 text-center md:text-left order-2 md:order-1\">\n\n\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n\n                            Le\n\n                            <a href=\"https://www.facebook.com/profile.php?id=61551453292839\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-semibold text-village-accent hover:text-village-dark transition-colors border-b border-village-accent/30 hover:border-village-dark\">\n\n                                Duo Gold'Azur\n\n                            </a>\n\n                            est né d'une alliance surprenante.\n\n                            D'un côté, le violon de\n                            <strong>Liza Kerob</strong>,\n                            supersoliste reconnue de\n                            l'Orchestre Philharmonique de Monte-Carlo.\n\n                        </p>\n\n\n\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n\n                            De l'autre, la guitare de\n                            <strong>Claude Baudot</strong>,\n                            musicien passionné et compositeur\n                            amoureux de toutes les esthétiques musicales.\n\n                        </p>\n\n\n\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans\">\n\n                            De cette complicité émane une musique\n                            à la fois exigeante et accessible,\n                            portée par la beauté d'un violon de 1754\n                            et la chaleur de la guitare acoustique.\n\n                        </p>\n\n\n                    </div>\n\n\n\n\n\n                    <!-- PHOTO DU DUO -->\n\n                    <div class=\"w-full md:w-1/2 flex justify-center order-1 md:order-2\">\n\n\n                        <figure class=\"relative bg-village-white p-3 border border-village-dark/10 shadow-xl rounded-sm w-full max-w-[350px] transform rotate-2 hover:rotate-0 transition-transform duration-500\">\n\n\n                            <div class=\"relative w-full rounded-sm overflow-hidden bg-village-light\">\n\n\n                                <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/whatsapp-image-2026-09-06-at-10.33.24-Gc4Lrs16v8JYs9B8.jpeg\" alt=\"Liza Kerob au violon et Claude Baudot à la guitare, Duo Gold'Azur\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-auto object-contain block\">\n\n\n                            </div>\n\n\n\n                            <figcaption class=\"text-center font-sans text-[10px] text-village-dark/50 mt-4 uppercase tracking-widest italic\">\n\n                                Liza Kerob & Claude Baudot\n\n                            </figcaption>\n\n\n                        </figure>\n\n\n                    </div>\n\n\n                </div>\n\n\n            </section>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- CITATION                                                  -->\n            <!-- ========================================================= -->\n\n            <blockquote class=\"my-12 text-center border-t border-b border-village-accent/30 py-8 px-4\">\n\n\n                <p class=\"font-cursive text-3xl md:text-4xl text-village-accent leading-relaxed\">\n\n                    De Johannes Brahms à Pink Floyd\n                    en passant par Dire Straits,\n                    un véritable voyage sans frontières.\n\n                </p>\n\n\n            </blockquote>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- H2 : RÉPERTOIRE                                           -->\n            <!-- ========================================================= -->\n\n            <section>\n\n\n                <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6 text-center mt-12\">\n\n                    Un répertoire qui bouscule les codes\n\n                </h2>\n\n\n\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n\n                    Ne vous fiez pas au classicisme de leurs instruments.\n                    Le Duo Gold'Azur s'amuse à reprendre les grands\n                    standards pour les adapter à sa formation.\n\n                    Le résultat : un voyage musical où la rigueur\n                    classique flirte avec l'esprit rock.\n\n                </p>\n\n\n\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-12\">\n\n                    Au programme de cette soirée :\n                    des envolées tziganes,\n                    des classiques de la chanson française,\n                    l'intensité de Scorpions ou Led Zeppelin,\n                    mais aussi des standards de jazz réinventés.\n\n                    Une expérience musicale intimiste\n                    qui s'accorde naturellement avec l'atmosphère\n                    du <strong>Haut-de-Cagnes</strong>.\n\n                </p>\n\n\n            </section>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- H2 : INFORMATIONS PRATIQUES                               -->\n            <!-- ========================================================= -->\n\n            <section class=\"info-card p-8 md:p-12 shadow-xl mb-16 relative\">\n\n\n                <div class=\"text-center\">\n\n\n                    <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-6\">\n\n                        Concert Duo Gold'Azur :\n                        informations pratiques\n\n                    </h2>\n\n\n\n                    <ul class=\"font-sans text-village-dark/80 space-y-4 mb-8 text-base md:text-lg list-none p-0\">\n\n\n                        <li>\n                            <strong>Artistes :</strong>\n                            Duo Gold'Azur\n                            (Liza Kerob & Claude Baudot)\n                        </li>\n\n\n                        <li>\n                            <strong>Date :</strong>\n                            mercredi 9 septembre 2026\n                        </li>\n\n\n                        <li>\n                            <strong>Heure :</strong>\n                            à partir de 19h\n                        </li>\n\n\n                        <li>\n                            <strong>Lieu :</strong>\n                            terrasse du Restaurant Le Village\n                        </li>\n\n\n                        <li>\n                            <strong>Adresse :</strong>\n                            4 Place du Château,\n                            06800 Cagnes-sur-Mer\n                        </li>\n\n\n                    </ul>\n\n\n\n\n\n                    <!-- ================================================= -->\n                    <!-- RÉSERVATION HOSTINGER                             -->\n                    <!-- ================================================= -->\n\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"inline-block w-full sm:w-auto bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-5 px-10 font-sans tracking-widest uppercase text-sm font-semibold shadow-md hover:shadow-xl\" aria-label=\"Réserver une table pour le concert du Duo Gold'Azur au Restaurant Le Village\" onclick=\"\n                            event.preventDefault();\n\n                            try {\n\n                                const w = window.top || window.parent;\n\n                                w.history.replaceState(\n                                    null,\n                                    '',\n                                    w.location.pathname + w.location.search\n                                );\n\n                                w.location.hash = '';\n\n                                w.location.hash = 'zc-action-open';\n\n                            }\n\n                            catch(e) {\n\n                                window.location.href = this.href;\n\n                            }\n                        \">\n\n                        Réserver une table\n\n                    </a>\n\n\n                </div>\n\n\n            </section>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- H2 : DÎNER                                                -->\n            <!-- ========================================================= -->\n\n            <section class=\"text-center mt-16 mb-8 border-t border-village-accent/20 pt-12\">\n\n\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">\n\n                    Un dîner en musique au Restaurant Le Village\n\n                </h2>\n\n\n\n                <p class=\"font-sans text-base md:text-lg leading-relaxed text-village-dark/80 mb-6\">\n\n                    Pour accompagner cette soirée,\n                    le Chef Patrice Rémy vous propose\n                    sa cuisine méditerranéenne et bistronomique.\n\n                    Du tartare de saumon frais\n                    au paleron de bœuf braisé,\n                    profitez du concert autour d'un dîner\n                    sur la Place du Château.\n\n                    Les places en terrasse étant prisées,\n                    nous vous recommandons de réserver.\n\n                </p>\n\n\n\n\n                <div class=\"nav-links-village nav-links-village--cta\">\n\n\n                    <div class=\"nav-col\">\n\n\n\n                        <!-- ================================================= -->\n                        <!-- CARTE : SORT DU BLOC HOSTINGER                    -->\n                        <!-- ================================================= -->\n\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_top\" class=\"village-link\" aria-label=\"Découvrir la carte du Restaurant Le Village à Cagnes-sur-Mer\" onclick=\"\n                                try {\n\n                                    window.top.location.href = this.href;\n\n                                    return false;\n\n                                }\n\n                                catch(e) {\n\n                                    return true;\n\n                                }\n                   