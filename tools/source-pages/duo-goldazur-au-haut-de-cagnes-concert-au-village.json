       </div>\n\n\n            </section>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- HÔTEL                                                     -->\n            <!-- ========================================================= -->\n\n            <aside class=\"bg-village-dark text-village-light p-8 md:p-12 shadow-xl mb-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-8 md:gap-12 rounded-sm border border-village-accent/20 mt-16\">\n\n\n\n                <!-- EFFET LUMINEUX -->\n\n                <div class=\"absolute -top-24 -right-24 w-64 h-64 bg-village-accent/20 rounded-full blur-3xl pointer-events-none\"></div>\n\n\n\n\n\n                <!-- PHOTO HÔTEL -->\n\n                <div class=\"w-full md:w-1/3 flex justify-center relative z-10\">\n\n\n                    <div class=\"w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden border-2 border-village-accent/30 shadow-2xl\">\n\n\n                        <img src=\"https://img.holidu.com/images/12689214-8a28-411b-b50e-160829238ec3/m.jpg\" alt=\"Chambre de charme de l'Hôtel Le Grimaldi au Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover hover:scale-110 transition-transform duration-700\">\n\n\n                    </div>\n\n\n                </div>\n\n\n\n\n\n                <!-- TEXTE HÔTEL -->\n\n                <div class=\"w-full md:w-2/3 relative z-10 text-center md:text-left\">\n\n\n                    <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mb-4\">\n\n                        Prolongez la soirée au Château\n\n                    </h2>\n\n\n\n                    <p class=\"font-sans text-base md:text-lg text-village-light/80 leading-relaxed mb-6\">\n\n                        Après une belle soirée musicale sous les étoiles,\n                        laissez la magie opérer jusqu'au matin\n                        en séjournant dans l'une des cinq chambres\n                        de l'<strong>Hôtel Le Grimaldi</strong>,\n                        au cœur du Haut-de-Cagnes.\n\n                    </p>\n\n\n\n\n\n                    <!-- ================================================= -->\n                    <!-- LIEN HÔTEL : SORT DU BLOC HTML HOSTINGER           -->\n                    <!-- ================================================= -->\n\n                    <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" class=\"inline-block border border-village-accent text-village-accent hover:bg-village-accent hover:text-village-white transition-colors duration-300 py-3 px-8 font-sans tracking-widest uppercase text-xs md:text-sm\" aria-label=\"Découvrir l'Hôtel Le Grimaldi au Haut-de-Cagnes\" onclick=\"\n                            try {\n\n                                window.top.location.href = this.href;\n\n                                return false;\n\n                            }\n\n                            catch(e) {\n\n                                return true;\n\n                            }\n                        \">\n\n                        Découvrir nos chambres\n\n                    </a>\n\n\n                </div>\n\n\n            </aside>\n\n\n\n\n\n            <!-- ========================================================= -->\n            <!-- PARTAGE SOCIAL                                            -->\n            <!-- ========================================================= -->\n\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-4\">\n\n\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">\n\n                    Partager :\n\n                </span>\n\n\n\n\n\n                <!-- FACEBOOK -->\n\n                <a href=\"#\" onclick=\"\n                        event.preventDefault();\n                        shareOnFacebook();\n      