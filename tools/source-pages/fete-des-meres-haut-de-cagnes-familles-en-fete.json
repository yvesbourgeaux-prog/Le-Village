  "footer": "<!-- ===================================================================== -->\n<!-- DÉBUT DU PIED DE PAGE (VERSION SCEAU D'EXCELLENCE CENTRÉ) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<link rel=\"preconnect\" href=\"https://static.tacdn.com\" crossorigin=\"\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                    'poppins': ['\"Poppins\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* Liens du menu principal */\n    .footer-nav-link {\n        position: relative;\n        display: inline-block;\n        padding-bottom: 2px;\n        transition: color 0.3s ease;\n    }\n    .footer-nav-link::after {\n        content: '';\n        position: absolute;\n        width: 0;\n        height: 1px;\n        bottom: 0;\n        left: 50%;\n        background-color: #9d623d;\n        transition: all 0.3s ease;\n        transform: translateX(-50%);\n    }\n    .footer-nav-link:hover {\n        color: #9d623d;\n    }\n    .footer-nav-link:hover::after {\n        width: 100%;\n    }\n\n    /* Liens d'action (Réservations) */\n    .footer-action-link {\n        display: inline-block;\n        border-bottom: 1px solid rgba(113, 53, 6, 0.3);\n        padding-bottom: 4px;\n        transition: all 0.3s ease;\n    }\n    .footer-action-link:hover {\n        color: #9d623d;\n        border-color: #9d623d;\n        transform: translateY(-2px);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .footer-nav-link,\n        .footer-nav-link::after,\n        .footer-action-link,\n        .tripadvisor-badge img {\n            transition: none !important;\n        }\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-centered-footer\" class=\"font-serif antialiased w-full\">\n\n    <footer class=\"bg-village-bg pt-24 pb-10 px-6 border-t border-village-accent/10\">\n        \n        <div class=\"max-w-4xl mx-auto flex flex-col items-center text-center\">\n\n            <!-- 1. LE SCEAU D'EXCELLENCE (TripAdvisor) -->\n            <div class=\"mb-10 flex flex-col items-center group tripadvisor-badge\">\n                <span class=\"font-sans text-[9px] uppercase tracking-[0.4em] text-village-dark/40 mb-5 border-b border-village-dark/10 pb-2\">\n                    Distinction d'Excellence\n                </span>\n                <a href=\"https://www.tripadvisor.fr/Restaurant_Review-g187220-d3346855-Reviews-Restaurant_Le_Village_Haut_De_Cagnes-Cagnes_sur_Mer_French_Riviera_Cote_d_Azur_Pr.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block\">\n                    <!-- Votre image transparente intégrée élégamment -->\n                    <img src=\"https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2025_LL.png\" alt=\"Tripadvisor Travelers’ Choice 2025 – Restaurant Le Village, Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\" class=\"h-12 md:h-14 w-auto object-contain opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500\">\n                </a>\n            </div>\n\n            <!-- 2. LA MARQUE -->\n            <div class=\"mb-12\">\n                <a href=\"https://legrimaldibylevillage.com/\" target=\"_top\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/')\">\n                    <h2 class=\"font-cursive text-5xl md:text-7xl text-village-dark hover:text-village-accent transition-colors duration-300\">\n                        Le Grimaldi\n                    </h2>\n                    <span class=\"font-sans text-xs tracking-[0.3em] uppercase text-village-dark/60 mt-2 block\">\n                        By Le Village\n                    </span>\n                </a>\n            </div>\n\n            <!-- 3. NAVIGATION HORIZONTALE -->\n            <nav class=\"flex flex-wrap justify-center gap-x-8 md:gap-x-12 gap-y-4 font-sans text-xs uppercase tracking-widest text-village-dark/80 mb-14\">\n                <a href=\"https://legrimaldibylevillage.com/le-village-restaurant-haut-de-cagnes-sur-mer\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/le-village-restaurant-haut-de-cagnes-sur-mer')\">Le Restaurant</a>\n                <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi')\">L'Hôtel</a>\n                <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/la-carte')\">La Carte</a>\n                <a href=\"https://legrimaldibylevillage.com/espace-presse\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage