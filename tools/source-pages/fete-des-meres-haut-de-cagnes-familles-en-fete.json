      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG FÊTE DES MÈRES\" (VERSION SEO) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #9d623d !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n\n    /* Style éditorial menu */\n    .menu-card {\n        background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(157, 98, 61, 0.1) 39px, rgba(157, 98, 61, 0.1) 40px);\n        background-color: #ffffff;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n    }\n    \n    /* Conteneur image signature */\n    .village-img-wrapper {\n        position: relative;\n        overflow: hidden;\n        border-radius: 2px;\n    }\n\n    /* --- CADRE VIDÉO FENÊTRE EN ARCHE ÉPURÉE --- */\n    .arched-video-frame {\n        position: relative;\n        background: #ffffff;\n        padding: 10px;\n        border-radius: 140px 140px 0 0;\n        border: 1px solid #713506;\n        box-shadow: 0 25px 50px -12px rgba(113, 53, 6, 0.15);\n        overflow: hidden;\n        transition: transform 0.5s ease, box-shadow 0.5s ease;\n        margin: 0 auto;\n    }\n    .arched-video-frame:hover {\n        transform: translateY(-8px);\n        box-shadow: 0 30px 60px -15px rgba(113, 53, 6, 0.25);\n    }\n    .arched-video-frame::before {\n        content: '';\n        position: absolute;\n        top: 8px; bottom: 8px; left: 8px; right: 8px;\n        border: 1px solid rgba(157, 98, 61, 0.6);\n        border-radius: 132px 132px 0 0;\n        pointer-events: none;\n        z-index: 30;\n    }\n    .video-mask {\n        position: relative;\n        width: 100%;\n        aspect-ratio: 9/16;\n        border-radius: 130px 130px 0 0;\n        overflow: hidden;\n        background-color: #f5f0ea;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n    }\n    .video-mask iframe {\n        width: 100%;\n        height: 100%;\n        border: none;\n        display: block;\n        z-index: 10;\n        position: relative;\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-fete-meres-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/place-de-gaulle-haut-de-cagnes-YQfrbt7x9UtvMi0u.png\" alt=\"Déjeuner en terrasse au Haut-de-Cagnes pour la Fête des Mères\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 50%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/50 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight max-w-4xl mx-auto\">\n                Fête des Mères & <br>Familles en Fête\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">Les grands dimanches du printemps à Cagnes-sur-Mer</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <article class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>Mai / Juin 2026</span>\n            </div>\n            \n            <!-- Introduction optimisée SEO -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Le printemps s'installe définitivement sur le Haut-de-Cagnes et avec lui, la promesse de dimanches ensoleillés où l'on prend le temps de vivre. Cette année, le calendrier nous offre deux très belles occasions de nous retrouver sur la célèbre Place du Château.\n            </p>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Que vous cherchiez un <strong>restaurant avec terrasse pour la Fête des Mères</strong> (le dimanche 31 mai) ou une belle idée de <strong>sortie gratuite en famille</strong> dans les Alpes-Maritimes avec la nouvelle manifestation \"Familles en Fête\" (le dimanche 7 juin), le village médiéval sera votre point de ralliement.\n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- NOUVEL ÉVÉNEMENT : FAMILLES EN FÊTE (Balise H2 pour le SEO) -->\n            <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mt-16 mb-8 text-center\">Familles en Fête : le nouveau rendez-vous du village</h2>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                Parce que les familles sont au cœur de la vie cagnoise, la Place du Château et les ruelles du village historique vont se transformer en un véritable terrain d’exploration. La Ville de Cagnes-sur-Mer lance un nouvel événement fédérateur, idéal pour une promenade dominicale.\n            </p>\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                Au programme de cette manifestation intergénérationnelle : des rencontres où culture, patrimoine, nature, science et divertissement se côtoieront tout au long de la journée. Et pour les plus gourmands, un ravissant petit marché de produits locaux, d'artisanat et de gâteaux animera la place, apportant cette délicieuse touche d'authenticité qui fait l'âme de la Riviera.\n            </p>\n\n            <!-- ENCART MENU RESTAURANT (Balise H3 pour le SEO) -->\n            <div class=\"menu-card p-8 md:p-10 shadow-lg mb-16 relative text-center mx-auto max-w-lg mt-12 border-t-4 border-t-village-accent\">\n                <h3 class=\"font-serif text-2xl text-village-dark mb-2\">Votre Menu Fête des Mères</h3>\n                <p class=\"font-sans text-xs uppercase tracking-[0.2em] text-village-dark/60 mb-6\">Le Déjeuner au Restaurant Le Village</p>\n                <div class=\"font-serif text-village-dark text-lg md:text-xl space-y-4\">\n                    <p class=\"flex flex-col md:flex-row justify-between items-center border-b border-village-dark/10 pb-4\">\n                        <span>Entrée + Plat <span class=\"italic text-sm text-village-dark/70 block md:inline\">ou</span> Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">24,50 €</span>\n                    </p>\n                    <p class=\"flex flex-col md:flex-row justify-between items-center pt-2\">\n                        <span>Entrée + Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">29,00 €</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- ITINÉRAIRE (Balise H2 pour le SEO) -->\n            <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mt-16 mb-8 text-center\">Idée de sortie : l'itinéraire d'un dimanche parfait en famille<br><span class=\"font-sans text-sm tracking-widest uppercase text-village-dark/60 not-italic block mt-4\">(Spécial 7 Juin 2026)</span></h2>\n            \n            <div class=\"space-y-10 mb-12\">\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">11h00 : Flânerie et Marché Local</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Arrivez sereinement par la navette gratuite N°44 et commencez votre journée par une promenade autour du marché des artisans et producteurs locaux installés sur la place. Une belle occasion de soutenir les créateurs de notre région et de s'imprégner de l'ambiance du village.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent animate-pulse\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2 font-semibold\">12h30 : Déjeuner bistronomique en terrasse</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans mb-3 font-medium\">\n                        Que ce soit pour gâter votre maman avec un peu de retard ou simplement pour profiter de ce dimanche animé, prenez place sur notre terrasse ensoleillée, au plus près des festivités.\n                    </p>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans font-medium\">\n                        Le Chef Patrice Rémy vous propose une cuisine d'auteur, 100% faite maison, mettant à l'honneur les produits de la Méditerranée. De nos salades fraîcheur à nos desserts gourmands (dont nos fameuses profiteroles XXL), tout est réuni pour un repas de famille parfait.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">14h30 : Terrain d'exploration ludique</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Après le déjeuner, laissez les enfants profiter des nombreuses animations gratuites déployées autour du Château-musée Grimaldi. Les parents peuvent ainsi prolonger la détente autour d'un café ou d'une douceur sur la place.\n                    </p>\n                </div>\n            </div>\n\n            <!-- REEL FACEBOOK DANS CADRE VOUTÉ -->\n            <div class=\"w-full flex justify-center my-14\">\n                <div class=\"flex flex-col items-center group w-full max-w-[320px]\">\n                    <div class=\"arched-video-frame w-full\">\n                        <div class=\"video-mask\">\n                            <iframe src=\"https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F2411795779325003%2F&show_text=false&width=267&t=0\" width=\"267\" height=\"476\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\" title=\"Vidéo de la terrasse du restaurant Le Village à Cagnes-sur-Mer\">\n                            </iframe>\n                        </div>\n                    </div>\n                    <p class=\"text-center font-sans text-xs text-village-dark/60 mt-6 italic\">Notre terrasse ensoleillée, le point de ralliement idéal.</p>\n                </div>\n            </div>\n\n            <!-- CONCLUSION & 2EME BLOC DE LIENS CTA -->\n            <div class=\"text-center mt-16 mb-8 border-t border-village-accent/20 pt-12\">\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Réservez votre table pour le déjeuner</h2>\n                <p class=\"font-sans text-base text-village-dark/80 mb-6\">\n                    Que ce soit pour le repas de la Fête des Mères (31 mai) ou pour l'événement Familles en Fête (7 juin), notre établissement sera particulièrement prisé. Nous vous recommandons d'anticiper votre venue.\n                </p>\n                \n                <div class=\"nav-links-village nav-links-village--cta\" aria-label=\"Accès rapides restaurant Le Village\">\n                    <div class=\"nav-col\">\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                            Découvrir la carte\n                        </a>\n                        <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-op