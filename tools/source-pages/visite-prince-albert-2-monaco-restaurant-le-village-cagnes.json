  "footer": "<!-- ===================================================================== -->\n<!-- DÉBUT DU PIED DE PAGE (VERSION SCEAU D'EXCELLENCE CENTRÉ) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<link rel=\"preconnect\" href=\"https://static.tacdn.com\" crossorigin=\"\">\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                    'poppins': ['\"Poppins\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* Liens du menu principal */\n    .footer-nav-link {\n        position: relative;\n        display: inline-block;\n        padding-bottom: 2px;\n        transition: color 0.3s ease;\n    }\n    .footer-nav-link::after {\n        content: '';\n        position: absolute;\n        width: 0;\n        height: 1px;\n        bottom: 0;\n        left: 50%;\n        background-color: #9d623d;\n        transition: all 0.3s ease;\n        transform: translateX(-50%);\n    }\n    .footer-nav-link:hover {\n        color: #9d623d;\n    }\n    .footer-nav-link:hover::after {\n        width: 100%;\n    }\n\n    /* Liens d'action (Réservations) */\n    .footer-action-link {\n        display: inline-block;\n        border-bottom: 1px solid rgba(113, 53, 6, 0.3);\n        padding-bottom: 4px;\n        transition: all 0.3s ease;\n    }\n    .footer-action-link:hover {\n        color: #9d623d;\n        border-color: #9d623d;\n        transform: translateY(-2px);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .footer-nav-link,\n        .footer-nav-link::after,\n        .footer-action-link,\n        .tripadvisor-badge img {\n            transition: none !important;\n        }\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-centered-footer\" class=\"font-serif antialiased w-full\">\n\n    <footer class=\"bg-village-bg pt-24 pb-10 px-6 border-t border-village-accent/10\">\n        \n        <div class=\"max-w-4xl mx-auto flex flex-col items-center text-center\">\n\n            <!-- 1. LE SCEAU D'EXCELLENCE (TripAdvisor) -->\n            <div class=\"mb-10 flex flex-col items-center group tripadvisor-badge\">\n                <span class=\"font-sans text-[9px] uppercase tracking-[0.4em] text-village-dark/40 mb-5 border-b border-village-dark/10 pb-2\">\n                    Distinction d'Excellence\n                </span>\n                <a href=\"https://www.tripadvisor.fr/Restaurant_Review-g187220-d3346855-Reviews-Restaurant_Le_Village_Haut_De_Cagnes-Cagnes_sur_Mer_French_Riviera_Cote_d_Azur_Pr.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block\">\n                    <!-- Votre image transparente intégrée élégamment -->\n                    <img src=\"https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2025_LL.png\" alt=\"Tripadvisor Travelers’ Choice 2025 – Restaurant Le Village, Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\" class=\"h-12 md:h-14 w-auto object-contain opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500\">\n                </a>\n            </div>\n\n            <!-- 2. LA MARQUE -->\n            <div class=\"mb-12\">\n                <a href=\"https://legrimaldibylevillage.com/\" target=\"_top\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/')\">\n                    <h2 class=\"font-cursive text-5xl md:text-7xl text-village-dark hover:text-village-accent transition-colors duration-300\">\n                        Le Grimaldi\n                    </h2>\n                    <span class=\"font-sans text-xs tracking-[0.3em] uppercase text-village-dark/60 mt-2 block\">\n                        By Le Village\n                    </span>\n                </a>\n            </div>\n\n            <!-- 3. NAVIGATION HORIZONTALE -->\n            <nav class=\"flex flex-wrap justify-center gap-x-8 md:gap-x-12 gap-y-4 font-sans text-xs uppercase tracking-widest text-village-dark/80 mb-14\">\n                <a href=\"https://legrimaldibylevillage.com/le-village-restaurant-haut-de-cagnes-sur-mer\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/le-village-restaurant-haut-de-cagnes-sur-mer')\">Le Restaurant</a>\n                <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi')\">L'Hôtel</a>\n                <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/la-carte')\">La Carte</a>\n                <a href=\"https://legrimaldibylevillage.com/espace-presse\" target=\"_top\" class=\"footer-nav-link\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/espace-presse')\">Espace Presse</a>\n            </nav>\n\n            <!-- 4. ADRESSE & CONTACT -->\n            <address class=\"not-italic font-serif text-lg md:text-xl text-village-dark/90 leading-relaxed mb-12\">\n                <p class=\"mb-2\">4 Place du Château, 06800 Cagnes-sur-Mer</p>\n                <div class=\"flex flex-col md:flex-row items-center justify-center gap-2 md:gap-6 font-sans text-sm tracking-wide\">\n                    <a href=\"tel:+33493200886\" class=\"hover:text-village-accent transition-colors\">+33 (0)4 93 20 08 86</a>\n                    <span class=\"hidden md:inline text-village-accent/30\">•</span>\n                    <a href=\"mailto:contact@legrimaldibylevillage.fr\" class=\"hover:text-village-accent transition-colors\">contact@legrimaldibylevillage.fr</a>\n                </div>\n            </address>\n\n            <!-- 5. ACTIONS DE RÉSERVATION -->\n            <div class=\"flex flex-col sm:flex-row justify-center gap-6 md:gap-12 mb-20 font-sans text-xs uppercase tracking-[0.15em] font-medium text-village-dark\">\n                <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_top\" onclick=\"return openFooterZenchef(event)\" class=\"footer-action-link\">\n                    Réserver une table\n                </a>\n                <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_top\" onclick=\"return footerGoToTop(event, 'https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi')\" class=\"footer-action-link\">\n                    Réserver une chambre\n                </a>\n            </div>\n\n            <!-- 6. LIGNE FINALE (Copyright & Crédit Viraly) -->\n            <div class=\"w-full border-t border-village-dark/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-6\">\n                \n                <div class=\"font-serif text-xs text-village-dark/50 order-2 md:order-1\">\n                    © 2026 Le Grimaldi by Le Village\n                </div>\n\n                <div class=\"flex items-center gap-5 text-village-dark/60 order-1 md:order-2\">\n                    <a href=\"https://www.facebook.com/restaurantlevillagehdc\" target=\"_blank\" class=\"hover:text-village-accent transition-colors\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg></a>\n                    <a href=\"https://www.instagram.com/restaurantlevillagehdc\" target=\"_blank\" class=\"hover:text-village-accent transition-colors\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.04