      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG PRINCE\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* Conteneur Facebook responsif */\n    .fb-embed-container {\n        display: flex;\n        justify-content: center;\n        margin: 3rem 0;\n        width: 100%;\n        overflow: hidden;\n    }\n\n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #9d623d !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-prince-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1024,h=683,fit=crop/gnKoPAn3rxzY53IR/640136904_18127511677554133_5954049839880848320_n-tcU4AMFCNN7oxGpO.jpg\" alt=\"Le Prince Albert II au Restaurant Le Village\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 15%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight max-w-5xl mx-auto\">\n                Un déjeuner princier au cœur <br>du Haut-de-Cagnes\n            </h1>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>25 Février 2026</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Nous avons eu l’immense honneur d’accueillir pour le déjeuner Son Altesse Sérénissime le Prince Albert <span class=\"font-serif tracking-tighter\">II</span> de Monaco, aux côtés de Monsieur le Maire Louis Nègre et de Monsieur Constant Roland, Premier Adjoint.\n            </p>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Un moment d’exception sous le signe de l’élégance… et surtout de la simplicité, comme on aime ici. Ce souvenir, nous avions envie de l’évoquer car il résonne avec l’âme du Haut-de-Cagnes : un village où le patrimoine, l’art et l’histoire se croisent naturellement.\n            </p>\n\n            <!-- Citation de style -->\n            <blockquote class=\"my-12 text-center border-t border-b border-village-accent/30 py-8 px-4\">\n                <p class=\"font-cursive text-3xl md:text-4xl text-village-accent leading-relaxed\">\n                    \"L'élégance de la simplicité, là où l'histoire de Monaco rencontre notre héritage médiéval.\"\n                </p>\n            </blockquote>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-6 text-center\">Pourquoi Monaco résonne au Haut-de-Cagnes</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-12\">\n                Accueillir le Souverain monégasque sur la place du Château résonne comme une évidence historique. L'histoire du Haut-de-Cagnes est en effet intimement liée à celle de Monaco. Dès le début du XIVe siècle, la seigneurie de Cagnes fut acquise par Rainier Ier Grimaldi, amiral de France. C'est cette même illustre famille qui fit bâtir l'imposant Château Grimaldi, qui surplombe aujourd'hui encore notre restaurant.\n            </p>\n\n            <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mt-12 mb-6 text-center\">Une visite dédiée à la sauvegarde du patrimoine cagnois</h4>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                La présence de la famille princière dans les ruelles du Haut-de-Cagnes n'était pas un hasard. Le Prince Albert <span class=\"font-serif tracking-tighter\">II</span> a effectué une visite privée pour admirer la restauration de la Chapelle Notre-Dame de Protection. Classé Monument Historique depuis 1939, ce joyau des XVe et XVIIe siècles a fait l'objet de travaux d'envergure depuis 2021. Son Altesse Sérénissime, très attachée à la préservation de l'histoire régionale, a d'ailleurs participé financièrement à la réhabilitation de cet édifice.\n            </p>\n\n            <!-- Images de la Chapelle intégrées au texte -->\n            <div class=\"my-10\">\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6\">\n                    <img src=\"https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=512,fit=crop/gnKoPAn3rxzY53IR/eglise_notre_dame_protection-oex8yYOJbgYhxNiI.webp\" alt=\"La Chapelle Notre-Dame de Protection restaurée\" class=\"w-full h-64 md:h-72 object-cover rounded-sm shadow-md border-[4px] md:border-[6px] border-village-white\">\n                    <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/chapelle_notre_dame_de_protection_037_15d255c453-wBuTqXA66L9NDRiS.jpg\" alt=\"Intérieur restauré et fresques de la Chapelle Notre-Dame de Protection au Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-64 md:h-72 object-cover rounded-sm shadow-md border-[4px] md:border-[6px] border-village-white\">\n                </div>\n                <p class=\"text-center font-sans text-xs text-village-dark/60 mt-4 italic\">La Chapelle Notre-Dame de Protection et ses décors fraîchement restaurés.</p>\n            </div>\n\n            <!-- INTÉGRATION FACEBOOK -->\n            <div class=\"fb-embed-container\">\n                <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Frestaurantlevillagehdc%2Fposts%2Fpfbid0QwvVv5yCidgYzyQ7yDAMFY88mbhVb9DsEa5ao5gGvj8b8CQcZBfptc2BvwMuwj85l&show_text=true&width=500\" width=\"500\" height=\"526\" style=\"border:none;overflow:hidden; box-shadow: 0 10px 30px -10px rgba(113, 53, 6, 0.15); border-radius: 4px;\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                </iframe>\n            </div>\n\n            <!-- BLOC DE LIENS CTA (Découvrir / Réserver) -->\n            <div class=\"nav-links-village nav-links-village--cta mt-16 mb-8 border-t border-village-accent/20 pt-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social (Réseaux demandés) -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n    <span class=\"font-sa