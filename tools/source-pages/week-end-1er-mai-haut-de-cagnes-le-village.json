      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG 1ER MAI\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<link rel=\"preconnect\" href=\"https://assets.zyrosite.com\" crossorigin=\"\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #000 !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n\n    /* Style éditorial menu */\n    .menu-card {\n        background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(157, 98, 61, 0.1) 39px, rgba(157, 98, 61, 0.1) 40px);\n        background-color: #ffffff;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n    }\n    \n    /* Conteneur vidéo responsif */\n    .video-embed-container {\n        display: flex;\n        justify-content: center;\n        margin: 3rem 0;\n        width: 100%;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .nav-links-village .village-link::after {\n            transition: none !important;\n        }\n    }\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BlogPosting\",\n  \"headline\": \"Le grand week-end du 1er Mai au Haut-de-Cagnes\",\n  \"description\": \"Programme du week-end du 1er mai 2026 au Haut-de-Cagnes : Fête des Mai, Art en Fête, DJ Set en terrasse et déjeuner au restaurant Le Village.\",\n  \"image\": \"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/490935715_18096532069554133_8717733356139315233_n-6ntZgcZZoxmJs8wl.jpg\",\n  \"mainEntityOfPage\": {\n    \"@type\": \"WebPage\",\n    \"@id\": \"https://legrimaldibylevillage.com/week-end-1er-mai-haut-de-cagnes-le-village\"\n  },\n  \"author\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Le Grimaldi by Le Village\"\n  },\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Le Grimaldi by Le Village\"\n  },\n  \"inLanguage\": \"fr-FR\",\n  \"keywords\": [\n    \"week-end 1er mai Haut-de-Cagnes\",\n    \"Fête des Mai Cagnes-sur-Mer\",\n    \"Art en Fête Haut-de-Cagnes\",\n    \"restaurant Le Village\",\n    \"DJ set terrasse Cagnes-sur-Mer\"\n  ]\n}\n</script>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-1er-mai-block\" class=\"font-serif antialiased w-full\" itemscope itemtype=\"https://schema.org/BlogPosting\">\n\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden bg-village-dark\">\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/490935715_18096532069554133_8717733356139315233_n-6ntZgcZZoxmJs8wl.jpg\" alt=\"Fête des Mai et week-end du 1er mai au Haut-de-Cagnes, près du restaurant Le Village\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 40%;\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n        \n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/50 to-village-dark/70\"></div>\n\n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 font-semibold\">Événements & Carnet de Bord</span>\n            <h1 itemprop=\"headline\" class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white mb-6 leading-tight drop-shadow-lg\">\n                Le grand week-end du 1er Mai au Haut-de-Cagnes\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow\">Fête des Mai, DJ Set en terrasse & Art en Fête</p>\n        </div>\n    </section>\n\n    <main class=\"w-full pb-24 relative z-20\">\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative pt-8\">\n            \n            <!-- Meta de l'article -->\n            <meta itemprop=\"image\" content=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/490935715_18096532069554133_8717733356139315233_n-6ntZgcZZoxmJs8wl.jpg\">\n            <meta itemprop=\"mainEntityOfPage\" content=\"https://legrimaldibylevillage.com/week-end-1er-mai-haut-de-cagnes-le-village\">\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span itemprop=\"author\">Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>Avril 2026</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Le 1er mai qui tombe un vendredi, c'est l'excuse parfaite que l'on attendait tous pour s'offrir un week-end prolongé. Et au Haut-de-Cagnes, ce week-end de trois jours s'annonce tout simplement exceptionnel.\n            </p>\n            \n            <p itemprop=\"description\" class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Entre la traditionnelle et très festive <strong>Fête des Mai au Haut-de-Cagnes</strong> qui lancera le week-end ce vendredi, et le dimanche culturel avec <strong>Art en Fête</strong>, la Place du Château va vibrer. Le restaurant Le Village, à Cagnes-sur-Mer, sera votre adresse pour profiter de l'ambiance printanière, d'une cuisine maison de saison et d'une programmation musicale en terrasse.\n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- VENDREDI 1ER MAI -->\n            <h2 class=\"font-cursive text-5xl md:text-6xl text-village-accent mt-16 mb-8 text-center border-b border-village-accent/20 pb-6\">Vendredi 1er Mai :<br><span class=\"font-sans text-xl md:text-2xl tracking-widest uppercase text-village-dark not-italic block mt-4\">La Fête des mai</span></h2>\n            \n            <div class=\"space-y-6 mb-12\">\n                <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                    Dès 10h30 le vendredi, le village passe en mode festif pour la grande <strong>Fête des mai</strong>. L'ambiance provençale reprend ses droits avec le célèbre défilé de vélos fleuris, la farandole sous les « mai », et les initiations aux fameuses boules carrées avec le Cercle des Amis.\n                </p>\n                <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                    Le marché provençal investira les lieux (socca, miel, tapenade, artisanat local) tandis que les enfants profiteront des jeux en bois et des ateliers créatifs.\n                </p>\n                \n                <!-- L'accroche du restaurant -->\n                <div class=\"bg-village-white p-8 border-l-4 border-village-accent shadow-sm mt-8 mb-8\">\n                    <h3 class=\"font-serif text-2xl text-village-dark mb-4\">L'événement au Restaurant Le Village</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans font-medium mb-4\">\n                        Au cœur de cette effervescence, notre terrasse devient votre point de ralliement. Prenez place face au château pour profiter de l'animation locale en toute sérénité.\n                    </p>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans font-medium\">\n                        C'est l'occasion rêvée pour découvrir notre nouvelle carte. Le Chef Patrice Rémy a imaginé de nouvelles créations printanières, toujours sincères et 100% fait maison, idéales à savourer au soleil dans cette ambiance résolument chill.\n                    </p>\n                </div>\n            </div>\n\n            <!-- ENCART MENU -->\n            <div class=\"menu-card p-8 md:p-10 shadow-lg mb-16 relative text-center mx-auto max-w-lg\">\n                <h5 class=\"font-sans text-sm tracking-[0.2em] uppercase text-village-accent mb-6\">Formules du Déjeuner <br><span class=\"text-xs lowercase text-village-dark/60\">(Valables tout le week-end)</span></h5>\n                <div class=\"font-serif text-village-dark text-lg md:text-xl space-y-4\">\n                    <p class=\"flex flex-col md:flex-row justify-between items-center border-b border-village-dark/10 pb-4\">\n                        <span>Entrée + Plat <span class=\"italic text-sm text-village-dark/70 block md:inline\">ou</span> Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">24,50 €</span>\n                    </p>\n                    <p class=\"flex flex-col md:flex-row justify-between items-center pt-2\">\n                        <span>Entrée + Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">29,00 €</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- DIMANCHE 3 MAI (ART EN FÊTE + DJ SET) -->\n            <h2 class=\"font-cursive text-5xl md:text-6xl text-village-accent mt-20 mb-8 text-center border-b border-village-accent/20 pb-6\">Dimanche 3 Mai :<br><span class=\"font-sans text-xl md:text-2xl tracking-widest uppercase text-village-dark not-italic block mt-4\">DJ Set en Terrasse & Art en Fête</span></h2>\n            \n            <div class=\"space-y-10 mb-12\">\n                <p class=\"text-base text-village-dark/80 leading-relaxed font-sans mb-6\">\n                    Après l'énergie du vendredi et la détente du samedi, le dimanche 3 mai (de 11h à 18h) fera place à la culture avec le rendez-vous incontournable <strong>Art en Fête</strong>. Les ruelles médiévales se transforment, les portes des ateliers d'artistes s'ouvrent, et l'entrée au château-musée Grimaldi est exceptionnellement gratuite pour tous.\n                </p>\n\n                <!-- Le DJ SET au Village (Mise en avant au sommet) -->\n                <div class=\"relative pl-6 md:pl-8 border-l-4 border-village-accent bg-village-white shadow-md p-6 md:p-8 rounded-sm\">\n                    <div class=\"absolute -left-[10px] top-8 w-4 h-4 rounded-full bg-village-accent animate-pulse\"></div>\n                    <h3 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4 font-semibold uppercase tracking-widest text-center md:text-left\">Le Midi : DJ Set en terrasse</h3>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans font-medium\">\n                        Pour sublimer cette journée d'exception, Le Village monte le son ! <strong>Dès 12h00, un DJ s'installera sur notre terrasse</strong> pour animer votre déjeuner en musique. Le lieu idéal pour savourer un verre de rosé et notre cuisine maison, tout en profitant de l'effervescence du Haut-de-Cagnes avant ou après vos visites culturelles.\n                    </p>\n                </div>\n\n                <!-- L'Atelier enfants -->\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30 mt-10\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">Activités en famille : L'atelier Aquarelle</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Le château-musée Grimaldi invite les familles à découvrir le peintre voyageur Alexis Gritchenko. La visite se prolonge par un superbe atelier de pratique artistique autour de la nature morte à l'aquarelle.<br>\n                        <span class=\"block mt-2 font-medium text-sm\">Horaires : 14h30 à 15h30 et 16h30 à 17h30. Dès 5 ans (accompagné d'un adulte). Sans inscription.</span>\n                    </p>\n                </div>\n\n                <!-- Le Concert -->\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h3 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">15h30 : Les Dimanches Musicaux</h3>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Laissez-vous porter par un moment d’exception dans la Grande salle du Château (2ème étage). La compagnie Ut Musica Poesis présente <em>\"L’invitation au voyage\"</em>, un concert tout en émotions entre voix et piano avec Florence De Lignerolles (piano), Xavier De Lignerolles (ténor) et Marie Cubaynes (mezzo-soprano).<br>\n                        <span class=\"block mt-2 font-medium text-sm\">Tarifs : 12€ / 9€ (réduit). Billetterie sur cagnes.fr.</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- FAQ / INFOS PRATIQUES -->\n            <div class=\"bg-village-white p-8 md:p-10 border border-village-accent/10 shadow-sm mt-16 mb-16\">\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-6 text-center\">Infos pratiques <br><span class=\"font-sans text-sm text-village-dark/60 tracking-widest uppercase mt-2 block\">(arriver zen au Haut-de-Cagnes)</span></h2>\n                <ul class=\"space-y-4 font-sans text-base text-village-dark/80 leading-relaxed\">\n                    <li><strong class=\"text-village-dark\">Stationnement conseillé :</strong> En centre-ville de Cagnes-sur-Mer pour éviter les embouteillages.</li>\n                    <li><strong class=\"text-village-dark\">Accès navette :</strong> La navette gratuite n°44 (départ Square Bourdet / station centrale) vous dépose directement sur la place.</li>\n                    <li><strong class=\"text-village-dark\">Sur place :</strong> Le parking payant Planastel reste accessible selon l'affluence.</li>\n                </ul>\n            </div>\n\n            <!-- 2EME BLOC DE LIENS CTA -->\n            <div class=\"text-center mt-16 mb-8 border-t border-village-accent/20 pt-12\">\n                <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Réservez votre table au soleil</h2>\n                <p class=\"font-sans text-base text-village-dark/80 mb-6\">\n                    Pour profiter de notre nouvelle carte de printemps ou du DJ Set de ce dimanche 3 mai, la terrasse sera très prisée. Nous vous conseillons de réserver rapidement.\n                </p>\n                \n                <div class=\"nav-links-village nav-links-village--cta\" aria-label=\"Accès rapides restaurant Le Village\">\n                    <div class=\"nav-col\">\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                            Découvrir la carte\n                        </a>\n                        <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                            Réserver en ligne\n                        </a>\n                        <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                            Réserver par téléphone\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n                \n                <!-- Facebook -->\n                <a href=\"\" onclick=\"shareOnFacebook()\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                        <path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path>\n                    </svg>\n                </a>\n                \n                <!-- WhatsApp -->\n                <a href=\"\" onclick=\"shareOnWhatsApp()\" aria-label=\"Partager sur WhatsApp\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                        <path d=\"M12.031 0C5.385 0