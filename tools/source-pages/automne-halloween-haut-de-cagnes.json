.searchParams.set('zc', 'open');\n                current.hash = '';\n                fallbackUrl = current.toString();\n            } catch (e) {}\n            try {\n                if (window.top && window.top !== window) {\n                    window.top.location.href = fallbackUrl;\n                } else {\n                    window.location.href = fallbackUrl;\n                }\n            } catch (e) {\n                window.location.href = fallbackUrl;\n            }\n            return false;\n        }\n    </script>\n\n</div>\n\n<!-- ===================================================================== -->\n<!-- FIN DU PIED DE PAGE -->\n<!-- ===================================================================== -->",
