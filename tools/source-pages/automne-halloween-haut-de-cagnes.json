      "content": "<!-- ===================================================================== -->\n<!-- ARTICLE BLOG AUTOMNE & HALLOWEEN - SEO + DESIGN ORIGINAL + HOSTINGER  -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');\n</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n\n<script>\ntailwind.config = {\n    theme: {\n        extend: {\n            colors: {\n                'village-dark': '#713506',\n                'village-light': '#f5f0ea',\n                'village-white': '#ffffff',\n                'village-bg': '#fcf9f3',\n                'village-accent': '#9d623d',\n            },\n            fontFamily: {\n                'serif': ['\"Playfair Display\"', 'serif'],\n                'cursive': ['\"Great Vibes\"', 'cursive'],\n                'sans': ['\"Lato\"', 'sans-serif'],\n            }\n        }\n    }\n}\n</script>\n\n<style>\nbody {\n    margin: 0;\n    padding: 0;\n    background-color: #fcf9f3;\n}\n\n/* ===================================================================== */\n/* LETTRINE                                                              */\n/* ===================================================================== */\n.drop-cap::first-letter {\n    font-family: 'Great Vibes', cursive;\n    font-size: 5.5rem;\n    float: left;\n    line-height: 0.85;\n    margin-right: 0.5rem;\n    color: #9d623d;\n}\n\n/* ===================================================================== */\n/* CTA / LIENS                                                           */\n/* ===================================================================== */\n.nav-links-village {\n    text-align: center !important;\n    margin-top: 20px !important;\n    margin-bottom: 20px !important;\n    font-family: 'Poppins', sans-serif !important;\n    font-size: 16px !important;\n    line-height: 1.4 !important;\n}\n\n.nav-links-village .nav-col {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    gap: 12px !important;\n}\n\n@media (min-width: 768px) {\n    .nav-links-village .nav-col {\n        flex-direction: row !important;\n        justify-content: center !important;\n        gap: 28px !important;\n    }\n}\n\n.nav-links-village .village-link {\n    color: #713506 !important;\n    text-decoration: none !important;\n    font-weight: 500 !important;\n    display: inline-block !important;\n    position: relative !important;\n    padding-bottom: 3px !important;\n    white-space: nowrap !important;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    font-size: 13px !important;\n}\n\n.nav-links-village .village-link::after {\n    content: \"\" !important;\n    position: absolute !important;\n    left: 0 !important;\n    bottom: 0 !important;\n    width: 0 !important;\n    height: 1px !important;\n    background: #9d623d !important;\n    transition: width .28s ease !important;\n}\n\n.nav-links-village .village-link:hover::after {\n    width: 100% !important;\n}\n\n/* ===================================================================== */\n/* ENCART INFORMATIONS                                                   */\n/* ===================================================================== */\n.info-card {\n    background-image:\n        repeating-linear-gradient(\n            0deg,\n            transparent,\n            transparent 39px,\n            rgba(157,98,61,.08) 39px,\n            rgba(157,98,61,.08) 40px\n        );\n    background-color: #ffffff;\n    border: 1px solid rgba(113,53,6,.2);\n}\n\n/* ===================================================================== */\n/* BOUTONS DE PARTAGE                                                    */\n/* ===================================================================== */\n.share-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    color: #9d623d;\n    background-color: transparent;\n    transition: all 0.25s ease;\n}\n.share-btn:hover {\n    color: #713506;\n    background-color: rgba(157, 98, 61, 0.1);\n    transform: translateY(-2px);\n}\n.share-btn svg {\n    width: 20px;\n    height: 20px;\n    display: block;\n}\n</style>\n\n<!-- ===================================================================== -->\n<!-- CONTENU                                                               -->\n<!-- ===================================================================== -->\n<div id=\"village-blog-automne-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- HERO -->\n    <header class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden bg-village-dark\">\n        <img\n            src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/unnamed-Z7vMbS6pur50Yf6Y.jpg\"\n            alt=\"Affiche décoration collective d'Automne au Haut-de-Cagnes\"\n            class=\"absolute inset-0 w-full h-full object-cover\"\n            style=\"object-position:center 30%;\"\n            decoding=\"async\"\n            fetchpriority=\"high\"\n        >\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/80\"></div>\n\n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 drop-shadow-md\">\n                Événement & Vie du Village\n            </span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-2xl mb-6 leading-tight\">\n                Magie d'Automne<br>& Halloween\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">\n                Tout le mois d'octobre 2026<br>Haut-de-Cagnes · Place du Château\n            </p>\n        </div>\n    </header>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <article class=\"max-w-4xl mx-auto px-6 bg-village-bg relative\">\n\n            <!-- META -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <time datetime=\"2026-10\">Octobre 2026</time>\n            </div>\n\n            <!-- INTRODUCTION -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                L'automne s'apprête à envelopper le <strong>Haut-de-Cagnes</strong> d'une douce lumière dorée. Cette saison, notre village historique va vivre une métamorphose unique grâce à un élan de solidarité et d'énergie citoyenne.\n            </p>\n\n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Sous l'impulsion du <strong>Restaurant Le Village</strong> et de l'hôtel Château Le Cagnard, en partenariat avec la Mairie de Cagnes-sur-Mer et l'Association des Haut-Cagnois, les habitants sont invités à transformer collectivement nos ruelles en un véritable décor d'automne.\n            </p>\n\n            <!-- H2 : L'ÉVÉNEMENT (AU FUTUR) -->\n            <section>\n                <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6 text-center mt-16\">\n                    500 citrouilles et un élan collectif\n                </h2>\n\n                <div class=\"flex flex-col md:flex-row gap-10 md:gap-16 items-center my-12\">\n                    <div class=\"w-full md:w-1/2 text-center md:text-left order-2 md:order-1\">\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                            Le coup d’envoi sera donné le <strong>samedi 10 octobre au matin</strong> sur la Place du Château. Les habitants inscrits viendront y récupérer le matériel nécessaire pour fleurir et décorer le pas de leur porte.\n                        </p>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                            Au programme : 500 citrouilles et lumignons offerts par Le Village et Le Cagnard, complétés par une centaine de bottes de paille et des compositions florales généreuses remises par la Mairie (chrysanthèmes boules, bruyères et graminées).\n                        </p>\n                        <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans\">\n                            Chaque lieu emblématique — de la fontaine à la Chapelle Notre-Dame de Protection en passant par les escaliers du Château — se parera de teintes chaudes tout au long du mois.\n                        </p>\n                    </div>\n\n                    <div class=\"w-full md:w-1/2 flex justify-center order-1 md:order-2\">\n                        <figure class=\"relative bg-village-white p-3 border border-village-dark/10 shadow-xl rounded-sm w-full max-w-[350px] transform rotate-2 hover:rotate-0 transition-transform duration-500\">\n                            <div class=\"relative w-full rounded-sm overflow-hidden bg-village-light aspect-[3/4]\">\n                                <img\n                                    src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/image3-pN3gMmzm8GXBQra6.png\"\n                                    alt=\"Fontaine décorée aux couleurs de l'automne\"\n                                    loading=\"lazy\"\n                                    decoding=\"async\"\n                                    class=\"w-full h-full object-cover block\"\n                                >\n                            </div>\n                            <figcaption class=\"text-center font-sans text-[10px] text-village-dark/50 mt-4 uppercase tracking-widest italic\">\n                                Fontaine du Haut-de-Cagnes\n                            </figcaption>\n                        </figure>\n                    </div>\n                </div>\n            </section>\n\n            <!-- CITATION -->\n            <blockquote class=\"my-12 text-center border-t border-b border-village-accent/30 py-8 px-4\">\n                <p class=\"font-cursive text-3xl md:text-4xl text-village-accent leading-relaxed\">\n                    Une aventure humaine et citoyenne pour faire de notre village un lieu chaleureux, fleuri et spectaculaire.\n                </p>\n            </blockquote>\n\n            <!-- H2 : HALLOWEEN -->\n            <section>\n                <h2 class=\"font-serif text-3xl md:text-4xl text-village-dark mb-6 text-center mt-12\">\n                    Le grand rendez-vous d'Halloween\n                </h2>\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                    Cette scénographie automnale est pensée pour évoluer jusqu'au point d'orgue de la saison. Le <strong>31 octobre</strong>, la magie basculera dans la féerie d'Halloween.\n                </p>\n                <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-12\">\n                    Toutes les citrouilles disposées à travers le village pourront être creusées et sculptées. À la tombée de la nuit, illuminées par leurs lumignons, elles transformeront le Haut-de-Cagnes en un décor mystérieux et festif pour petits et grands.\n                </p>\n            </section>\n\n            <!-- INFORMATIONS PRATIQUES -->\n            <section class=\"info-card p-8 md:p-12 shadow-xl mb-16 relative\">\n                <div class=\"text-center\">\n                    <h2 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-6\">\n                        Informations pratiques\n                    </h2>\n                    <ul class=\"font-sans text-village-dark/80 space-y-4 mb-8 text-base md:text-lg list-none p-0\">\n                        <li><strong>Événement :</strong> Décorations d'Automne & Soirée Halloween</li>\n                        <li><strong>Lancement :</strong> Distribution du matériel samedi 10 octobre au matin</li>\n                        <li><strong>Soirée lanternes :</strong> Samedi 31 octobre dès la tombée de la nuit</li>\n                        <li><strong>Lieu :</strong> Place du Château et ruelles du Haut-de-Cagnes</li>\n                    </ul>\n\n                    <div class=\"nav-links-village nav-links-village--cta\">\n                        <div class=\"nav-col\">\n                            <a href=\"mailto:association.deshautcagnois@gmail.com\" class=\"village-link\" aria-label=\"S'inscrire auprès de l'association\">\n                                S'inscrire (Habitants)\n                            </a>\n\n                            <a\n                                href=\"https://legrimaldibylevillage.com/?zc=open\"\n                                target=\"_parent\"\n                                rel=\"noopener\"\n                                class=\"inline-block w-full sm:w-auto bg-village-dark text-village-light hover:bg-village-accent transition-colors duration-300 py-4 px-8 font-sans tracking-widest uppercase text-xs font-semibold shadow-md hover:shadow-xl\"\n                                aria-label=\"Réserver une table au Restaurant Le Village\"\n                                onclick=\"\n                                    event.preventDefault();\n                                    try {\n                                        const w = window.top || window.parent;\n                                        w.history.replaceState(null, '', w.location.pathname + w.location.search);\n                                        w.location.hash = '';\n                                        w.location.hash = 'zc-action-open';\n                                    } catch(e) {\n                                        window.location.href = this.href;\n                                    }\n                                \"\n                            >\n                                Réserver une table\n                            </a>\n\n                                                       </a>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- HÔTEL -->\n            <aside class=\"bg-village-dark text-village-light p-8 md:p-12 shadow-xl mb-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-8 md:gap-12 rounded-sm border border-village-accent/20 mt-16\">\n                <div class=\"absolute -top-24 -right-24 w-64 h-64 bg-village-accent/20 rounded-full blur-3xl pointer-events-none\"></div>\n\n                <div class=\"w-full md:w-1/3 flex justify-center relative z-10\">\n                    <div class=\"w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden border-2 border-village-accent/30 shadow-2xl\">\n                        <img\n                            src=\"https://img.holidu.com/images/12689214-8a28-411b-b50e-160829238ec3/m.jpg\"\n                            alt=\"Chambre de charme de l'Hôtel Le Grimaldi au Haut-de-Cagnes\"\n                            loading=\"lazy\"\n                            decoding=\"async\"\n                            class=\"w-full h-full object-cover hover:scale-110 transition-transform duration-700\"\n                        >\n                    </div>\n                </div>\n\n                <div class=\"w-full md:w-2/3 relative z-10 text-center md:text-left\">\n                    <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mb-4\">\n                        Prolongez la magie de l'Automne\n                    </h2>\n                    <p class=\"font-sans text-base md:text-lg text-village-light/80 leading-relaxed mb-6\">\n                        Après une belle promenade dans les ruelles décorées, laissez le charme opérer jusqu'au matin en séjournant dans l'une des cinq chambres de l'<strong>Hôtel Le Grimaldi</strong>, au cœur du Haut-de-Cagnes.\n                    </p>\n                    <a\n                        href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\"\n                        target=\"_top\"\n                        class=\"inline-block border border-village-accent text-village-accent hover:bg-village-accent hover:text-village-white transition-colors duration-300 py-3 px-8 font-sans tracking-widest uppercase text-xs md:text-sm\"\n                        aria-label=\"Découvrir l'Hôtel Le Grimaldi au Haut-de-Cagnes\"\n                        onclick=\"\n                            try {\n                                window.top.location.href = this.href;\n                                return false;\n                            } catch(e) {\n                                return true;\n                            }\n                        \"\n                    >\n                        Découvrir nos chambres\n                    </a>\n                </div>\n            </aside>\n\n            <!-- PARTAGE SOCIAL -->\n            <div class=\"flex items-center justify-center space-x-3 border-t border-village-accent/20 pt-8 pb-12 mt-4\">\n                <span class=\"font-sans text-xs md:text-sm text-village-dark/70 uppercase tracking-widest mr-2\">\n                    Partager :\n                </span>\n\n                <!-- FACEBOOK -->\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"share-btn\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <path d=\"M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z\"/>\n                    </svg>\n                </a>\n\n                <!-- COPIER LE LIEN -->\n                <a href=\"#\" onclick=\"event.preventDefault(); copyPageLink();\" aria-label=\"Copier le lien\" class=\"share-btn\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/>\n                        <path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/>\n                    </svg>\n                </a>\n\n                <!-- WHATSAPP -->\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnWhatsApp();\" aria-label=\"Partager sur WhatsApp\" class=\"share-btn\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z\"/>\n                    </svg>\n                </a>\n            </div>\n\n        </article>\n    </main>\n\n</div>\n\n<!-- JAVASCRIPT PARTAGE -->\n<script>\nfunction getShareUrl() {\n    try {\n        return encodeURIComponent((window.top && window.top.location.href) ? window.top.location.href : window.location.href);\n    } catch(e) {\n        return encodeURIComponent(window.location.href);\n    }\n}\n\nfunction getShareText() {\n    try {\n        return encodeURIComponent(document.title + ' - ' + ((window.top && window.top.location.href) ? window.top.location.href : window.location.href));\n    } catch(e) {\n        return encodeURIComponent(document.title + ' - ' + window.location.href);\n    }\n}\n\nfunction shareOnFacebook() {\n    window.open('https://www.facebook.com/sharer/sharer.php?u=' + getShareUrl(), '_blank', 'width=640,height=580');\n}\n\nfunction shareOnWhatsApp() {\n    window.open('https://wa.me/?text=' + getShareText(), '_blank');\n}\n\nfunction copyPageLink() {\n    let url = '';\n    try {\n        url = (window.top && window.top.location.href) ? window.top.location.href : window.location.href;\n    } catch(e) {\n        url = window.location.href;\n    }\n    navigator.clipboard.writeText(url)\n        .then(() => { alert('Lien copié'); })\n        .catch(() => { prompt('Copiez ce lien :', url); });\n}\n</script>\n\n<!-- ===================================================================== -->\n<!-- FIN ARTICLE BLOG AUTOMNE & HALLOWEEN                                  -->\n<!-- ===================================================================== -->\n<style>/* Keep hotel invitations readable on their dark background. */\n.bg-village-dark h2, .bg-village-dark a { color: #f5f0ea; }\n</style>\n"
