      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG WEEK-END AOUT\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #9d623d !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n\n    /* Cadre d'image immersif */\n    .village-img-wrapper {\n        position: relative;\n        overflow: hidden;\n        border-radius: 2px;\n    }\n    \n    /* Image encadrée type Polaroïd */\n    .framed-image-container {\n        width: 100%;\n        max-width: 480px;\n        margin: 0 auto;\n        background: #ffffff;\n        padding: 10px;\n        border-radius: 4px;\n        box-shadow: 0 20px 40px -10px rgba(113, 53, 6, 0.15);\n        transition: transform 0.4s ease, box-shadow 0.4s ease;\n    }\n    .framed-image-container:hover {\n        transform: translateY(-5px);\n        box-shadow: 0 25px 50px -12px rgba(113, 53, 6, 0.20);\n    }\n    .framed-image-inner {\n        position: relative;\n        width: 100%;\n        overflow: hidden;\n        border-radius: 2px;\n    }\n    .village-framed-img {\n        width: 100%;\n        display: block;\n        transition: transform 0.8s ease;\n    }\n    .framed-image-container:hover .village-framed-img {\n        transform: scale(1.02);\n    }\n\n    /* Style éditorial menu */\n    .menu-card {\n        background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(157, 98, 61, 0.1) 39px, rgba(157, 98, 61, 0.1) 40px);\n        background-color: #ffffff;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-weekend-aout-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <!-- Utilisation de la nouvelle photo en hero -->\n        <img src=\"https://scontent-mrs2-3.xx.fbcdn.net/v/t39.99422-6/772904960_2138632987531199_6989717126188624118_n.png?stp=dst-jpg_tt6&cstp=mx2048x1365&ctp=s2048x1365&_nc_cat=102&ccb=1-7&_nc_sid=127cfc&_nc_ohc=Zd0j5cn0AAoQ7kNvwFL1NLs&_nc_oc=AdpanBP5i_esoT6_CNGR4vtm56rMN3m5X3JpfP9ZOJRuQgKootJk4zdsCVasvwog_F-YzazA7LNxn5xsLdJ3Q8WA&_nc_zt=14&_nc_ht=scontent-mrs2-3.xx&_nc_gid=HCLJo3sKWzT0rIAF1Eb_vw&_nc_ss=7b2a8&oh=00_AQF2aVmfxTfiaNUeA3Bh4etvpwxpWOpb72_QazNhzx1h7w&oe=6A8D58E9\" alt=\"Jazz au Château et Championnat du monde de boules carrées au Haut-de-Cagnes à Cagnes-sur-Mer\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 30%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/60 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 drop-shadow-md\">Événements & Carnet de Bord</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-2xl mb-6 leading-tight\">\n                Un week-end inédit<br>au Haut-de-Cagnes\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4 drop-shadow-md\">Jazz Manouche & Boules Carrées</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central -->\n        <article class=\"max-w-4xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>21, 22 et 23 Août 2026</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Les 21, 22 et 23 août 2026, le Haut-de-Cagnes vivra au rythme de deux rendez-vous emblématiques : Jazz au Château et le Championnat du monde de boules carrées.\n            </p>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-10\">\n                Entre la soirée Jazz au Château du vendredi soir et le Championnat du monde de boules carrées qui animera les ruelles tout le week-end, le village historique de Cagnes-sur-Mer s'annonce particulièrement animé. Installé sur la place du Château, le restaurant Le Village se trouve au cœur de ces festivités.\n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\">Découvrir la carte</a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">Réserver sa table</a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\">Réserver par téléphone</a>\n                </div>\n            </div>\n\n            <!-- VENDREDI : JAZZ MANOUCHE -->\n            <div class=\"relative bg-village-white p-8 md:p-12 shadow-sm border border-village-dark/5 my-16\">\n                <h2 class=\"font-cursive text-4xl md:text-6xl text-village-accent mb-4 text-center\">Vendredi 21 Août</h2>\n                <h3 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-8 text-center uppercase tracking-widest text-sm\">Soirée Blanche & Jazz Manouche</h3>\n                \n                <div class=\"max-w-2xl mx-auto\">\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Le week-end débutera vendredi soir avec une nouvelle soirée de <em>Jazz au Château</em>, en compagnie du trio <strong>The Jazz Bicravers</strong>. À partir de 21h, la place du Château accueillera une soirée dédiée au jazz manouche dans le cadre unique du Haut-de-Cagnes.\n                    </p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        Antoine Miekiszak et Bastien Zaouche aux guitares, accompagnés de Michaël Natale à la basse, proposeront un répertoire nourri par le jazz manouche, Django Reinhardt, La Nouvelle-Orléans et les musiques d’Europe de l’Est. Une programmation rythmée et chaleureuse, parfaitement adaptée à l'atmosphère estivale de la place du Château.\n                    </p>\n                    \n                    <div class=\"bg-village-bg/60 border-l-4 border-village-accent p-6 mt-8\">\n                        <p class=\"font-serif text-lg text-village-dark italic mb-2\">À savoir :</p>\n                        <p class=\"font-sans text-village-dark/80\">Pour l'occasion, une <strong>tenue blanche est souhaitée</strong>. Vous pourrez ainsi profiter de la soirée, dîner en terrasse au Village et prolonger la soirée au rythme du jazz.</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SAMEDI & DIMANCHE : BOULES CARRÉES -->\n            <div class=\"flex flex-col lg:flex-row gap-10 lg:gap-16 items-center my-20\">\n                <div class=\"w-full lg:w-3/5 order-2 lg:order-1\">\n                    <h2 class=\"font-cursive text-4xl md:text-5xl text-village-accent mb-4\">Samedi 22 et Dimanche 23 Août</h2>\n                    <h3 class=\"font-serif text-2xl text-village-dark mb-6\">Le 45e Championnat du Monde de Boules Carrées</h3>\n                    \n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        C'est l'un des rendez-vous les plus emblématiques du Haut-de-Cagnes. Depuis 1980, les boules carrées investissent chaque été les rues pentues du village et font partie des traditions les plus originales de Cagnes-sur-Mer.\n                    </p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-6\">\n                        L'origine de cette tradition est directement liée au relief du Vieux-Bourg. Dans certaines ruelles, notamment la montée de la Bourgade, les pentes atteignent jusqu'à 18 %, ce qui rend la pétanque classique particulièrement difficile. Le Cercle des Amis a donc imaginé des boules en bois à six faces, capables de rester sur les pentes. Même le cochonnet possède ici son propre nom : le <strong>titchon</strong>.\n                    </p>\n                    <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans font-medium\">\n                        Au fil des années, le Championnat du monde de boules carrées est devenu un véritable rendez-vous populaire, ouvert aux habitués comme aux curieux qui souhaitent découvrir cette spécialité cagnoise.\n                    </p>\n                </div>\n                \n                <!-- Affiche Boules Carrées -->\n                <div class=\"w-full lg:w-2/5 order-1 lg:order-2 flex justify-center\">\n                    <div class=\"framed-image-container\">\n                        <div class=\"framed-image-inner\">\n                            <img src=\"https://scontent-mrs2-2.xx.fbcdn.net/v/t39.99422-6/781979663_2466712613819834_5807660955380806455_n.png?stp=dst-jpg_tt6&cstp=mx563x1000&ctp=s563x1000&_nc_cat=101&ccb=1-7&_nc_sid=127cfc&_nc_ohc=T1JmZM1rriUQ7kNvwEINeEC&_nc_oc=Adp9l3mvKvLvkA7SEaBAcqF99dn2DZ9w6uCQ8KuKnodWl9LY4_PX1_8eDsSQ7QTomecaw4HjyEudCehKBwlvj-85&_nc_zt=14&_nc_ht=scontent-mrs2-2.xx&_nc_gid=UwFrKOpJMChKcr6I7EQWmg&_nc_ss=7b2a8&oh=00_AQGmN2AFVAqZGyFmOj1ano_8Sr0sSQRotFzlNflOhMSWDQ&oe=6A8D4EDC\" alt=\"Affiche du Championnat du monde de boules carrées 2026\" class=\"village-framed-img\">\n                        </div>\n                        <p class=\"text-center font-sans text-[10px] text-village-dark/50 mt-3 uppercase tracking-widest\">Édition 2026</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ENCART INFORMATIONS PRATIQUES BOULES CARRÉES -->\n            <div class=\"bg-village-dark/5 p-8 md:p-10 border border-village-dark/10 shadow-sm mt-8 mb-16\">\n                <h4 class=\"font-serif text-2xl text-village-dark mb-6 text-center\">Au programme du Championnat :</h4>\n                <ul class=\"font-sans text-village-dark/80 space-y-4 mb-8 text-sm md:text-base max-w-2xl mx-auto\">\n                    <li class=\"flex items-start\">\n                        <span class=\"text-village-accent mr-3\">•</span> \n                        <span><strong>Samedi 22 août (à partir de 8h30) :</strong> Inscriptions sur place (86, montée de la Bourgade) et début des éliminatoires (équipes de 3, inscription 25€).</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <span class=\"text-village-accent mr-3\">•</span> \n                        <span><strong>Dimanche 23 août (9h00) :</strong> Challenge Idéo (la consolante - inscription sur place 15€ par équipe de 3) et poursuite du tournoi principal.</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <span class=\"text-village-accent mr-3\">•</span> \n                        <span><strong>Dimanche 23 août (18h00) :</strong> La grande Finale suivie de la remise des prix.</span>\n                    </li>\n                </ul>\n                <p class=\"text-center font-sans text-sm font-semibold text-village-accent\">Même sans participer, le championnat mérite le détour : les parties disputées directement dans les ruelles et les pentes du Haut-de-Cagnes font partie du spectacle.</p>\n            </div>\n\n            <!-- ENCART MENU RESTAURANT -->\n            <div class=\"menu-card p-8 md:p-10 shadow-lg mb-16 relative text-center mx-auto max-w-lg\">\n                <h3 class=\"font-serif text-2xl text-village-dark mb-2\">Déjeuner au Village pendant le week-end</h3>\n                <p class=\"font-sans text-xs uppercase tracking-[0.2em] text-village-dark/60 mb-6\">Formules du midi au restaurant Le Village, Haut-de-Cagnes</p>\n                <div class=\"font-serif text-village-dark text-lg md:text-xl space-y-4\">\n                    <p class=\"flex flex-col md:flex-row justify-between items-center border-b border-village-dark/10 pb-4\">\n                        <span>Entrée + Plat <span class=\"italic text-sm text-village-dark/70 block md:inline\">ou</span> Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">24,50 €</span>\n                    </p>\n                    <p class=\"flex flex-col md:flex-row justify-between items-center pt-2\">\n                        <span>Entrée + Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">29,00 €</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- CONCLUSION & 2EME BLOC DE LIENS CTA -->\n            <div class=\"text-center mt-16 mb-8 border-t border-village-accent/20 pt-12\">\n                <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Au cœur des événements du Haut-de-Cagnes</h4>\n                <p class=\"font-sans text-base text-village-dark/80 mb-6\">\n                    Que vous veniez pour Jazz au Château le vendredi, pour participer au Championnat du monde de boules carrées ou simplement pour profiter de l'ambiance du Haut-de-Cagnes, le restaurant Le Village vous accueille tout au long du week-end sur la place du Château. Pensez à réserver votre table : le village sera particulièrement animé pendant ces trois jours.\n                </p>\n                \n                <div class=\"nav-links-village nav-links-village--cta\" aria-label=\"Accès rapides restaurant Le Village\">\n                    <div class=\"nav-col\">\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                            Découvrir la carte\n                        </a>\n                        <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                            Réserver sa table\n                        </a>\n                        <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village\">\n                            Réserver par téléphone\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ENCART HÔTEL : PROLONGEZ LE WEEK-END -->\n            <div class=\"bg-village-dark text-village-light p-8 md:p-12 shadow-xl mb-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-8 md:gap-12 rounded-sm border border-village-accent/20 mt-16\">\n                <!-- Effet lumineux subtil -->\n                <div class=\"absolute -top-24 -right-24 w-64 h-64 bg-village-accent/20 rounded-full blur-3xl pointer-events-none\"></div>\n                \n                <div class=\"w-full md:w-1/3 flex justify-center relative z-10\">\n                    <div class=\"w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden border-2 border-village-accent/30 shadow-2xl\">\n                        <img src=\"https://img.holidu.com/images/7fc89fff-1302-41ed-99da-c1cd50d52ee9/m.jpg\" alt=\"Chambre de l'Hôtel Le Grimaldi au Haut-de-Cagnes\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover hover:scale-110 transition-transform duration-700\">\n                    </div>\n                </div>\n                \n                <div class=\"w-full md:w-2/3 relative z-10 text-center md:text-left\">\n                    <h4 class=\"font-cursive text-4xl md:text-5xl text-village-accent mb-4\">Prolongez le week-end au Haut-de-Cagnes</h4>\n                    <p class=\"font-sans text-base md:text-lg text-village-light/80 leading-relaxed mb-6\">\n                        Pour profiter pleinement des festivités sans redescendre du village en fin de soirée, vous pouvez également séjourner dans l'une de nos cinq chambres. Une façon agréable de découvrir le Haut-de-Cagnes une fois les visiteurs partis, puis de retrouver dès le lendemain l'atmosphère de la place du Château.\n                    </p>\n                    <a href=\"https://legrimaldibylevillage.com/hotel-cagnes-sur-mer-le-grimaldi\" target=\"_blank\" class=\"inline-block border border-village-accent text-village-accent hover:bg-village-accent hover:text-village-white transition-colors duration-300 py-3 px-8 font-sans tracking-widest uppercase text-xs md:text-sm\">\n                        Découvrir nos chambres\n                    </a>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n            <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-4\">\n                <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n                <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n                    <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" clip-rule=\"evenodd\"></path></svg>\n                </a>\n                <a href=\"