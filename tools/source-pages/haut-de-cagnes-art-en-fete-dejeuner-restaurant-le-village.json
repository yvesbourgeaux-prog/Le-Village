      "type": "GridEmbed",
      "content": "<!-- ===================================================================== -->\n<!-- DÉBUT DE LA SECTION \"ARTICLE BLOG ART EN FÊTE\" (VERSION HOSTINGER) -->\n<!-- ===================================================================== -->\n\n<!-- 1. MOTEUR GRAPHIQUE -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<!-- Police Poppins pour le bloc de navigation CTA -->\n<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');</style>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'village-dark': '#713506',\n                    'village-light': '#f5f0ea',\n                    'village-white': '#ffffff',\n                    'village-bg': '#fcf9f3',\n                    'village-accent': '#9d623d',\n                },\n                fontFamily: {\n                    'serif': ['\"Playfair Display\"', 'serif'],\n                    'cursive': ['\"Great Vibes\"', 'cursive'],\n                    'sans': ['\"Lato\"', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    body { margin: 0; padding: 0; background-color: #fcf9f3; }\n\n    /* --- LETTRINE (Drop Cap) --- */\n    .drop-cap::first-letter {\n        font-family: 'Great Vibes', cursive;\n        font-size: 5.5rem;\n        float: left;\n        line-height: 0.85;\n        margin-right: 0.5rem;\n        color: #9d623d;\n    }\n    \n    /* --- STYLES OBLIGATOIRES POUR LE BLOC DE LIENS (CTA) --- */\n    .nav-links-village {\n        text-align: center !important;\n        margin-top: 20px !important;\n        margin-bottom: 20px !important;\n        font-family: 'Poppins', sans-serif !important;\n        font-size: 16px !important;\n        line-height: 1.4 !important;\n    }\n    .nav-links-village .nav-col {\n        display: flex !important;\n        flex-direction: column !important;\n        align-items: center !important;\n        gap: 12px !important;\n    }\n    @media (min-width: 768px) {\n        .nav-links-village .nav-col {\n            flex-direction: row !important;\n            justify-content: center !important;\n            gap: 28px !important; \n        }\n    }\n    .nav-links-village .village-link {\n        color: #713506 !important;\n        text-decoration: none !important;\n        font-weight: 500 !important;\n        display: inline-block !important;\n        position: relative !important;\n        padding-bottom: 3px !important;\n        white-space: nowrap !important;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 13px !important;\n    }\n    .nav-links-village .village-link::after {\n        content: \"\" !important;\n        position: absolute !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        width: 0 !important;\n        height: 1px !important;\n        background: #9d623d !important;\n        transition: width .28s ease !important;\n    }\n    .nav-links-village .village-link:hover::after {\n        width: 100% !important;\n    }\n\n    /* Style éditorial menu */\n    .menu-card {\n        background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(157, 98, 61, 0.1) 39px, rgba(157, 98, 61, 0.1) 40px);\n        background-color: #ffffff;\n        border: 1px solid rgba(113, 53, 6, 0.2);\n    }\n    \n    /* Conteneur Facebook responsif pour éviter le débordement sur petit mobile */\n    .fb-embed-container {\n        display: flex;\n        justify-content: center;\n        margin: 3rem 0;\n        width: 100%;\n        overflow: hidden;\n    }\n    .fb-embed-container iframe {\n        max-width: 100%;\n        border-radius: 4px;\n        box-shadow: 0 10px 30px -10px rgba(113, 53, 6, 0.15);\n    }\n</style>\n\n<!-- 2. CONTENU VISUEL -->\n<div id=\"village-blog-art-fete-block\" class=\"font-serif antialiased w-full\">\n\n    <!-- SECTION HERO (Couverture de l'article avec hauteurs fixes) -->\n    <section class=\"relative w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center overflow-hidden\">\n        <img src=\"https://assets.zyrosite.com/gnKoPAn3rxzY53IR/640938174_1260531962954474_68224900729298719_n-o26yI8piBx9wxHrU.jpg\" alt=\"Terrasse animée au Haut-de-Cagnes\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"object-position: center 40%;\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-village-bg via-village-dark/50 to-village-dark/70\"></div>\n        \n        <div class=\"relative z-10 text-center px-6 mt-16 md:mt-0 max-w-4xl mx-auto\">\n            <span class=\"font-sans text-village-light uppercase tracking-[0.3em] text-xs md:text-sm block mb-4\">Événements & Carnet de Bord</span>\n            <h1 class=\"font-cursive text-5xl md:text-7xl lg:text-8xl text-village-white drop-shadow-lg mb-6 leading-tight\">\n                Art en Fête & déjeuner <br>sur la Place du Château\n            </h1>\n            <p class=\"font-sans text-village-light uppercase tracking-widest text-sm font-semibold mt-4\">Que faire au Haut-de-Cagnes le 1er mars 2026 ?</p>\n        </div>\n    </section>\n\n    <!-- CORPS DE L'ARTICLE -->\n    <main class=\"w-full pb-24 -mt-8 relative z-20\">\n        <!-- Conteneur central étroit (Style Magazine) -->\n        <div class=\"max-w-3xl mx-auto px-6 bg-village-bg relative\">\n            \n            <!-- Meta de l'article -->\n            <div class=\"flex items-center justify-center space-x-4 font-sans text-xs md:text-sm text-village-accent uppercase tracking-widest mb-12 pt-10 border-b border-village-accent/20 pb-6\">\n                <span>Le Grimaldi by Le Village</span>\n                <span>•</span>\n                <span>23 Février 2026</span>\n            </div>\n            \n            <!-- Introduction -->\n            <p class=\"drop-cap text-lg md:text-xl text-village-dark/90 leading-relaxed mb-6\">\n                Le Haut-de-Cagnes, un dimanche de fête, ça se vit au ralenti : ruelles en pierre, ateliers ouverts, rires sur la Place du Château… et cette lumière qui change tout.\n            </p>\n            \n            <p class=\"text-base md:text-lg text-village-dark/80 leading-relaxed font-sans mb-8\">\n                Ce dimanche 1er mars 2026, “Art en Fête” anime le village historique de 11h à 18h. Le bon plan ? Ne pas vouloir tout faire. Juste suivre le rythme… et s’offrir la pause parfaite : un déjeuner sur la Place du Château, en plein cœur de l'animation. \n            </p>\n\n            <!-- 1ER BLOC DE LIENS CTA -->\n            <div class=\"nav-links-village nav-links-village--cta my-10\" aria-label=\"Accès rapides restaurant Le Village\">\n                <div class=\"nav-col\">\n                    <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                        Découvrir la carte\n                    </a>\n                    <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                        Réserver en ligne\n                    </a>\n                    <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                        Réserver par téléphone\n                    </a>\n                </div>\n            </div>\n\n            <!-- ENCART MENU -->\n            <div class=\"menu-card p-8 md:p-10 shadow-lg mb-16 relative text-center mx-auto max-w-lg mt-8\">\n                <h5 class=\"font-sans text-sm tracking-[0.2em] uppercase text-village-accent mb-6\">Le Midi <br><span class=\"text-xs lowercase text-village-dark/60\">(Semaine et week-end)</span></h5>\n                <div class=\"font-serif text-village-dark text-lg md:text-xl space-y-4\">\n                    <p class=\"flex flex-col md:flex-row justify-between items-center border-b border-village-dark/10 pb-4\">\n                        <span>Entrée + Plat <span class=\"italic text-sm text-village-dark/70 block md:inline\">ou</span> Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">24,50 €</span>\n                    </p>\n                    <p class=\"flex flex-col md:flex-row justify-between items-center pt-2\">\n                        <span>Entrée + Plat + Dessert</span>\n                        <span class=\"font-sans font-semibold mt-2 md:mt-0\">29,00 €</span>\n                    </p>\n                </div>\n            </div>\n\n            <!-- ITINÉRAIRE DÉTENTE -->\n            <h4 class=\"font-cursive text-4xl md:text-5xl text-village-accent mt-16 mb-10 text-center\">Le programme \"plaisir sans courir\"</h4>\n            \n            <div class=\"space-y-10 mb-12\">\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">11h00 — Commencer par la visite guidée</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        À 11h, la visite guidée démarre au pied du château. C’est l’entrée en matière idéale : tu comprends le lieu, tu captes l’esprit du village, et tu profites mieux de la suite.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">12h15 — Déjeuner en terrasse au Village</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans mb-3\">\n                        Après la visite, tu arrives naturellement sur la place. C’est le moment où tu fais ce que personne ne regrette : tu t’assois, tu respires, et tu laisses le Haut-de-Cagnes venir à toi.\n                    </p>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Le dimanche, la Place du Château vit vraiment — et depuis la terrasse, tu es au cœur de tout. Pour la pause idéale : Le Village propose chaque midi (y compris le week-end) une formule à 24,50 €.\n                    </p>\n                </div>\n            </div>\n\n            <!-- REEL FACEBOOK (Vidéo verticale) -->\n            <div class=\"flex justify-center my-14\">\n                <div class=\"rounded-sm overflow-hidden shadow-xl border border-village-dark/10 bg-white p-2\">\n                    <iframe src=\"https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F882991481313301%2F&show_text=false&width=267&t=0\" width=\"267\" height=\"476\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                    </iframe>\n                </div>\n            </div>\n\n            <div class=\"space-y-10 mb-12\">\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">14h00 — Flâner, rencontrer, profiter</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Après le déjeuner : pas besoin d’itinéraire compliqué. Juste une boucle douce entre 2–3 ateliers d'artistes, quelques vitrines, et l’ambiance si particulière des ruelles.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">15h30 — Finir sur une note “waouh”</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        À 15h30, tu peux choisir une fin de journée plus culturelle avec le spectacle musical au Château-musée. Sinon, tu restes dans l’esprit “dolce vita” : balade, photos, et retour sur la Place du Château.\n                    </p>\n                </div>\n            </div>\n\n            <!-- POST FACEBOOK LE VILLAGE -->\n            <div class=\"fb-embed-container\">\n                <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Frestaurantlevillagehdc%2Fposts%2Fpfbid0LWJCkTq4Np3XsqgZn5Nqx937dW61isenfgJVjA1H2tzFWoNLSSoDhcz2F3EyDgbAl&show_text=true&width=500\" width=\"500\" height=\"717\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                </iframe>\n            </div>\n\n            <!-- ITINÉRAIRE FAMILLE -->\n            <h4 class=\"font-cursive text-4xl md:text-5xl text-village-accent mt-16 mb-10 text-center\">Version famille (encore plus simple)</h4>\n            \n            <div class=\"space-y-10 mb-16\">\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">11h–18h — Les jeux Place du Château</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Les jeux en bois sont installés sur la Place du Château toute la journée. Les enfants s’amusent en sécurité, les parents soufflent.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">12h00 — Déjeuner au Village, sans logistique</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        Tu es déjà sur place. Pas de stress pour trouver à manger avec les enfants : tu t’installes, tu profites, et tu repars explorer le village quand tu veux.\n                    </p>\n                </div>\n\n                <div class=\"relative pl-6 md:pl-8 border-l-2 border-village-accent/30\">\n                    <div class=\"absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-village-accent\"></div>\n                    <h5 class=\"font-serif text-xl md:text-2xl text-village-dark mb-2\">14h30 — Atelier gouache</h5>\n                    <p class=\"text-base text-village-dark/80 leading-relaxed font-sans\">\n                        De 14h30 à 15h30, un atelier créatif est proposé dès 5 ans. La parenthèse parfaite.\n                    </p>\n                </div>\n            </div>\n\n            <!-- POST FACEBOOK VILLE DE CAGNES -->\n            <div class=\"fb-embed-container\">\n                <iframe src=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Fvilledecagnessurmer%2Fposts%2Fpfbid0rLx4497aFQcmmcGEQB5zcDCg1tz8SkwwCsdsoKSXepaZzQvzUN7pqNGffKuhztVil&show_text=true&width=500\" width=\"500\" height=\"692\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n                </iframe>\n            </div>\n\n            <!-- INFOS PRATIQUES -->\n            <div class=\"bg-village-white p-8 md:p-10 border border-village-accent/10 shadow-sm mt-16 mb-16\">\n                <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-6 text-center\">Infos pratiques <br><span class=\"font-sans text-sm text-village-dark/60 tracking-widest uppercase mt-2 block\">(arriver zen au Haut-de-Cagnes)</span></h4>\n                <ul class=\"space-y-4 font-sans text-base text-village-dark/80 leading-relaxed\">\n                    <li><strong class=\"text-village-dark\">Stationnement conseillé :</strong> En centre-ville de Cagnes-sur-Mer.</li>\n                    <li><strong class=\"text-village-dark\">Accès gratuit :</strong> Navette n°44 (depuis la station centrale de bus / avenue Renoir).</li>\n                    <li><strong class=\"text-village-dark\">Pour les courageux :</strong> Montée à pied par la Bourgade (≈ 10 minutes).</li>\n                    <li><strong class=\"text-village-dark\">Sur place :</strong> Parking payant Planastel au Haut-de-Cagnes.</li>\n                </ul>\n            </div>\n\n            <!-- FAQ -->\n            <h4 class=\"font-serif text-3xl text-village-dark mt-16 mb-8 text-center border-b border-village-dark/10 pb-4\">Foire Aux Questions</h4>\n            <div class=\"space-y-6 mb-16\">\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Que faire à Cagnes-sur-Mer le dimanche 1er mars 2026 ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Fais Art en Fête (11h–18h), commence par la visite guidée à 11h, puis profite des ateliers, jeux et du village.</p>\n                </div>\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">À quelle heure est la visite guidée ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">La visite guidée est à 11h (le rendez-vous est fixé au pied du château).</p>\n                </div>\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Où sont les animations enfants ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Les animations et jeux en bois se trouvent sur la Place du Château, en continu de 11h à 18h.</p>\n                </div>\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">À quelle heure est l’atelier gouache ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">L’atelier créatif à la gouache se déroule de 14h30 à 15h30.</p>\n                </div>\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">À quelle heure est le spectacle musical au Château-musée ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Le spectacle musical débute à 15h30 au sein du Château-musée.</p>\n                </div>\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Où déjeuner pendant Art en Fête ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Déjeune sur la Place du Château pour rester au cœur des animations du Haut-de-Cagnes. Le restaurant Le Village dispose d'une terrasse idéale (pensez à réserver). Formule midi dès 24,50 € (week-end inclus).</p>\n                </div>\n                <div>\n                    <h5 class=\"font-sans font-semibold text-village-dark text-base md:text-lg mb-1\">Où se garer pour venir au Haut-de-Cagnes (Art en Fête) ?</h5>\n                    <p class=\"font-sans text-village-dark/80 text-sm md:text-base\">Gare-toi en centre-ville de Cagnes-sur-Mer, puis emprunte la navette gratuite n°44 ou monte à pied par la montée de la Bourgade (environ 10 min).</p>\n                </div>\n            </div>\n\n            <!-- CONCLUSION & 2EME BLOC DE LIENS CTA -->\n            <div class=\"text-center mt-16 mb-8 border-t border-village-accent/20 pt-12\">\n                <h4 class=\"font-serif text-2xl md:text-3xl text-village-dark mb-4\">Réserver sa table au Village</h4>\n                <p class=\"font-sans text-base text-village-dark/80 mb-6\">\n                    Si tu veux vivre ce dimanche comme il faut : réserve et profite de la Place du Château au meilleur moment.\n                </p>\n                \n                <div class=\"nav-links-village nav-links-village--cta\" aria-label=\"Accès rapides restaurant Le Village\">\n                    <div class=\"nav-col\">\n                        <a href=\"https://legrimaldibylevillage.com/la-carte\" target=\"_blank\" class=\"village-link\" title=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Découvrir la carte du restaurant Le Village à Cagnes-sur-Mer\">\n                            Découvrir la carte\n                        </a>\n                        <a href=\"https://legrimaldibylevillage.com/?zc=open\" target=\"_parent\" class=\"village-link\" title=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" aria-label=\"Réserver en ligne au restaurant Le Village à Cagnes-sur-Mer (Haut-de-Cagnes)\" rel=\"noopener\" onclick=\"event.preventDefault(); try{ const w=window.top||window.parent; w.history.replaceState(null,'',w.location.pathname+w.location.search); w.location.hash=''; w.location.hash='zc-action-open'; }catch(e){ window.location.href=this.href; }\">\n                            Réserver en ligne\n                        </a>\n                        <a href=\"tel:+33493200886\" class=\"village-link\" title=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\" aria-label=\"Réserver par téléphone au restaurant Le Village à Cagnes-sur-Mer\">\n                            Réserver par téléphone\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Partage Social -->\n           <div class=\"flex items-center justify-center space-x-6 border-t border-village-accent/20 pt-8 pb-12 mt-12\">\n    <span class=\"font-sans text-sm text-village-dark/60 uppercase tracking-widest\">Partager :</span>\n    \n    <!-- Facebook -->\n    <a href=\"#\" onclick=\"event.preventDefault(); shareOnFacebook();\" aria-label=\"Partager sur Facebook\" class=\"text-village-dark/60 hover:text-village-accent transition-colors\">\n        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill-rule=\"evenodd\" d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.2